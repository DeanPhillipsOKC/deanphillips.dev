---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const all = await getCollection('blog', (p) => !p.data.draft);
// Series parts (part 1+) list under their overview's card instead of as their own cards.
const posts = all
  .filter((p) => !p.data.part)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const partsOf = (series?: string) => series
  ? all.filter((p) => p.data.series === series && p.data.part).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Writing | Dean Phillips"
  description="Notes from building real software with AI agents: workflows, automation, and what broke along the way."
  current="writing"
>
  <div class="prose">
    <div class="head">
      <p class="eyebrow">Writing</p>
      <h1>Building with <span class="grad-text">AI</span></h1>
      <p>Notes from shipping real software with AI agents: the workflows, the automation, and what broke along the way. <a href="/rss.xml">RSS feed</a>.</p>
    </div>
    <div class="entry">
      <a class="post has-cover" href="/owasp-llm-top-10/">
        <img class="thumb" src="/img/owasp-guide-thumb.jpg" alt="" width="472" height="354" loading="lazy" />
        <div>
          <time>Interactive guide &middot; 10 cards</time>
          <h2>Ten ways to break an AI app, and how to stop each one</h2>
          <p>The OWASP Top 10 for LLM apps in ten short cards. Watch each attack, then pick the fixes that stop it.</p>
        </div>
      </a>
    </div>
    {posts.map((p) => {
      const parts = partsOf(p.data.series);
      return (
        <div class:list={['entry', parts.length && 'has-parts']}>
          <a class:list={['post', p.data.cover && 'has-cover']} href={`/blog/${p.id}/`}>
            {p.data.cover && <Image class="thumb" src={p.data.cover} alt="" widths={[400, 800]} sizes="(max-width: 640px) calc(100vw - 40px), 260px" />}
            <div>
              <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}{parts.length > 0 && <> &middot; Overview + {parts.length} parts</>}</time>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
            </div>
          </a>
          {parts.length > 0 && (
            <ol class="parts">
              {parts.map((s) => (
                <li><a href={`/blog/${s.id}/`}><b>Part {s.data.part}</b><span>{s.data.partTitle ?? s.data.tabTitle ?? s.data.title}</span><small>{s.data.readMinutes} min</small></a></li>
              ))}
            </ol>
          )}
        </div>
      );
    })}
  </div>
</Base>

<style>
  .prose { max-width: 760px; margin: 0 auto; padding: 0 20px; }
  .head { position: relative; z-index: 1; padding: 64px 0 24px; }
  .head .eyebrow { margin-bottom: 12px; }
  .head h1 { font-size: clamp(2.2rem, 5vw, 3rem); margin: 0 0 12px; }
  .head p { color: var(--muted); font-size: 1.1rem; margin: 0; }
  .post { display: block; position: relative; z-index: 1; text-decoration: none; color: inherit; background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 26px; margin-bottom: 16px; transition: border-color .2s, transform .2s; }
  .post.has-cover { display: grid; grid-template-columns: 1fr 240px; gap: 24px; align-items: center; }
  .post.has-cover .thumb { order: 2; }
  .thumb { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 100% 50%; border-radius: 14px; border: 1px solid var(--line); }
  .post:hover { border-color: var(--teal); transform: translateY(-2px); }
  .post time { font-size: 0.85rem; color: var(--muted); }
  .post h2 { font-size: 1.45rem; margin: 6px 0 8px; line-height: 1.2; }
  .post p { color: var(--muted); margin: 0; }
  .entry { margin-bottom: 16px; position: relative; z-index: 1; }
  .entry .post { margin-bottom: 0; }
  .has-parts .post { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .parts { list-style: none; margin: 0; padding: 6px; background: var(--bg-2); border: 1px solid var(--line); border-top: none; border-radius: 0 0 20px 20px; }
  .parts a { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: baseline; padding: 10px 14px; border-radius: 12px; text-decoration: none; color: var(--text); }
  .parts a:hover { background: var(--card); }
  .parts b { font-size: 0.78rem; color: var(--teal); font-weight: 600; white-space: nowrap; }
  .parts small { color: var(--muted); font-size: 0.8rem; white-space: nowrap; }
  @media (max-width: 640px) {
    .post.has-cover { grid-template-columns: 1fr; gap: 16px; }
    .post.has-cover .thumb { order: 0; }
  }
  @media (max-width: 560px) { .head { padding-top: 40px; } .post { padding: 20px; } }
  @media (prefers-reduced-motion: reduce) { .post { transition: none; } }
</style>
