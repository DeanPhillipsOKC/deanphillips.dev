---
// One tool round trip as a comic strip with four actors: you, the app, the model, and a tool. Each
// panel puts two actors side by side. Speech bubbles are messages passed between them, and thought
// bubbles are what an actor is holding in mind. The app's thought bubble is the conversation it keeps.
// The model's shows only what it was just handed, because it keeps nothing between runs. Panels the
// reader never sees in the chat are marked "behind the scenes". Still pictures, read top to bottom. The
// panels fade in once on scroll unless the reader prefers less motion, and everything shows without JS.
type Who = 'you' | 'app' | 'model' | 'tool';
interface Line { tag?: string; text: string; code?: boolean; fresh?: boolean }
interface Msg { from: 'a' | 'b'; lines: Line[] }
interface Panel { a: Who; b: Who; caption: string; hidden?: boolean; msgs: Msg[]; think?: { who: 'a' | 'b'; lines: Line[] } }
interface Props { panels: Panel[]; others?: { label: string; note: string }[]; caption?: string }
const { panels, others = [], caption } = Astro.props;
const NAME: Record<Who, string> = { you: 'You', app: 'The app', model: 'The model', tool: 'The tool' };
const ICON: Record<Who, string> = {
  you: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  app: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01M9 6.5h.01"/>',
  model: '<circle cx="12" cy="12" r="8"/><path d="M12 12l4-5"/><path d="M12 2v2M22 12h-2M2 12h2"/>',
  tool: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l6 6"/>',
};
const actor = (w: Who) => `<span class="ct-av ct-${w}"><svg viewBox="0 0 24 24" aria-hidden="true">${ICON[w]}</svg></span><span class="ct-name">${NAME[w]}</span>`;
---
<figure class="ct panel bleed">
  <ol class="ct-panels">
    {panels.map((p, i) => (
      <li class={`ct-panel${p.hidden ? ' ct-hid' : ''}`} style={`--i:${i}`}>
        <p class="ct-cap"><span class="ct-n">{i + 1}</span>{p.caption}</p>
        <div class="ct-stage">
          <div class="ct-actor ct-left" set:html={actor(p.a)} />
          <div class="ct-actor ct-right" set:html={actor(p.b)} />
          <div class="ct-mid">
            {p.think && (
              <div class={`ct-think ct-think-${p.think.who}`}>
                <p class="ct-who">{NAME[p.think.who === 'a' ? p.a : p.b]} is holding</p>
                {p.think.lines.map((l) => <p class={`ct-line${l.fresh ? ' ct-fresh' : ''}`}>{l.tag && <span class="ct-tag">{l.tag}</span>}{l.code ? <code>{l.text}</code> : l.text}</p>)}
              </div>
            )}
            {p.msgs.map((m) => {
              const from = m.from === 'a' ? p.a : p.b, to = m.from === 'a' ? p.b : p.a;
              return (
                <div class={`ct-say ct-say-${m.from} ct-c-${from}`}>
                  <p class="ct-who">{NAME[from]} to {NAME[to].toLowerCase()}</p>
                  {m.lines.map((l) => <p class={`ct-line${l.fresh ? ' ct-fresh' : ''}`}>{l.tag && <span class="ct-tag">{l.tag}</span>}{l.code ? <code>{l.text}</code> : l.text}</p>)}
                </div>
              );
            })}
          </div>
        </div>
        {p.hidden && <p class="ct-unseen">Behind the scenes. You never see this part.</p>}
      </li>
    ))}
  </ol>
  {others.length > 0 && (
    <div class="ct-others">
      <p class="ct-oh">Every tool makes the same trip. Only the note changes.</p>
      <ul>{others.map((o) => <li><b>{o.label}</b><code>{o.note}</code></li>)}</ul>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.ct')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    const items = [...root.querySelectorAll<HTMLElement>('.ct-panel')];
    items.forEach((el) => el.classList.add('ct-wait'));
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.remove('ct-wait'); io.unobserve(e.target); }
    }, { threshold: 0.2 });
    items.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  .ct p { margin: 0; }
  .ct-panels { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ct-panel { padding: 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); display: grid; gap: 12px; transition: opacity .5s ease, transform .5s ease; }
  .ct-panel.ct-wait { opacity: 0; transform: translateY(12px); }
  .ct-hid { border-style: dashed; }
  .ct-cap { font: 700 1.05rem/1.35 "Space Grotesk", sans-serif; display: flex; gap: 10px; align-items: baseline; }
  .ct-n { flex: none; width: 28px; height: 28px; border-radius: 50%; display: inline-grid; place-items: center; font-size: 0.9rem; background: var(--card); border: 1px solid var(--line); transform: translateY(-1px); }
  .ct-stage { display: grid; grid-template-columns: 64px 1fr 64px; gap: 10px; align-items: start; }
  .ct-actor { display: grid; justify-items: center; gap: 4px; grid-row: 1; text-align: center; }
  .ct-left { grid-column: 1; }
  .ct-right { grid-column: 3; }
  .ct-mid { grid-column: 2; grid-row: 1; display: grid; gap: 12px; min-width: 0; }
  .ct-av { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--c) 20%, var(--card)); border: 2px solid var(--c); }
  .ct-av svg { width: 26px; height: 26px; fill: none; stroke: var(--c); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ct-name { font: 700 0.78rem/1.2 Inter, sans-serif; }
  .ct-you, .ct-c-you { --c: var(--teal); }
  .ct-app, .ct-c-app { --c: var(--warn); }
  .ct-model, .ct-c-model { --c: var(--violet); }
  .ct-tool, .ct-c-tool { --c: #4b93f0; }
  /* Speech bubbles, with a tail pointing at whoever is talking. */
  .ct-say { position: relative; display: grid; gap: 6px; padding: 10px 12px; border-radius: 14px; background: color-mix(in srgb, var(--c) 13%, var(--card)); border: 1.5px solid color-mix(in srgb, var(--c) 60%, transparent); }
  .ct-say::before { content: ''; position: absolute; top: 14px; width: 12px; height: 12px; background: inherit; border: inherit; transform: rotate(45deg); }
  .ct-say-a::before { left: -7px; border-top-color: transparent; border-right-color: transparent; }
  .ct-say-b::before { right: -7px; border-bottom-color: transparent; border-left-color: transparent; }
  .ct-say-b { margin-left: 18px; }
  .ct-say-a { margin-right: 18px; }
  /* Thought bubbles: a dashed cloud with two small circles trailing to the thinker. */
  .ct-think { position: relative; display: grid; gap: 4px; padding: 10px 14px; border-radius: 22px; border: 1.5px dashed var(--muted); background: var(--card); margin-bottom: 6px; }
  .ct-think::before, .ct-think::after { content: ''; position: absolute; border: 1.5px dashed var(--muted); border-radius: 50%; background: var(--card); }
  .ct-think::before { width: 12px; height: 12px; bottom: -10px; }
  .ct-think::after { width: 7px; height: 7px; bottom: -17px; }
  .ct-think-a::before { left: -2px; } .ct-think-a::after { left: -10px; }
  .ct-think-b::before { right: -2px; } .ct-think-b::after { right: -10px; }
  .ct-think .ct-line { font-style: italic; }
  .ct-who { font: 700 0.72rem/1.3 Inter, sans-serif; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .ct-line { font-size: 0.97rem; line-height: 1.4; overflow-wrap: anywhere; }
  .ct-fresh { background: color-mix(in srgb, var(--warn) 16%, transparent); outline: 1px solid color-mix(in srgb, var(--warn) 55%, transparent); border-radius: 6px; padding: 2px 6px; }
  .ct-tag { display: inline-block; margin-right: 6px; padding: 1px 6px; border-radius: 5px; font: 700 0.64rem/1.5 Inter, sans-serif; font-style: normal; letter-spacing: .06em; text-transform: uppercase; background: var(--bg-2); border: 1px solid var(--line); color: var(--muted); vertical-align: 1px; }
  .ct code { font: 600 0.93rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .ct-unseen { font: 600 0.8rem/1.3 Inter, sans-serif; color: var(--muted); }
  .ct-others { margin-top: 14px; display: grid; gap: 10px; }
  .ct-oh { font: 700 1rem/1.35 "Space Grotesk", sans-serif; }
  .ct-others ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ct-others li { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; padding: 10px 12px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); }
  .ct-others b { font: 700 0.95rem/1.3 "Space Grotesk", sans-serif; min-width: 7em; }
  @media (prefers-reduced-motion: reduce) { .ct-panel { transition: none; } }
  @media (max-width: 560px) {
    .ct-panel { padding: 12px 10px; }
    /* Phones: the two actors sit on a row above the bubbles, and the tails point up at the speaker. */
    .ct-stage { grid-template-columns: 1fr 1fr; gap: 12px 8px; }
    .ct-actor { grid-template-columns: auto auto; align-items: center; gap: 8px; }
    .ct-left { justify-self: start; }
    .ct-right { grid-column: 2; justify-self: end; }
    .ct-right .ct-av { order: 2; }
    .ct-mid { grid-column: 1 / -1; grid-row: 2; }
    .ct-av { width: 40px; height: 40px; }
    .ct-av svg { width: 22px; height: 22px; }
    .ct-name { font-size: 0.8rem; }
    .ct-say-a, .ct-say-b { margin: 0; }
    .ct-say::before { top: -7px; }
    .ct-say-a::before { left: 18px; border-color: inherit; border-right-color: transparent; border-bottom-color: transparent; }
    .ct-say-b::before { right: 18px; left: auto; border-color: inherit; border-right-color: transparent; border-bottom-color: transparent; }
    .ct-think::before { top: -10px; bottom: auto; } .ct-think::after { top: -17px; bottom: auto; }
    .ct-think-a::before { left: 20px; } .ct-think-a::after { left: 14px; }
    .ct-think-b::before { right: 20px; } .ct-think-b::after { right: 14px; }
    .ct-think { margin: 6px 0 0; }
    .ct-line { font-size: 0.92rem; }
  }
</style>
