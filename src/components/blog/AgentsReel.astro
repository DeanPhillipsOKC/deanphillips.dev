---
// The silent social video for the agents post (part 3 of "AI, plainly"). It is never shown to readers:
// the figure stays display:none unless a recording script sets data-reel (or data-og) on it, and it is
// aria-hidden. It retells the post's main visual (TextThreads): the made-up concert run as one-on-one text
// chats, one chat on screen at a time like a phone, in the same look and pacing as the tools post's reel
// (ToolsReel.astro) so the two videos read as a set. You text the app the job. Every turn is a brand new chat
// between the app and the model, with a "Turn N" counter in its header so it reads as a loop. Turn 1 shows
// the tools and the job pasted in, and the model's thinking and its search request. The later turns go
// quickly: the pasted "everything so far" tape grows by a note and a result each turn, with the newest
// result highlighted. In the turns where the model picks its own next step (Sunday after the rain, next
// Saturday after "Sold out", marked by a banner in the post's data) its thinking glows. The app stops in your
// chat for your OK, the last turn has no tool request (Done), and the app texts you the answer. An end card
// ties it back to part 2. One big headline per beat on top (about 88px at 1080 wide), chat text about 45px,
// the post's avatars and colors (you teal, app amber, model violet).
//
// The chats come from the post's own data (src/data/ai-plainly/ai-plainly-agents.json, `threads`), so the
// video can't drift from the post. Only the timings, the headlines and the tape are extra.
//
// Everything is drawn as a pure function of time, so scripts/video/ai-plainly-agents-reel.mjs can record
// it frame by frame: it sets data-reel (or data-og for the link preview) and calls
// window.__agentsReel.draw(seconds). There is no loop and no timer, so reduced motion has nothing to stop,
// and without JavaScript nothing shows (the figure is hidden either way). Each chat, message, and line
// carries its own times in data attributes: data-in/data-out for a chat, data-dots (the typing dots) and
// data-at (when it pops in) for a message, line, or pill, and data-type to type it out letter by letter instead.
type Who = 'you' | 'app' | 'model' | 'tool';
interface DLine { tag?: string; text: string; code?: boolean; fresh?: boolean; dim?: boolean }
interface DThread { me: Who; them: Who; sub: string; hidden?: boolean; banner?: string; end?: string; msgs: { who: Who; lines: DLine[] }[] }
interface Props { run: { threads: DThread[] } }
const { run } = Astro.props;
const TH = run.threads;

interface Line extends DLine { at?: number; idea?: boolean; tape?: { n: number; at: number } }
interface Msg { who: Who; lines: Line[]; dots?: number; at: number; type?: [number, number] }
interface Chat { me: Who; them: Who; turn?: number; sub: string; og?: boolean; end?: [string, number, 'over' | 'done' | '']; in: number; out: number; msgs: Msg[] }

// When each of the post's threads is on screen, and when its messages arrive. [dots, at] per message.
// `fresh` is when the newest result (and its piece of the tape) pops in, `end` is the pill at the bottom.
interface Time { in: number; out: number; m: [number | undefined, number][]; fresh?: number; end?: number; type?: [number, number] }
const TIMES: Time[] = [
  { in: -1, out: 3.4, m: [[undefined, 0]], type: [0.1, 1.5] }, // you text the app the job
  { in: 3.4, out: 9.8, m: [[3.9, 4.4], [6.0, 6.6]], fresh: 4.9, end: 8.5 }, // turn 1
  { in: 9.8, out: 12.8, m: [[10.2, 10.6], [11.5, 11.9]], fresh: 11.0 }, // turn 2
  { in: 12.8, out: 17.4, m: [[13.2, 13.6], [14.5, 15.0]], fresh: 14.0 }, // turn 3: rain, so Sunday
  { in: 17.4, out: 19.8, m: [[17.7, 18.0], [18.6, 18.9]], fresh: 18.3 }, // turn 4
  { in: 19.8, out: 24.2, m: [[20.1, 20.4], [21.4, 21.9]], fresh: 20.8 }, // turn 5: sold out, so next Saturday
  { in: 24.2, out: 27.8, m: [[24.7, 25.2], [26.1, 26.6]] }, // your OK
  { in: 27.8, out: 32.2, m: [[28.2, 28.6], [29.6, 30.1]], fresh: 29.0, end: 31.0 }, // turn 6: done
  { in: 32.2, out: 35.6, m: [[32.6, 33.1]], end: 34.1 }, // the app texts you back
];

const CHATS: Chat[] = TH.map((th, i) => {
  const tm = TIMES[i];
  const turn = Number(/turn (\d+)/.exec(th.sub)?.[1]) || undefined;
  const msgs: Msg[] = th.msgs.map((m, j) => {
    const [dots, at] = tm.m[j];
    const lines: Line[] = [];
    for (const l of m.lines) {
      // "Every note and result so far" becomes a tape that is longer each turn: the tools and your job, then
      // a note and a result per earlier turn. The newest piece pops in with the newest result.
      if (l.dim && turn) lines.push({ tag: l.tag, text: 'Everything so far', dim: true, tape: { n: 2 * turn, at: tm.fresh! } });
      else if (l.fresh) lines.push({ ...l, at: tm.fresh });
      else if (l.tag === 'You' && m.who === 'app') lines.push({ ...l, at: tm.fresh });
      // The turns where the model picks its own next step (the post marks them with a banner): its thinking glows.
      else lines.push({ ...l, idea: !!th.banner && l.tag === 'Thinks' });
    }
    return { who: m.who, lines, dots, at, type: j === 0 && tm.type ? tm.type : undefined };
  });
  let end: Chat['end'];
  if (tm.end !== undefined) end = th.end ? [th.end, tm.end, /Done/.test(th.end) ? 'done' : 'over'] : ['Every other chat happened out of sight.', tm.end, ''];
  // Your last chat still shows your OK above the answer, like the same phone a little later.
  if (i === TH.length - 1) msgs.unshift(...TH[i - 2].msgs.map((m) => ({ who: m.who, lines: m.lines, at: -1 })));
  const sub = th.hidden ? 'Hidden from you · new chat' : `On ${th.me === 'you' ? 'your' : "the app's"} phone`;
  return { me: th.me, them: th.them, turn, sub, og: turn === 3, end, in: tm.in, out: tm.out, msgs };
});
const NAME: Record<Who, string> = { you: 'You', app: 'The app', model: 'The model', tool: 'The tool' };
const ICON: Record<Who, string> = {
  you: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  app: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01M9 6.5h.01"/>',
  model: '<circle cx="12" cy="12" r="8"/><path d="M12 12l4-5"/><path d="M12 2v2M22 12h-2M2 12h2"/>',
  tool: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l6 6"/>',
};
const av = (w: Who) => `<svg viewBox="0 0 24 24" aria-hidden="true">${ICON[w]}</svg>`;
// Tape pieces: the tools and your job (muted), then a note (violet) and a result (amber) per turn.
const seg = (k: number) => (k < 2 ? 'arl-seg-job' : k % 2 ? 'arl-seg-res' : 'arl-seg-note');
---
<figure class="arl" aria-hidden="true">
  <div class="arl-main">
    <div class="arl-head">
      <p class="arl-hl" data-layer="a"><span></span></p>
      <p class="arl-hl" data-layer="b"><span></span></p>
    </div>
    <div class="arl-stage">
      {CHATS.map((c) => (
        <section class={`arl-phone${c.turn ? ' arl-hid' : ''}`} data-in={c.in} data-out={c.out} data-og={c.og ? '1' : undefined}>
          <header class="arl-top">
            <span class={`arl-av arl-${c.them}`} set:html={av(c.them)} />
            <div class="arl-who">
              <p class="arl-name">{NAME[c.them]}</p>
              <p class="arl-sub">{c.sub}</p>
            </div>
            {c.turn && <span class="arl-turn">Turn <b>{c.turn}</b></span>}
          </header>
          <div class="arl-log">
            {c.msgs.map((m) => (
              <>
                {m.dots !== undefined && (
                  <p class={`arl-dots arl-c-${m.who}${m.who === c.me ? ' arl-mine' : ''}`} data-from={m.dots} data-to={m.at}><i></i><i></i><i></i></p>
                )}
                <div class={`arl-msg arl-pop arl-c-${m.who}${m.who === c.me ? ' arl-mine' : ''}`} data-at={m.at} data-type={m.type?.join(',')}>
                  {m.lines.map((l) => (
                    <p class={`arl-line${l.fresh ? ' arl-fresh' : ''}${l.dim ? ' arl-dim' : ''}${l.idea ? ' arl-idea' : ''}${l.at !== undefined ? ' arl-pop' : ''}`} data-at={l.at ?? (l.idea ? m.at : undefined)}>
                      {l.tag && <span class="arl-tag">{l.tag}</span>}
                      {l.code ? <code data-text={l.text}>{l.text}</code> : <span data-text={l.text}>{l.text}</span>}
                      {l.tape && (
                        <span class="arl-tape">
                          {Array.from({ length: l.tape.n }, (_, k) => (
                            <i class={`${seg(k)}${k === l.tape!.n - 1 ? ' arl-pop arl-seg-new' : ''}`} data-at={k === l.tape!.n - 1 ? l.tape!.at : undefined} />
                          ))}
                        </span>
                      )}
                    </p>
                  ))}
                </div>
              </>
            ))}
            {c.end && <p class={`arl-end-pill arl-pop${c.end[2] ? ` arl-${c.end[2]}` : ''}`} data-at={c.end[1]}>{c.end[0]}</p>}
          </div>
        </section>
      ))}
    </div>
    <p class="arl-foot">The concert, weather, and prices are made up.</p>
  </div>
  <div class="arl-end">
    <p class="arl-end-1">Same loop as a tool call.</p>
    <p class="arl-end-2"><span>It just keeps going.</span></p>
    <p class="arl-end-3">Part 3 of AI, plainly<br /><b>deanphillips.dev</b></p>
  </div>
</figure>

<script>
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const ease = (x: number) => 1 - (1 - clamp(x)) ** 3;
  // A small overshoot, so a message pops in like a text arriving.
  const pop = (x: number) => { const c = clamp(x); return 1 + 2.2 * (c - 1) ** 3 + 1.2 * (c - 1) ** 2; };

  // One big headline per beat: start time and words. An empty headline hands over to the end card.
  const SHOTS: [number, string][] = [
    [0, 'Can an AI book concert tickets by itself?'],
    [3.4, 'Every turn is a brand new chat.'],
    [5.9, 'It thinks, then asks for a tool.'],
    [8.4, 'Chat over. It keeps nothing.'],
    [9.8, 'Next turn: everything so far, pasted in.'],
    [12.8, 'Rain on Saturday.'],
    [14.4, 'Nobody told it to try Sunday.'],
    [17.4, 'Sunday is dry. Tickets?'],
    [19.8, 'Sold out.'],
    [21.3, 'So it moves to next Saturday.'],
    [24.2, 'It stops for your OK.'],
    [27.8, 'Seats booked. One more turn.'],
    [30.0, 'Last turn: it just answers.'],
    [32.2, 'The app texts you the answer.'],
    [35.6, ''],
  ];
  const TOTAL = 39.5;
  const END = 35.4; // the end card starts
  const XF = 0.35; // headline crossfade
  const SLIDE = 0.5; // chat-to-chat slide

  const root = document.querySelector<HTMLElement>('.arl');
  if (root) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
    const main = $('.arl-main'), end = $('.arl-end');
    const layers = $$('.arl-hl');
    const phones = $$('.arl-phone');
    const num = (el: HTMLElement, k: string) => Number(el.dataset[k]);

    function headline(el: HTMLElement, s: number, v: number) {
      el.firstElementChild!.textContent = SHOTS[s][1];
      el.classList.toggle('is-hook', s === 0);
      el.style.opacity = String(v);
    }

    function draw(t: number) {
      t = Math.max(0, Math.min(TOTAL, t));
      const og = 'og' in root!.dataset;

      // Headline: the new line fades in over the old one, so the top never goes blank.
      let s = 0;
      while (s + 1 < SHOTS.length && t >= SHOTS[s + 1][0]) s++;
      if (og) s = 0;
      const into = s && !og ? ease((t - SHOTS[s][0]) / XF) : 1;
      headline(layers[0], s, into);
      if (s && into < 1) headline(layers[1], s - 1, 1 - into);
      else layers[1].style.opacity = '0';

      // Chats: the next one slides in from the right while the last one slides off to the left.
      for (const p of phones) {
        const a = num(p, 'in'), b = num(p, 'out');
        const e = ease((t - a) / SLIDE), l = ease((t - b) / SLIDE);
        const on = og ? 'og' in p.dataset : t >= a && t < b + SLIDE;
        p.style.display = on ? '' : 'none';
        if (!on) continue;
        p.style.transform = og ? 'none' : `translateX(${(1 - e) * 108 - l * 108}%)`;
        p.style.opacity = og ? '1' : String(Math.min(0.3 + 0.7 * e, 1 - 0.7 * l));
        // The turn counter ticks in as the chat arrives.
        const turn = p.querySelector<HTMLElement>('.arl-turn');
        if (turn) turn.style.transform = og ? 'none' : `scale(${0.6 + 0.4 * pop((t - a - 0.2) / 0.35)})`;
        for (const el of $$('.arl-pop', p)) {
          const at = num(el, 'at');
          const k = (t - at) / 0.35;
          el.style.display = t >= at ? '' : 'none';
          el.style.transform = `scale(${0.7 + 0.3 * pop(k)})`;
          el.style.opacity = String(ease(k * 1.6));
        }
        for (const el of $$('.arl-dots', p)) {
          const on = t >= num(el, 'from') && t < num(el, 'to');
          el.style.display = on ? '' : 'none';
          $$('i', el).forEach((d, i) => { d.style.opacity = String(0.35 + 0.65 * Math.max(0, Math.sin((t * 7) - i * 0.9))); });
        }
        for (const el of $$('.arl-msg[data-type]', p)) {
          const [ta, tb] = el.dataset.type!.split(',').map(Number);
          for (const tx of $$('[data-text]', el)) {
            const full = tx.dataset.text!;
            const n = Math.round(full.length * clamp((t - ta) / (tb - ta)));
            // The untyped rest stays in place, invisible, so the bubble keeps its size while it types.
            tx.innerHTML = '';
            tx.append(full.slice(0, n));
            const rest = document.createElement('span');
            rest.className = 'arl-ghost';
            rest.textContent = full.slice(n);
            tx.append(rest);
          }
        }
        // Once a chat is over, its messages fade back: the model keeps nothing.
        const endPill = p.querySelector<HTMLElement>('.arl-over');
        const over = endPill ? ease((t - num(endPill, 'at')) / 0.5) : 0;
        for (const el of $$('.arl-msg', p)) el.style.filter = over ? `opacity(${1 - 0.55 * over}) grayscale(${over})` : '';
        // The pasted-in result glows for a moment when it lands, and the model's own idea glows once it's written.
        for (const el of $$('.arl-fresh', p)) el.classList.toggle('is-glow', og || (t >= num(el, 'at') && t < num(el, 'at') + 1.6));
        for (const el of $$('.arl-idea', p)) el.classList.toggle('is-glow', og || t >= num(el, 'at') + 0.3);
      }

      // The end card replaces the chats.
      const e = ease((t - END) / 0.5);
      main.style.opacity = String(og ? 1 : 1 - e);
      end.style.opacity = String(og ? 0 : ease((t - END - 0.3) / 0.5));
      $<HTMLElement>('.arl-end-1').style.opacity = String(ease((t - END - 0.4) / 0.5));
      $<HTMLElement>('.arl-end-2').style.opacity = String(ease((t - END - 1.4) / 0.5));
      $<HTMLElement>('.arl-end-3').style.opacity = String(ease((t - END - 2.5) / 0.5));
    }
    (window as any).__agentsReel = { draw, total: TOTAL };
  }
</script>

<style is:global>
  .arl { display: none; }
  body:has(.arl[data-reel], .arl[data-og]) header.top { display: none; }
  .arl[data-reel], .arl[data-og] {
    position: fixed; inset: 0; z-index: 2147483647; margin: 0 !important; max-width: none !important; width: 100vw; height: 100vh; box-sizing: border-box;
    padding: 4cqw 4.4cqw 3cqw; display: flex; flex-direction: column; overflow: hidden; container-type: inline-size;
    color: var(--text); font: 500 4cqw/1.3 Inter, sans-serif;
    background: radial-gradient(120% 70% at 0% 0%, color-mix(in srgb, var(--violet) 16%, transparent), transparent 60%),
      radial-gradient(100% 70% at 100% 100%, color-mix(in srgb, var(--teal) 14%, transparent), transparent 60%), var(--bg);
  }
  .arl p { margin: 0; }
  .arl-main { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; }
  .arl-head { display: grid; align-items: end; min-height: 18.2cqw; margin-bottom: 3cqw; }
  .arl-hl { grid-area: 1 / 1; font: 700 8.2cqw/1.1 "Space Grotesk", sans-serif; letter-spacing: -0.02em; color: var(--text); }
  .arl-hl.is-hook span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .arl-stage { position: relative; flex: none; height: 90.5cqw; overflow: hidden; border-radius: 3.4cqw; }
  .arl-phone { position: absolute; inset: 0; display: flex; flex-direction: column; border-radius: 3.4cqw; border: 0.3cqw solid var(--line); background: var(--bg-2); overflow: hidden; }
  .arl-hid { border-style: dashed; border-color: var(--muted); }
  .arl-top { display: flex; align-items: center; gap: 2.4cqw; padding: 2.4cqw 3cqw; background: var(--card); border-bottom: 0.2cqw solid var(--line); }
  .arl-who { flex: 1; min-width: 0; }
  .arl-name { font: 700 4.8cqw/1.15 "Space Grotesk", sans-serif; }
  .arl-sub { font-size: 3.2cqw; font-weight: 600; color: var(--muted); }
  .arl-turn { flex: none; font: 700 3.6cqw/1.1 "Space Grotesk", sans-serif; letter-spacing: .02em; text-transform: uppercase; color: var(--text); padding: 1.2cqw 2.6cqw; border-radius: 99px; background: color-mix(in srgb, var(--violet) 22%, var(--card)); border: 0.35cqw solid var(--violet); }
  .arl-turn b { font-size: 5cqw; color: var(--violet); margin-left: 0.6cqw; vertical-align: -0.3cqw; }
  .arl-av { flex: none; width: 9cqw; height: 9cqw; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--c) 22%, var(--card)); border: 0.45cqw solid var(--c); }
  .arl-av svg { width: 5cqw; height: 5cqw; fill: none; stroke: var(--c); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .arl-you, .arl-c-you { --c: var(--teal); }
  .arl-app, .arl-c-app { --c: var(--warn); }
  .arl-model, .arl-c-model { --c: var(--violet); }
  .arl-tool, .arl-c-tool { --c: #4b93f0; }
  .arl-log { display: flex; flex-direction: column; gap: 2cqw; padding: 2.6cqw 3cqw; }
  .arl-msg, .arl-dots { align-self: flex-start; max-width: 94%; min-width: 0; box-sizing: border-box; padding: 2cqw 3cqw; border-radius: 3.6cqw 3.6cqw 3.6cqw 0.8cqw; background: color-mix(in srgb, var(--c) 15%, var(--card)); border: 0.3cqw solid color-mix(in srgb, var(--c) 55%, transparent); transform-origin: 0% 100%; }
  .arl-mine { align-self: flex-end; border-radius: 3.6cqw 3.6cqw 0.8cqw 3.6cqw; background: color-mix(in srgb, var(--c) 28%, var(--card)); transform-origin: 100% 100%; }
  .arl-msg { display: flex; flex-direction: column; gap: 1.2cqw; }
  .arl-line { font-size: 4.2cqw; line-height: 1.3; overflow-wrap: anywhere; transform-origin: 0 50%; }
  .arl-ghost { opacity: 0; }
  .arl-dim > span[data-text] { color: var(--muted); font-style: italic; }
  .arl-tape { display: flex; flex-wrap: wrap; gap: 0.7cqw; margin-top: 1.2cqw; }
  .arl-tape i { flex: none; width: 4.6cqw; height: 2.6cqw; border-radius: 0.6cqw; transform-origin: 0 50%; }
  .arl-seg-job { background: var(--muted); }
  .arl-seg-note { background: var(--violet); }
  .arl-seg-res { background: var(--warn); }
  .arl-seg-new { box-shadow: 0 0 0 0.5cqw color-mix(in srgb, var(--warn) 40%, transparent); }
  .arl-fresh { margin: 0 -1.2cqw !important; padding: 0.6cqw 1.2cqw; border-radius: 1.4cqw; background: color-mix(in srgb, var(--warn) 22%, transparent); outline: 0.3cqw solid color-mix(in srgb, var(--warn) 75%, transparent); }
  .arl-fresh.is-glow { box-shadow: 0 0 0 1cqw color-mix(in srgb, var(--warn) 30%, transparent); }
  .arl-idea { margin: 0 -1.2cqw !important; padding: 0.6cqw 1.2cqw; border-radius: 1.4cqw; transition: none; }
  .arl-idea.is-glow { background: color-mix(in srgb, var(--violet) 26%, transparent); outline: 0.3cqw solid var(--violet); box-shadow: 0 0 0 1cqw color-mix(in srgb, var(--violet) 25%, transparent); }
  .arl-tag { display: inline-block; margin-right: 1.6cqw; padding: 0.3cqw 1.2cqw; border-radius: 1cqw; font: 800 3cqw/1.35 Inter, sans-serif; letter-spacing: .05em; text-transform: uppercase; background: var(--bg-2); border: 0.2cqw solid var(--line); color: var(--muted); vertical-align: 0.5cqw; }
  .arl-fresh .arl-tag { color: var(--warn); border-color: var(--warn); }
  .arl-idea.is-glow .arl-tag { color: var(--violet); border-color: var(--violet); }
  .arl code { font: 600 3.9cqw/1.3 "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace; background: none; border: 0; padding: 0; color: var(--text); }
  .arl-dots { display: flex; gap: 1.4cqw; padding: 2.6cqw 3.4cqw; }
  .arl-dots i { width: 2cqw; height: 2cqw; border-radius: 50%; background: var(--c); }
  .arl-end-pill { align-self: center; text-align: center; font: 700 3.5cqw/1.3 Inter, sans-serif; color: var(--text); padding: 1.2cqw 3.4cqw; border-radius: 99px; background: var(--card); border: 0.3cqw solid var(--muted); }
  .arl-end-pill.arl-done { color: var(--ok); border-color: var(--ok); background: color-mix(in srgb, var(--ok) 14%, var(--card)); }
  .arl-foot { margin-top: 2cqw !important; font-size: 3cqw; font-weight: 600; color: var(--muted); }
  .arl-end { position: absolute; inset: 0; display: grid; align-content: center; gap: 5cqw; padding: 0 7cqw; opacity: 0; pointer-events: none; }
