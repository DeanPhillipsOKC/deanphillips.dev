---
// The silent social video for the agents post (part 3 of "AI, plainly"). It is never shown to readers:
// the figure stays display:none unless a recording script sets data-reel (or data-og) on it, and it is
// aria-hidden. It retells LoopInLoop's made-up concert run one idea per shot, with big words on top. Frame 0
// already shows the whole diagram with your job filled in, and the model starts writing at once. The model
// (violet) writes a tool request, the request rides the down arrow to a regular program (teal, "the harness"
// as a sublabel) while the model dims with a calm "waiting" tag, the result flies down into the conversation
// bar, and the up arrow carries it back. Turn 1 takes about 6 seconds and the rest get quicker. The model
// changes plan after the rain and again after "Sold out" (an "It changed plan" badge in its header), turn 5
// asks for two tools at once (shown in its short reel form from the data) and the harness stops for your OK before booking, and the last turn has no tool
// request (Done). An end card draws the three
// steps with a big arrow back to the top, so it reads as a loop. Turn text, tool chips and results come from
// src/data/ai-plainly/ai-plainly-agents.json, the same data the post's run uses, so the video can't drift
// from the post. Only the headlines are extra. Colors follow the post: the model violet, the program and its
// results teal, your job muted on --bg-2, the surprise result --warn, Done --ok. Every label is at least
// 3.6cqw (about 35px at 1080 wide) so it reads on a phone.
//
// Everything is drawn as a pure function of time, so scripts/video/ai-plainly-agents-reel.mjs can record
// it frame by frame: it sets data-reel (or data-og for the link preview) and calls
// window.__agentsReel.draw(seconds). There is no loop and no timer, so reduced motion has nothing to stop,
// and without JavaScript nothing shows (the figure is hidden either way).
interface Turn { wrote: string; tool: string | null; back: string | null; also?: { tool: string; back: string }; reel?: { tool: string; back: string }; ok?: { ask: string; you: string }; after?: string; adjust?: boolean; wroteSize: number; backSize: number; surprise?: boolean }
interface Props { run: { job: string; jobShort?: string; jobSize: number; turns: Turn[] } }
const { run } = Astro.props;
const dial = '<svg class="arl-ico" viewBox="-10 -10 20 20" aria-hidden="true"><circle r="8" /><line x1="0" y1="0" x2="4" y2="-6" /></svg>';
const clip = '<svg class="arl-ico arl-ico-clip" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2" /><rect x="9" y="2" width="6" height="4" rx="1" /><path d="M8.5 11h7M8.5 15h5" /></svg>';
// The job is shown short in the bubble, so it fits two lines on a phone.
const job = run.jobShort ?? run.job;
---
<figure class="arl" aria-hidden="true" data-run={JSON.stringify({ ...run, job })}>
  <div class="arl-main">
    <div class="arl-head">
      <div class="arl-hl" data-layer="a"><span class="arl-h1"></span> <span class="arl-h2"></span></div>
      <div class="arl-hl" data-layer="b"><span class="arl-h1"></span> <span class="arl-h2"></span></div>
    </div>
    <div class="arl-flow">
      <div class="arl-job"><span class="arl-tag">Your job</span><span class="arl-job-t">{job}</span></div>
      <section class="arl-box arl-model">
        <div class="arl-bh"><Fragment set:html={dial} /><b>The model</b><span class="arl-wait"><i></i><i></i>waiting</span><span class="arl-plan">It changed plan</span></div>
        <div class="arl-wrote"><span class="arl-tag arl-tag-m">It writes</span><span class="arl-wrote-t"></span></div>
        <div class="arl-req">
          <span class="arl-chip arl-chip-req"><span class="arl-req-t"></span></span>
          <span class="arl-none">no tool request</span>
          <span class="arl-done">Done</span>
        </div>
      </section>
      <div class="arl-arrows">
        <div class="arl-down"><i></i><span>a tool request</span></div>
        <div class="arl-up"><i></i><span>result goes back in</span></div>
        <span class="arl-fly arl-chip arl-chip-req"><span class="arl-fly-t"></span></span>
      </div>
      <section class="arl-box arl-harness">
        <div class="arl-bh"><Fragment set:html={clip} /><b>A regular program</b><span class="arl-sub">the harness</span></div>
        <div class="arl-run"><span class="arl-tag">runs</span><span class="arl-chip arl-chip-run"><span class="arl-run-t"></span></span></div>
        <div class="arl-back"><span class="arl-tag arl-tag-h">got</span><span class="arl-chip arl-chip-back"><span class="arl-back-t"></span></span></div>
        <div class="arl-ok"><span class="arl-ok-h"><span class="arl-ok-p"><i></i><i></i></span>Stops for your OK</span><span class="arl-ok-q"></span><span class="arl-ok-you">You: <b class="arl-ok-a"></b></span></div>
      </section>
      <div class="arl-conv">
        <div class="arl-cl">The conversation</div>
        <div class="arl-tape">
          <i class="arl-tb arl-tb-job"></i>
          {run.turns.map((t, i) => (<><i class="arl-tb arl-tb-m" data-w={i}></i>{t.back && <i class="arl-tb arl-tb-h" data-b={i} data-surprise={t.surprise ? '1' : undefined}></i>}</>))}
        </div>
      </div>
      <span class="arl-paste arl-chip arl-chip-back"><span class="arl-paste-t"></span></span>
    </div>
    <div class="arl-foot"><span>Made-up example</span><span class="arl-turn"></span></div>
  </div>
  <div class="arl-end">
    <div class="arl-end-1">An agent is the same AI, in a loop.</div>
    <div class="arl-loop">
      <div class="arl-card arl-card-m"><b>The model</b> writes a request</div>
      <span class="arl-arrow"></span>
      <div class="arl-card arl-card-h"><b>A regular program</b> does it</div>
      <span class="arl-arrow"></span>
      <div class="arl-card arl-card-c"><b>The result</b> goes back in</div>
      <div class="arl-ret"><span>repeat</span></div>
    </div>
    <div class="arl-end-2">It stops when it writes<br />no tool request.</div>
    <div class="arl-end-3">Part 3 of AI, plainly <b>deanphillips.dev</b></div>
  </div>
</figure>

<script>
  type Turn = { wrote: string; tool: string | null; back: string | null; also?: { tool: string; back: string }; reel?: { tool: string; back: string }; ok?: { ask: string; you: string }; after?: string; adjust?: boolean; wroteSize: number; backSize: number; surprise?: boolean };
  type Run = { job: string; jobSize: number; turns: Turn[] };
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const ease = (x: number) => 1 - (1 - clamp(x)) ** 3;
  const smooth = (x: number) => { x = clamp(x); return x * x * (3 - 2 * x); };
  // Fades in over [a, a + d] and, when b is given, out over [b, b + d].
  const win = (t: number, a: number, b = Infinity, d = 0.35) => Math.min(ease((t - a) / d), 1 - ease((t - b) / d));
  const type = (s: string, t: number, a: number, b: number) => s.slice(0, Math.round(s.length * clamp((t - a) / (b - a))));

  // Each turn: model starts (m), writing (w0 to w1), request chip or "no tool request" (c), the program takes
  // over (h, after the chip rides the arrow for 0.6 s), the result comes back (r), and the result flies down
  // into the conversation bar (p). Turn 1 is the slow one, then each turn gets quicker. Turn 5 also has the
  // harness stop for your OK (ok), you say yes (yes), and the booking comes back (bk).
  type Plan = { m: number; w0: number; w1: number; c: number; h: number; r: number; p: number; ok?: number; yes?: number; bk?: number };
  const PLAN: Plan[] = [
    { m: 0.0, w0: 0.15, w1: 1.1, c: 1.5, h: 2.8, r: 3.6, p: 4.8 },
    { m: 6.0, w0: 6.2, w1: 7.0, c: 7.3, h: 8.1, r: 8.6, p: 9.2 },
    { m: 10.3, w0: 10.5, w1: 11.1, c: 11.4, h: 12.2, r: 12.7, p: 13.3 },
    { m: 14.4, w0: 14.6, w1: 15.1, c: 15.3, h: 15.9, r: 16.4, p: 16.9 },
    { m: 18.6, w0: 18.8, w1: 19.7, c: 20.0, h: 20.8, r: 21.3, ok: 22.0, yes: 23.2, bk: 23.9, p: 24.6 },
    { m: 25.8, w0: 26.0, w1: 27.4, c: 27.6, h: Infinity, r: Infinity, p: Infinity },
  ];
  const DONE_AT = 28.2;
  // The shots: start time, headline, an optional second sentence and when it appears. Each headline
  // switches when its event starts.
  const SHOTS: [number, string, string?, number?][] = [
    [0, 'What makes an AI an agent?'],
    [PLAN[0].c, 'The AI writes a request.'],
    [PLAN[0].h - 0.3, 'A regular program does it.'],
    [PLAN[0].p, 'The result gets pasted in.'],
    [PLAN[1].m, 'Then around it goes again.'],
    [PLAN[2].m, 'It reads the rain.', 'It tries Sunday.', PLAN[2].w0 + 0.3],
    [PLAN[3].m, 'Now it checks for seats.'],
    [PLAN[3].r, 'Sold out.', 'So it adjusts again.', PLAN[4].m],
    [PLAN[4].ok!, 'Booking needs your OK.', 'You say yes.', PLAN[4].yes],
    [PLAN[5].c, 'No tool request.', 'So it stops.', DONE_AT],
    [31, ''],
  ];
  const END = 31, TOTAL = 36.5;
  const XF = 0.5; // headline change: out over the first half, in over the second
  const FLY = 0.6; // the result's trip down to the conversation bar

  const root = document.querySelector<HTMLElement>('.arl');
  if (root) {
    const run: Run = JSON.parse(root.dataset.run!);
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = (s: string) => [...root.querySelectorAll<HTMLElement>(s)];
    const head = $('.arl-head');
    const layers = $$('.arl-hl');
    const model = $('.arl-model'), harness = $('.arl-harness'), flow = $('.arl-flow');
    const total = run.jobSize + run.turns.reduce((s, x) => s + x.wroteSize + x.backSize, 0);
    const SCALE = total * 1.08; // the bar ends a little short of the full width
    const pct = (n: number) => `${(100 * n / SCALE).toFixed(3)}%`;
    $('.arl-tb-job').style.width = pct(run.jobSize);

    function headline(el: HTMLElement, s: number, v: number) {
      const [, h, second] = SHOTS[s];
      el.querySelector('.arl-h1')!.textContent = h;
      el.querySelector('.arl-h2')!.textContent = second ?? '';
      el.classList.toggle('is-hook', s === 0);
      el.style.opacity = String(v);
    }
    const op = (sel: string, v: number) => { $(sel).style.opacity = String(v); };

    function draw(t: number) {
      t = Math.max(0, Math.min(TOTAL, t));
      let s = 0;
      while (s + 1 < SHOTS.length && t >= SHOTS[s + 1][0]) s++;
      const a = SHOTS[s][0];

      // Headline: the old line fades out, then the new one fades in, so two lines never sit on top of each other.
      const into = s ? ease((t - a - XF / 2) / (XF / 2)) : 1;
      const out = s ? 1 - ease((t - a) / (XF / 2)) : 0;
      headline(layers[0], s, into);
      const at = SHOTS[s][3];
      layers[0].querySelector<HTMLElement>('.arl-h2')!.style.opacity = String(at ? ease((t - at) / 0.35) : 0);
      if (s && out > 0) {
        headline(layers[1], s - 1, out);
        layers[1].querySelector<HTMLElement>('.arl-h2')!.style.opacity = '1';
      } else layers[1].style.opacity = '0';
      head.classList.toggle('is-hook', s === 0);

      // Which turn the model is on (the last one started), and its timing.
      let i = 0;
      while (i + 1 < PLAN.length && t >= PLAN[i + 1].m) i++;
      const P = PLAN[i], T = run.turns[i];

      // The model: lit while it writes, dimmed with a calm "waiting" tag while the program works.
      const off = t >= P.h;
      model.classList.toggle('is-on', !off);
      model.classList.toggle('is-off', off);
      op('.arl-wait', off ? ease((t - P.h) / 0.3) : 0);
      $('.arl-wrote-t').textContent = type(T.wrote, t, P.w0, P.w1);
      const hasTool = !!T.tool;
      // A turn with two requests shows its short reel form, so the chips stay one line on a phone.
      const req = T.reel?.tool ?? T.tool ?? '';
      $('.arl-req-t').textContent = req;
      op('.arl-req .arl-chip-req', hasTool ? ease((t - P.c) / 0.3) : 0);
      op('.arl-none', !hasTool ? ease((t - P.c) / 0.35) : 0);
      // The badge shows while the model writes a changed plan, until it hands over its request.
      const planAt = P.w0 + 0.3;
      op('.arl-plan', T.adjust ? win(t, planAt, P.h - 0.3, 0.3) : 0);
      $('.arl-plan').style.transform = `scale(${T.adjust ? 0.8 + 0.2 * ease((t - planAt) / 0.3) : 1})`;
      const done = i === PLAN.length - 1 ? ease((t - DONE_AT) / 0.35) : 0;
      op('.arl-done', done);
      model.classList.toggle('is-done', done > 0.5);

      // The request rides the down arrow for the 0.6 s before the program takes over.
      const fly = hasTool ? clamp((t - (P.h - 0.6)) / 0.6) : 0;
      const fl = $('.arl-fly');
      $('.arl-fly-t').textContent = req;
      fl.style.opacity = String(hasTool && t >= P.h - 0.6 && t < P.h + 0.15 ? 1 - clamp((t - P.h) / 0.15) : 0);
      fl.style.setProperty('--y', String(smooth(fly)));
      const downLit = hasTool && t >= P.c && t < P.h + 0.3;
      $('.arl-down').classList.toggle('is-lit', downLit);
      // The arrow's label steps aside while the request rides past it.
      $('.arl-down span').style.opacity = String(hasTool ? 1 - win(t, P.h - 0.75, P.h, 0.15) : 1);
      $('.arl-up span').style.opacity = String(hasTool ? 1 - win(t, P.h - 0.75, P.h, 0.15) : 1);
      // The up arrow lights once the result lands in the bar, until the model's next turn is under way.
      const upLit = hasTool && t >= P.p + FLY - 0.1 && (i + 1 >= PLAN.length || t < PLAN[i + 1].m + 0.5);
      $('.arl-up').classList.toggle('is-lit', upLit);

      // The program: lit while it runs the tool. It shows the tool, then what came back.
      const hOn = t >= P.h && t < P.p + FLY;
      harness.classList.toggle('is-on', hOn);
      const hv = hasTool && t >= P.h ? ease((t - P.h) / 0.3) : 0;
      $('.arl-run-t').textContent = hv ? req : '';
      op('.arl-run', hv);
      const bv = hasTool && t >= P.r ? ease((t - P.r) / 0.3) : 0;
      const booked = P.bk !== undefined && t >= P.bk;
      const back = T.reel?.back ?? T.back ?? '';
      $('.arl-back-t').textContent = bv ? (booked ? T.after! : back) : '';
      op('.arl-back', bv);
      // Your OK: the harness stops and asks, you say yes, then it books.
      const okv = T.ok && P.ok !== undefined ? win(t, P.ok, P.bk! - 0.35, 0.3) : 0;
      op('.arl-ok', okv);
      if (T.ok) { $('.arl-ok-q').textContent = T.ok.ask; $('.arl-ok-a').textContent = T.ok.you; }
      op('.arl-ok-you', T.ok && P.yes !== undefined ? ease((t - P.yes) / 0.3) : 0);
      harness.querySelector('.arl-chip-back')!.classList.toggle('is-surprise', !!T.surprise);

      // The bar grows: the model's writing as it writes, each result as it lands.
      PLAN.forEach((p, j) => {
        const x = run.turns[j];
        root!.querySelector<HTMLElement>(`[data-w="${j}"]`)!.style.width = pct(x.wroteSize * clamp((t - p.w0) / (p.w1 - p.w0)));
        const b = root!.querySelector<HTMLElement>(`[data-b="${j}"]`);
        if (b) {
          b.style.width = pct(x.backSize * ease((t - p.p - FLY + 0.15) / 0.4));
          b.classList.toggle('is-new', t >= p.p + FLY - 0.15 && t < p.p + FLY + 1.2);
        }
      });

      // The result flies from the program's "got" chip down to where it lands in the bar, shrinking as it goes.
      const ps = $('.arl-paste');
      const pf = hasTool ? (t - P.p) / FLY : -1;
      if (pf >= 0 && pf < 1.05) {
        $('.arl-paste-t').textContent = T.after ?? T.back!;
        ps.classList.toggle('is-surprise', !!T.surprise);
        const fr = flow.getBoundingClientRect();
        const src = harness.querySelector('.arl-chip-back')!.getBoundingClientRect();
        const dst = root!.querySelector<HTMLElement>(`[data-b="${i}"]`)!.getBoundingClientRect();
        const k = smooth(pf);
        const sc = 1 - 0.55 * k;
        const x = (src.left - fr.left) + ((dst.left - fr.left) - (src.left - fr.left)) * k;
        const y = (src.top - fr.top) + ((dst.top + dst.height / 2 - src.height * sc / 2 - fr.top) - (src.top - fr.top)) * k;
        ps.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) scale(${sc.toFixed(3)})`;
        ps.style.opacity = String(pf < 0.85 ? 1 : 1 - clamp((pf - 0.85) / 0.2));
      } else ps.style.opacity = '0';

      // The footnote and the turn label.
      $('.arl-turn').textContent = `Turn ${i + 1} of ${run.turns.length}`;

      // The end card replaces the stage, then the loop draws itself: the three steps, then the way back up.
      const e = ease((t - END + 0.2) / 0.6);
      $('.arl-main').style.opacity = String(1 - e);
      op('.arl-end', ease((t - END) / 0.5));
      op('.arl-end-1', ease((t - END - 0.1) / 0.5));
      $$('.arl-loop > :not(.arl-ret)').forEach((c, j) => { c.style.opacity = String(ease((t - END - 0.5 - j * 0.25) / 0.4)); });
      op('.arl-ret', ease((t - END - 1.9) / 0.5));
      $('.arl-ret').style.setProperty('--draw', String(smooth((t - END - 1.9) / 0.7)));
      op('.arl-end-2', ease((t - END - 2.8) / 0.5));
      op('.arl-end-3', ease((t - END - 3.3) / 0.5));
    }
    (window as any).__agentsReel = { draw, total: TOTAL, plan: PLAN };
  }
</script>

<style is:global>
  .arl { display: none; }
  body:has(.arl[data-reel], .arl[data-og]) header.top { display: none; }
  .arl[data-reel], .arl[data-og] {
    position: fixed; inset: 0; z-index: 2147483647; margin: 0 !important; max-width: none !important; width: 100vw; height: 100vh; box-sizing: border-box;
    padding: 3vh 5vw; display: flex; flex-direction: column; justify-content: center; overflow: hidden; container-type: inline-size;
    color: var(--text); font: 500 4cqw/1.3 Inter, sans-serif;
    background: radial-gradient(120% 70% at 0% 0%, color-mix(in srgb, var(--violet) 18%, transparent), transparent 60%),
      radial-gradient(100% 70% at 100% 100%, color-mix(in srgb, var(--teal) 16%, transparent), transparent 60%), var(--bg);
  }
  .arl-main { display: flex; flex-direction: column; }
  .arl-head { display: grid; align-items: end; min-height: 16.4cqw; margin-bottom: 2.4cqw; }
  .arl-hl { grid-area: 1 / 1; font: 700 6.6cqw/1.12 "Space Grotesk", sans-serif; letter-spacing: -0.02em; }
  .arl-hl.is-hook { font-size: 8.2cqw; }
  .arl-hl span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .arl-hl .arl-h2 { display: block; }
  .arl-flow { position: relative; display: flex; flex-direction: column; gap: 2cqw; }
  .arl-tag { display: inline-block; font: 800 3.6cqw/1.2 Inter, sans-serif; letter-spacing: .04em; text-transform: uppercase; color: var(--text); }
  .arl-tag-m { color: var(--violet); } .arl-tag-h { color: var(--teal); }
  .arl-job { padding: 1.6cqw 3cqw; border-radius: 2.4cqw; background: var(--bg-2); border: 0.3cqw solid var(--line); min-height: 13.6cqw; box-sizing: border-box; font-weight: 600; font-size: 4.4cqw; line-height: 1.3; }
  .arl-job .arl-tag, .arl-wrote .arl-tag { margin-right: 1.8cqw; }
  .arl-job .arl-tag { color: var(--muted); }
  .arl-box { position: relative; border: 0.4cqw solid var(--line); border-radius: 2.4cqw; padding: 1.8cqw 3cqw 2cqw; background: color-mix(in srgb, var(--card) 85%, transparent); display: grid; gap: 1.2cqw; transition: none; }
  .arl-model { border-color: color-mix(in srgb, var(--violet) 55%, var(--line)); }
  .arl-model.is-on { border-color: var(--violet); box-shadow: 0 0 0 0.6cqw color-mix(in srgb, var(--violet) 22%, transparent), 0 0 6cqw color-mix(in srgb, var(--violet) 30%, transparent); }
  .arl-model.is-off .arl-wrote, .arl-model.is-off .arl-req > :not(.arl-plan), .arl-model.is-off .arl-bh > b, .arl-model.is-off .arl-ico { opacity: 0.6; }
  .arl-model.is-done { border-color: var(--ok); box-shadow: 0 0 0 0.6cqw color-mix(in srgb, var(--ok) 22%, transparent); }
  .arl-harness { border-color: color-mix(in srgb, var(--teal) 45%, var(--line)); }
  .arl-harness:not(.is-on) > * { opacity: 0.6; }
  .arl-harness.is-on { border-color: var(--teal); box-shadow: 0 0 0 0.6cqw color-mix(in srgb, var(--teal) 22%, transparent), 0 0 6cqw color-mix(in srgb, var(--teal) 30%, transparent); }
  .arl-bh { display: flex; align-items: center; gap: 2cqw; }
  .arl-bh b { white-space: nowrap; font: 700 5.4cqw/1.1 "Space Grotesk", sans-serif; }
  .arl-ico { width: 5.6cqw; height: 5.6cqw; flex: none; }
  .arl-model .arl-ico { color: var(--violet); } .arl-harness .arl-ico { color: var(--teal); }
  .arl-ico circle { fill: none; stroke: currentColor; stroke-width: 2; }
  .arl-ico line { stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; }
  .arl-ico-clip { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .arl-sub { font: 600 3.8cqw/1 Inter, sans-serif; color: var(--muted); }
  /* A calm "waiting" tag with a pause sign, in the header, so it never covers the model's words. */
  .arl-wait { margin-left: auto; display: inline-flex; align-items: center; gap: 0.8cqw; font: 700 3.8cqw/1 Inter, sans-serif; color: var(--muted); padding: 1cqw 2.2cqw 1cqw 1.8cqw; border-radius: 99px; border: 0.3cqw solid var(--line); opacity: 0; }
  .arl-wait i { display: block; width: 0.9cqw; height: 3.2cqw; border-radius: 0.3cqw; background: currentColor; }
  .arl-wait i + i { margin-right: 1cqw; }
