---
// Retrieval as two still pictures, no controls. Each panel is the same map of stored passages with one
// search note pinned on it. Lines run to the three nearest passages (worked out here from the positions),
// and a short verdict under the map says what came back. The first panel is a good match with no shared
// words, the second grabs the wrong page. Drawn in SVG so it scales to any width, and the nearest
// passages are also listed as text under each map.
interface P { label: string; x: number; y: number }
interface Panel { title: string; note: string; x: number; y: number; verdict: string; tone?: 'ok' | 'warn' }
interface Props { passages: P[]; panels: Panel[]; caption?: string }
const { passages, panels, caption } = Astro.props;
const W = 100, H = 72;
const near = (p: Panel) => passages.map((q) => ({ q, d: Math.hypot(q.x - p.x, q.y - p.y) })).sort((a, b) => a.d - b.d).slice(0, 3).map((n) => n.q);
---
<figure class="nm panel bleed">
  <div class="nm-grid">
    {panels.map((p) => {
      const nn = near(p);
      return (
        <section class={`nm-card nm-${p.tone ?? 'ok'}`}>
          <p class="nm-title">{p.title}</p>
          <p class="nm-note"><span>Search note</span><code>{p.note}</code></p>
          <svg class="nm-map" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Map of stored passages. Nearest to the search note: ${nn.map((n) => n.label).join(', ')}.`}>
            {nn.map((n) => <line x1={p.x} y1={p.y} x2={n.x} y2={n.y} />)}
            {passages.map((q) => {
              const on = nn.includes(q);
              const right = q.x > 64;
              return (
                <g class={on ? 'nm-on' : ''}>
                  <circle cx={q.x} cy={q.y} r={on ? 1.9 : 1.4} />
                  <text x={right ? q.x - 3 : q.x + 3} y={q.y + 1.3} text-anchor={right ? 'end' : 'start'}>{q.label}</text>
                </g>
              );
            })}
            <g class="nm-pin">
              <rect x={p.x - 2.6} y={p.y - 2.6} width="5.2" height="5.2" rx="1" transform={`rotate(45 ${p.x} ${p.y})`} />
            </g>
          </svg>
          <p class="nm-got"><span>Fetched</span>{nn.map((n, i) => <b>{i + 1}. {n.label}</b>)}</p>
          <p class="nm-verdict">{p.verdict}</p>
        </section>
      );
    })}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .nm p { margin: 0; }
  .nm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .nm-card { display: grid; gap: 10px; align-content: start; padding: 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); border-top: 4px solid var(--tone); }
  .nm-ok { --tone: var(--ok); }
  .nm-warn { --tone: var(--warn); }
  .nm-title { font: 700 1.1rem/1.3 "Space Grotesk", sans-serif; }
  .nm-note { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; font-size: 0.9rem; }
  .nm-note span, .nm-got span { font: 700 0.68rem/1.4 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .nm-note code { font: 600 0.9rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--violet); overflow-wrap: anywhere; }
  .nm-map { width: 100%; height: auto; display: block; border-radius: 10px; background:
    radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--muted) 30%, transparent) 1px, transparent 0) 0 0 / 16px 16px, var(--card); }
  .nm-map line { stroke: var(--teal); stroke-width: 0.6; stroke-dasharray: 1.6 1.2; }
  .nm-map circle { fill: var(--muted); }
  .nm-map text { font: 600 3.4px Inter, sans-serif; fill: var(--muted); }
  .nm-map .nm-on circle { fill: var(--teal); }
  .nm-map .nm-on text { fill: var(--text); font-weight: 700; }
  .nm-pin rect { fill: var(--violet); stroke: var(--bg); stroke-width: 0.6; }
  .nm-got { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; font-size: 0.92rem; }
  .nm-got b { font-weight: 600; }
  .nm-verdict { font-size: 0.98rem; line-height: 1.45; padding: 10px 12px; border-radius: 10px; background: color-mix(in srgb, var(--tone) 12%, var(--card)); border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent); }
  @media (max-width: 700px) {
    .nm-grid { grid-template-columns: 1fr; }
    .nm-map text { font-size: 4.4px; }
  }
</style>
