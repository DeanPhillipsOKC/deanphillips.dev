---
// The main picture of the tools post: one round trip of a tool request, in six steps. Four bands are
// stacked top to bottom (You, the model, the conversation, the app and its tools). The conversation sits
// in the middle on purpose, between the model and the app, because everything passes through it: the
// model writes its note into it, the app reads the note from it, and the app pastes the result back into
// it. Arrows between neighboring bands say what moves, in the color of the thing moving. The band that
// acts in the current step is lit and marked NOW. The conversation is never dimmed, and its newest line
// gets a NEW tag. In step 6 a bar sweeps down the conversation to show the model rereading it from the
// top, and a dashed arrow loops back up (the setup for the agents post).
//
// The reader picks one of three questions (web search, running code, reading a file) and steps through
// with Back and Next (right above the picture, so the change is in view), or presses Play. A toggle
// switches the conversation between what the person sees and what the model reads, with a line count
// and "hidden from you" ghosts for the lines the person never sees. Under 560px, bands that aren't
// acting shrink to one line (name plus a short state), so the figure fits about one phone screen.
//
// Reduced motion swaps states instantly and hides Play. Without JavaScript, an ordered list walks
// through the first question, followed by the conversation as the model reads it.
interface Q { chip: string; short: string; note: string; status: string; programLabel: string; icon: string; result: string; answer: string; extra?: string }
interface Props { questions: Q[]; toolList: string; caption?: string }
const { questions, toolList, caption } = Astro.props;
const a = questions[0];
const LANES = [
  { id: 'you', name: 'You', sub: '' },
  { id: 'model', name: 'The model', sub: 'guesses text' },
  { id: 'conv', name: 'The conversation', sub: 'everything passes through here' },
  { id: 'program', name: 'The app and its tools', sub: 'ordinary code, no guessing' },
];
---
<figure class="tr panel bleed" data-relay={JSON.stringify({ questions })}>
  <div class="tr-ui" hidden>
    <div class="tr-chips" role="group" aria-label="Pick a question">
      {questions.map((q, i) => <button type="button" class="tr-chip" data-q={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={q.chip}>{q.short}</button>)}
    </div>
    <div class="tr-view" role="group" aria-label="Show the conversation as you see it or as the model reads it">
      <button type="button" data-view="you" aria-pressed="false">What you see</button>
      <button type="button" data-view="model" aria-pressed="true">What the model reads</button>
    </div>
    <div class="tr-bar">
      <p class="tr-live" aria-live="polite">Step 1 of 6 · You</p>
      <div class="tr-controls">
        <button type="button" class="tr-back">Back</button>
        <span class="tr-dots">{[1, 2, 3, 4, 5, 6].map((n) => <button type="button" class="tr-dot" data-step={n - 1} aria-label={`Step ${n}`}></button>)}</span>
        <button type="button" class="tr-next">Next</button>
        <button type="button" class="tr-play">Play</button>
      </div>
    </div>
    <div class="tr-stage">
      {LANES.map((l, i) => (
        <>
          {i > 0 && <p class="tr-arrow" data-gap={i - 1} aria-hidden="true"><span class="tr-arrow-l"></span><span class="tr-arrow-r"></span></p>}
          <section class={`tr-lane tr-lane-${l.id}`} data-lane={l.id} aria-label={l.name}>
            <p class="tr-lname"><b>{l.name}</b>{l.sub && <span>{l.sub}</span>}<em class="tr-now">Now</em><i class="tr-mini"></i></p>
            <div class="tr-lbody">
              {l.id === 'you' && (<>
                <p class="tr-bubble"></p>
                <p class="tr-status"><span class="tr-status-text"></span></p>
                <p class="tr-answer"><span class="tr-answer-text"></span></p>
              </>)}
              {l.id === 'model' && (<>
                <p class="tr-mstate"></p>
                <p class="tr-note"><span class="tr-note-tag">note</span><code class="tr-note-text"></code></p>
              </>)}
              {l.id === 'conv' && (<>
                <p class="tr-count"></p>
                <div class="tr-strip">
                  <span class="tr-sweep" aria-hidden="true"><b>rereading from the top</b></span>
                  <div class="tr-line tr-line-hidden" data-only="model">
                    <details><summary><em class="tr-tag tr-tag-hidden">hidden</em> List of tools (tap to read)</summary><span>{toolList}</span></details>
                  </div>
                  <p class="tr-line tr-line-q"><em class="tr-tag">You</em><span class="tr-line-text"></span></p>
                  <p class="tr-line tr-line-note" data-only="model"><em class="tr-tag tr-tag-note">note</em><code class="tr-line-text"></code></p>
                  <p class="tr-line tr-line-status" data-only="you"><em class="tr-tag">status</em><span class="tr-line-text"></span></p>
                  <p class="tr-line tr-line-result" data-only="model"><em class="tr-tag tr-tag-paste">pasted in</em><code class="tr-line-text"></code></p>
                  <p class="tr-line tr-line-answer"><em class="tr-tag tr-tag-model">The model</em><span class="tr-line-text"></span></p>
                </div>
              </>)}
              {l.id === 'program' && (<>
                <p class="tr-pstate"></p>
                <p class="tr-note tr-note-copy"><span class="tr-note-tag">note handed to the tool</span><code class="tr-copy-text"></code></p>
                <div class="tr-job">
                  <p class="tr-job-label">
                    <svg class="tr-ico tr-ico-search" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="M15 15l6 6"/></svg>
                    <svg class="tr-ico tr-ico-code" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6l-6 6 6 6M16 6l6 6-6 6"/></svg>
                    <svg class="tr-ico tr-ico-file" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h8l5 5v15H6z"/><path d="M14 2v5h5"/></svg>
                    <span class="tr-job-text"></span>
                  </p>
                  <span class="tr-fill"><i></i></span>
                  <p class="tr-result"><span class="tr-note-tag tr-result-tag">result</span><code></code></p>
                </div>
              </>)}
              <p class="tr-callout"></p>
            </div>
          </section>
        </>
      ))}
      <svg class="tr-loop" viewBox="0 0 30 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M4 96 C 26 96, 26 4, 4 4" vector-effect="non-scaling-stroke" />
      </svg>
      <span class="tr-loop-head" aria-hidden="true">◀</span>
    </div>
  </div>
  <div class="tr-static">
    <ol class="tr-steps">
      <li><b>You.</b> You ask “{a.chip}” It's added to the conversation.</li>
      <li><b>The model.</b> It reads the whole conversation and guesses text. The text it writes is a note, <code>{a.note}</code>.</li>
      <li><b>The app.</b> The app spots the note and hands it to the tool. The model stops running. You see “{a.status}”</li>
      <li><b>The tool.</b> {a.programLabel}. Ordinary code, no guessing. It gets back <code>{a.result}</code>.</li>
      <li><b>The conversation.</b> The app pastes the result in as plain text.</li>
      <li><b>The model.</b> The app runs it again. It rereads everything from the top and guesses the answer. “{a.answer}”</li>
    </ol>
    <div class="tr-strip tr-strip-static">
      <p class="tr-strip-head">What the model reads</p>
      <p class="tr-line is-in tr-line-hidden"><em class="tr-tag tr-tag-hidden">hidden</em><span>{toolList}</span></p>
      <p class="tr-line is-in"><em class="tr-tag">You</em><span>{a.chip}</span></p>
      <p class="tr-line is-in tr-line-note"><em class="tr-tag tr-tag-note">note</em><code>{a.note}</code></p>
      <p class="tr-line is-in tr-line-result"><em class="tr-tag tr-tag-paste">pasted in</em><code>{a.result}</code></p>
      <p class="tr-line is-in tr-line-answer"><em class="tr-tag tr-tag-model">The model</em><span>{a.answer}</span></p>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  type Q = { chip: string; short: string; note: string; status: string; programLabel: string; icon: string; result: string; answer: string; extra?: string };
  const N = 6;
  const DUR = 2.6; // seconds each step takes to play out
  const GAP = 3.2; // Play moves to the next step this often
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const type = (s: string, u: number) => s.slice(0, Math.round(s.length * clamp(u)));
  const LANE_NAMES: Record<string, string> = { you: 'You', model: 'The model', program: 'The app and its tools', conv: 'The conversation' };
  // Which band acts, its callout, and the arrows between neighboring bands. Gap 0 is You/model,
  // gap 1 is model/conversation, gap 2 is conversation/app. Each arrow says what moves and in which color.
  type Arrow = { side: 'l' | 'r'; text: string; tone: string };
  const STEPS: { lane: string; callout: string; arrows: Record<number, Arrow[]> }[] = [
    { lane: 'you', callout: 'Your question is added to the conversation.', arrows: {} },
    { lane: 'model', callout: 'It’s still just guessing text. This text happens to be a note.', arrows: { 1: [{ side: 'l', text: '↓ note written in', tone: 'note' }] } },
    { lane: 'program', callout: 'The app spots the note and hands it to the tool.', arrows: { 2: [{ side: 'l', text: '↓ note handed to the tool', tone: 'note' }] } },
    { lane: 'program', callout: 'Ordinary code. It doesn’t guess.', arrows: {} },
    { lane: 'conv', callout: 'The app pastes the result in as plain text. To the model it’s just more words.', arrows: { 2: [{ side: 'l', text: '↑ result pasted in', tone: 'paste' }] } },
    { lane: 'model', callout: 'The app runs it again. It starts over and rereads everything.', arrows: { 1: [{ side: 'l', text: '↑ rereads all of it', tone: 'note' }] } },
  ];

  for (const root of document.querySelectorAll<HTMLElement>('.tr')) setup(root);

  function setup(root: HTMLElement) {
    const { questions } = JSON.parse(root.dataset.relay!) as { questions: Q[] };
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll(s)] as T[];
    root.querySelector<HTMLElement>('.tr-ui')!.hidden = false;
    root.querySelector<HTMLElement>('.tr-static')!.hidden = true;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) root.classList.add('tr-still');

    const stage = $('.tr-stage');
    const lanes = Object.fromEntries($$('.tr-lane').map((el) => [el.dataset.lane!, el]));
    const arrows = $$('.tr-arrow');
    const live = $('.tr-live');
    const bubble = $('.tr-bubble'), status = $('.tr-status'), statusText = $('.tr-status-text');
    const answer = $('.tr-answer'), answerText = $('.tr-answer-text');
    const mstate = $('.tr-mstate'), note = $('.tr-note:not(.tr-note-copy)'), noteText = $('.tr-note-text');
    const pstate = $('.tr-pstate'), copy = $('.tr-note-copy'), copyText = $('.tr-copy-text');
    const job = $('.tr-job'), jobText = $('.tr-job-text'), fill = $('.tr-fill i'), result = $('.tr-result'), resultText = $('.tr-result code');
    const count = $('.tr-count');
    const sweep = $('.tr-sweep');
    const loop = $('.tr-loop'), loopHead = $('.tr-loop-head');
    const line = (k: string) => $(`.tr-line-${k}`);
    const lineText = (k: string) => $(`.tr-line-${k} .tr-line-text`);
    const chips = $$<HTMLButtonElement>('.tr-chip'), views = $$<HTMLButtonElement>('.tr-view button');
    const dots = $$<HTMLButtonElement>('.tr-dot');
    const back = $<HTMLButtonElement>('.tr-back'), next = $<HTMLButtonElement>('.tr-next'), play = $<HTMLButtonElement>('.tr-play');
    const mini = (id: string) => lanes[id].querySelector<HTMLElement>('.tr-mini')!;

    let q = 0, view: 'you' | 'model' = 'model', step = 0, prog = reduce ? 1 : 0;

    // The dashed loop arrow runs up the right edge, from the middle of the conversation to the model.
    function placeLoop() {
      const s = stage.getBoundingClientRect();
      const m = lanes.model.getBoundingClientRect(), c = lanes.conv.getBoundingClientRect();
      const top = m.top + m.height / 2 - s.top, bottom = c.top + Math.min(c.height / 2, 60) - s.top;
      loop.style.top = `${top}px`;
      loop.style.height = `${Math.max(20, bottom - top)}px`;
      loopHead.style.top = `${top}px`;
    }

    function render(k: number, p: number) {
      const Qn = questions[q];
      const S = STEPS[k];
      root.dataset.step = String(k + 1);
      live.textContent = `Step ${k + 1} of ${N} · ${LANE_NAMES[S.lane]}`;
      for (const [id, el] of Object.entries(lanes)) {
        el.classList.toggle('is-now', id === S.lane);
        el.classList.toggle('is-also', id === 'you' && k === 2);
        el.classList.toggle('is-ans', id === 'you' && k === 5);
        el.querySelector<HTMLElement>('.tr-callout')!.textContent = id === S.lane ? S.callout : '';
      }
      arrows.forEach((el, i) => {
        const list = S.arrows[i] ?? [];
        const l = el.querySelector<HTMLElement>('.tr-arrow-l')!, r = el.querySelector<HTMLElement>('.tr-arrow-r')!;
        const left = list.find((x) => x.side === 'l'), right = list.find((x) => x.side === 'r');
        l.textContent = left?.text ?? ''; l.dataset.tone = left?.tone ?? '';
        r.textContent = right?.text ?? ''; r.dataset.tone = right?.tone ?? '';
        if (i === 1 && k === 5) { r.textContent = p > 0.9 ? '↺ another note? (next post)' : ''; r.dataset.tone = 'note'; }
        el.classList.toggle('is-on', list.length > 0);
      });

      // You
      bubble.textContent = Qn.chip;
      status.hidden = !(k >= 2 && k <= 4);
      statusText.textContent = Qn.status;
      status.classList.toggle('tr-flag', k === 2);
      answer.hidden = k < 5;
      answerText.textContent = k === 5 ? type(Qn.answer, (p - 0.5) / 0.4) : '';
      mini('you').textContent = k < 2 ? 'asked' : k < 5 ? Qn.status : 'got the answer';

      // The model
      lanes.model.classList.toggle('tr-off', k >= 2 && k <= 4);
      mstate.textContent = k === 0 ? 'Not running yet.'
        : k === 1 ? (p < 0.35 ? 'Reads the whole conversation…' : 'Guesses the next text, one token at a time.')
        : k <= 4 ? 'Not running. Nothing is thinking while it waits.'
        : (p < 0.5 ? 'Run again. Reads it all from the top…' : 'Guesses the answer, one token at a time.');
      note.hidden = k !== 1 || p < 0.35;
      noteText.textContent = type(Qn.note, (p - 0.35) / 0.45);
      mini('model').textContent = k === 0 ? 'not running yet' : k <= 4 && k >= 2 ? 'not running' : '';

      // The app and its tools
      pstate.textContent = k <= 1 ? 'Waiting for a note.' : k === 2 ? 'Spots the note. The model’s turn ends.' : k === 3 ? '' : 'Done. The result is in the conversation.';
      pstate.hidden = k === 3;
      copy.hidden = !(k === 2 || k === 3);
      copyText.textContent = Qn.note;
      job.hidden = k !== 3;
      root.dataset.icon = Qn.icon;
      jobText.textContent = Qn.programLabel;
      fill.style.width = `${100 * clamp(p / 0.6)}%`;
      result.hidden = p < 0.6;
      resultText.textContent = Qn.result;
      if (k === 3 && Qn.extra) lanes.program.querySelector<HTMLElement>('.tr-callout')!.textContent = `${S.callout} ${Qn.extra}`;
      mini('program').textContent = k <= 1 ? 'waiting for a note' : 'done';

      // The conversation
      const has: Record<string, boolean> = {
        hidden: true,
        q: k >= 0,
        note: k > 1 || (k === 1 && p > 0.85),
        status: k >= 2,
        result: k > 4 || (k === 4 && p > 0.15),
        answer: k === 5 && p > 0.5,
      };
      let modelN = 0, youN = 0, hiddenN = 0;
      for (const [id, on] of Object.entries(has)) {
        const el = line(id);
        const only = el.dataset.only;
        el.classList.toggle('is-in', on && (!only || only === view));
        // In "what you see", lines only the model gets stay as thin "hidden from you" ghosts.
        el.classList.toggle('is-ghost', on && only === 'model' && view === 'you');
        if (on && only !== 'you') modelN++;
        if (on && only !== 'model') youN++;
        if (on && only === 'model') hiddenN++;
      }
      count.textContent = view === 'model'
        ? `The model reads all ${modelN} lines`
        : `You see ${youN} lines. ${hiddenN} are hidden from you.`;
      lineText('q').textContent = Qn.chip;
      lineText('note').textContent = Qn.note;
      lineText('status').textContent = Qn.status;
      lineText('result').textContent = Qn.result;
      lineText('answer').textContent = answerText.textContent;
      line('q').classList.toggle('tr-fresh', k === 0);
      line('note').classList.toggle('tr-fresh', k === 1);
      line('note').classList.toggle('tr-spot', k === 2);
      line('result').classList.toggle('tr-fresh', k === 4);
      line('answer').classList.toggle('tr-fresh', k === 5);

      // The sweep: the model reading the conversation from the top (step 2 briefly, step 6 for longer).
      const span = k === 5 ? 0.5 : 0.35;
      const sweeping = (k === 1 || k === 5) && (reduce ? k === 5 : p < span);
      sweep.style.opacity = sweeping ? '1' : '0';
      sweep.style.top = reduce ? '0%' : `${100 * clamp(p / span)}%`;
      sweep.querySelector('b')!.textContent = k === 5 ? 'rereading from the top' : 'reading';
      const looping = k === 5 && p > 0.9;
      loop.classList.toggle('is-in', looping);
      loopHead.classList.toggle('is-in', looping);
      if (looping) placeLoop();

      dots.forEach((d, i) => { d.setAttribute('aria-current', i === k ? 'step' : 'false'); });
      back.disabled = k === 0;
      next.disabled = k === N - 1;
    }

    let raf = 0, t0 = 0;
    function go(k: number, scroll = false) {
      step = Math.max(0, Math.min(N - 1, k));
      cancelAnimationFrame(raf);
      if (scroll) requestAnimationFrame(() => {
        // Keep the band that just lit up in view (on a phone it can be below the fold).
        const lane = lanes[STEPS[step].lane], r = lane.getBoundingClientRect();
        if (r.top < 0 || r.bottom > innerHeight) lane.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      });
      if (reduce) { prog = 1; render(step, 1); return; }
      prog = 0;
      t0 = performance.now();
      const tick = (now: number) => {
        prog = clamp((now - t0) / 1000 / DUR);
        render(step, prog);
        if (prog < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    }

    let timer = 0;
    function stop() { clearInterval(timer); timer = 0; play.textContent = 'Play'; }
    play.hidden = reduce;
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      play.textContent = 'Pause';
      go(step === N - 1 ? 0 : step + 1);
      timer = window.setInterval(() => {
        if (step >= N - 1) { stop(); return; }
        go(step + 1);
      }, GAP * 1000);
    });
    back.addEventListener('click', () => { stop(); go(step - 1, true); });
    next.addEventListener('click', () => { stop(); go(step + 1, true); });
    dots.forEach((d, i) => d.addEventListener('click', () => { stop(); go(i, true); }));
    chips.forEach((c, i) => c.addEventListener('click', () => {
      stop();
      q = i;
      chips.forEach((x, j) => x.setAttribute('aria-pressed', String(j === i)));
      go(0);
    }));
    views.forEach((b) => b.addEventListener('click', () => {
      view = b.dataset.view as 'you' | 'model';
      views.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.dataset.view = view;
      render(step, prog);
    }));
    addEventListener('resize', () => { if (loop.classList.contains('is-in')) placeLoop(); });
    root.dataset.view = view;
    render(0, 1);
  }
</script>

<style is:global>
  .tr { padding: 18px; container-type: inline-size; }
  .tr p { margin: 0; }
  .tr [hidden] { display: none !important; }
  .tr button { font: 600 0.9rem/1.25 Inter, sans-serif; color: var(--text); background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 9px 14px; min-height: 40px; cursor: pointer; }
  .tr button:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .tr button:disabled { opacity: .4; cursor: default; }
  .tr-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  .tr-chips .tr-chip { font-size: 0.95rem; }
  .tr-chips .tr-chip[aria-pressed="true"] { border-color: var(--teal); background: color-mix(in srgb, var(--teal) 14%, var(--card)); }
  .tr-view { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); margin-bottom: 10px; }
  .tr-view button { border: 0; background: none; color: var(--muted); padding: 9px 14px; }
  .tr-view button[aria-pressed="true"] { color: var(--bg); background: var(--grad); }
  .tr-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 12px; margin-bottom: 12px; }
  figure.tr p.tr-live { font: 700 1rem/1.3 "Space Grotesk", sans-serif; color: var(--text); }
  .tr-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .tr-dots { display: flex; gap: 0; }
  .tr .tr-dot { width: 26px; min-height: 32px; height: 32px; padding: 0; border: 0; background: none; position: relative; }
  .tr .tr-dot::after { content: ''; position: absolute; inset: 10px 7px; border-radius: 50%; background: var(--line); }
  .tr .tr-dot[aria-current="step"]::after { background: var(--teal); inset: 8px 5px; }
  .tr-next { border-color: var(--teal) !important; }

  .tr-stage { position: relative; display: grid; gap: 0; padding-right: 30px; }
  .tr-lane { --c: var(--line); position: relative; display: grid; grid-template-columns: 9.5em minmax(0, 1fr); gap: 14px; padding: 14px 14px 14px 16px; border-radius: 14px; border: 1px solid var(--line); border-left: 4px solid transparent; background: var(--bg-2); opacity: 0.55; transition: opacity .25s, border-color .25s; }
  .tr-lane.is-also, .tr-lane.is-ans { opacity: 0.9; }
  .tr-lane.is-now, .tr-lane-conv { opacity: 1; }
  .tr-lane.is-now { border-left-color: var(--c); }
  .tr-lane-you { --c: var(--teal); }
  .tr-lane-model { --c: var(--violet); }
  .tr-lane-program { --c: var(--muted); border-style: dashed; border-width: 1.5px 1.5px 1.5px 4px; border-left-style: solid; }
  .tr-lane-conv { --c: var(--text); background: var(--card); border-width: 2px 2px 2px 4px; }
  figure.tr p.tr-lname { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }
  figure.tr p.tr-lname b { font: 700 1.05rem/1.2 "Space Grotesk", sans-serif; color: var(--c); }
  .tr-lane-program .tr-lname b { color: var(--text); }
  .tr-lane-conv .tr-lname b { color: var(--text); }
  figure.tr p.tr-lname span { font: 600 0.8rem/1.3 Inter, sans-serif; color: var(--muted); }
  .tr-now { display: none; font: 700 0.74rem/1 Inter, sans-serif; font-style: normal; letter-spacing: .08em; text-transform: uppercase; padding: 4px 8px; border-radius: 999px; color: var(--bg); background: var(--c); margin-top: 4px; }
  .tr-lane-program .tr-now, .tr-lane-conv .tr-now { background: var(--text); }
  .tr-lane.is-now .tr-now { display: inline-block; }
