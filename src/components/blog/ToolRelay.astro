---
// The main picture of the tools post: one round trip of a tool request, in six steps. Four bands are
// stacked top to bottom (You, the model, the program, the conversation), and the band that acts in the
// current step is lit, marked NOW, and named in a live line. The reader picks one of three questions
// (web search, running code, reading a file) and steps through with Back and Next, or presses Play. A
// toggle switches the conversation strip between what the person sees and what the model reads (the
// hidden tool list, the note, and the pasted result only exist in the second one).
//
// Drawn as a pure function of (step, progress), so a reel script can record it frame by frame: it sets
// data-reel on the figure and calls window.__toolRelay.draw(seconds). Reduced motion swaps states
// instantly and hides Play. Without JavaScript, an ordered list walks through the first question.
interface Q { chip: string; note: string; status: string; programLabel: string; icon: string; result: string; answer: string; extra?: string }
interface Props { questions: Q[]; toolList: string; caption?: string }
const { questions, toolList, caption } = Astro.props;
const a = questions[0];
const LANES = [
  { id: 'you', name: 'You', sub: '' },
  { id: 'model', name: 'The model', sub: 'guesses text' },
  { id: 'program', name: 'The program', sub: 'ordinary code, no guessing' },
  { id: 'conv', name: 'The conversation', sub: '' },
];
---
<figure class="tr panel bleed" data-relay={JSON.stringify({ questions, toolList })}>
  <p class="tr-reel-top" aria-hidden="true">Can a chatbot really search the web?</p>
  <div class="tr-ui" hidden>
    <div class="tr-chips" role="group" aria-label="Pick a question">
      {questions.map((q, i) => <button type="button" class="tr-chip" data-q={i} aria-pressed={i === 0 ? 'true' : 'false'}>{q.chip}</button>)}
    </div>
    <div class="tr-view" role="group" aria-label="Show the conversation as you see it or as the model reads it">
      <button type="button" data-view="you" aria-pressed="false">What you see</button>
      <button type="button" data-view="model" aria-pressed="true">What the model reads</button>
    </div>
    <p class="tr-live" aria-live="polite">Step 1 of 6 · You</p>
    <div class="tr-stage">
      {LANES.map((l, i) => (
        <>
          {i > 0 && <p class="tr-arrow" data-gap={i - 1} aria-hidden="true"><span></span></p>}
          <section class={`tr-lane tr-lane-${l.id}`} data-lane={l.id} aria-label={l.name}>
            <p class="tr-lname"><b>{l.name}</b>{l.sub && <span>{l.sub}</span>}<em class="tr-now">Now</em></p>
            <div class="tr-lbody">
              {l.id === 'you' && (<>
                <p class="tr-bubble"></p>
                <p class="tr-status"><span class="tr-status-text"></span></p>
                <p class="tr-answer"><span class="tr-answer-text"></span></p>
              </>)}
              {l.id === 'model' && (<>
                <p class="tr-mstate"></p>
                <p class="tr-note"><span class="tr-note-tag">note</span><code class="tr-note-text"></code></p>
              </>)}
              {l.id === 'program' && (<>
                <p class="tr-pstate"></p>
                <div class="tr-job">
                  <p class="tr-job-label">
                    <svg class="tr-ico tr-ico-search" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="M15 15l6 6"/></svg>
                    <svg class="tr-ico tr-ico-code" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6l-6 6 6 6M16 6l6 6-6 6"/></svg>
                    <svg class="tr-ico tr-ico-file" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h8l5 5v15H6z"/><path d="M14 2v5h5"/></svg>
                    <span class="tr-job-text"></span>
                  </p>
                  <span class="tr-fill"><i></i></span>
                  <p class="tr-result"><code></code></p>
                </div>
              </>)}
              {l.id === 'conv' && (
                <div class="tr-strip">
                  <span class="tr-sweep" aria-hidden="true"></span>
                  <p class="tr-line tr-line-hidden" data-only="model"><em class="tr-tag tr-tag-hidden">hidden · you never see this</em><span>{toolList}</span></p>
                  <p class="tr-line tr-line-q"><em class="tr-tag">You</em><span class="tr-line-text"></span></p>
                  <p class="tr-line tr-line-note" data-only="model"><em class="tr-tag tr-tag-note">note</em><code class="tr-line-text"></code></p>
                  <p class="tr-line tr-line-status" data-only="you"><em class="tr-tag">status</em><span class="tr-line-text"></span></p>
                  <p class="tr-line tr-line-result" data-only="model"><em class="tr-tag tr-tag-paste">pasted in</em><code class="tr-line-text"></code></p>
                  <p class="tr-line tr-line-answer"><em class="tr-tag tr-tag-model">The model</em><span class="tr-line-text"></span></p>
                </div>
              )}
              <p class="tr-callout"></p>
            </div>
          </section>
        </>
      ))}
      <p class="tr-loop" aria-hidden="true">↺ What if it writes another note? (next post)</p>
    </div>
    <div class="tr-controls">
      <button type="button" class="tr-back">Back</button>
      <span class="tr-dots">{[1, 2, 3, 4, 5, 6].map((n) => <button type="button" class="tr-dot" data-step={n - 1} aria-label={`Step ${n}`}></button>)}</span>
      <button type="button" class="tr-next">Next</button>
      <button type="button" class="tr-play">Play</button>
    </div>
  </div>
  <div class="tr-static">
    <ol class="tr-steps">
      <li><b>You.</b> You ask “{a.chip}” It goes on the end of the conversation.</li>
      <li><b>The model.</b> It reads the whole conversation and guesses text. The text it writes is a note, <code>{a.note}</code>.</li>
      <li><b>The program.</b> The app spots the note. The model stops running. You see “{a.status}”</li>
      <li><b>The program.</b> {a.programLabel}. Ordinary code, no guessing. It gets back <code>{a.result}</code>.</li>
      <li><b>The conversation.</b> The result is pasted in as plain text.</li>
      <li><b>The model.</b> It's run again, rereads everything from the top, and guesses the answer. “{a.answer}”</li>
    </ol>
    <div class="tr-strip tr-strip-static">
      <p class="tr-strip-head">What the model reads</p>
      <p class="tr-line is-in tr-line-hidden"><em class="tr-tag tr-tag-hidden">hidden · you never see this</em><span>{toolList}</span></p>
      <p class="tr-line is-in"><em class="tr-tag">You</em><span>{a.chip}</span></p>
      <p class="tr-line is-in tr-line-note"><em class="tr-tag tr-tag-note">note</em><code>{a.note}</code></p>
      <p class="tr-line is-in tr-line-result"><em class="tr-tag tr-tag-paste">pasted in</em><code>{a.result}</code></p>
      <p class="tr-line is-in tr-line-answer"><em class="tr-tag tr-tag-model">The model</em><span>{a.answer}</span></p>
    </div>
  </div>
  <p class="tr-reel-end" aria-hidden="true">It never touched the internet. It wrote a note and read the reply.<span>AI, plainly · deanphillips.dev</span></p>
  <p class="tr-reel-tag" aria-hidden="true">Weather made up for the demo</p>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  type Q = { chip: string; note: string; status: string; programLabel: string; icon: string; result: string; answer: string; extra?: string };
  const N = 6;
  const DUR = 2.2; // seconds each step takes to play out
  const GAP = 2.5; // Play moves to the next step this often (it waits for the step to finish first)
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const type = (s: string, u: number) => s.slice(0, Math.round(s.length * clamp(u)));
  const LANE_NAMES: Record<string, string> = { you: 'You', model: 'The model', program: 'The program', conv: 'The conversation' };
  // Which band acts, its callout, and which gaps between bands get an arrow (gap 0 is You/model).
  const STEPS: { lane: string; callout: string; arrows: Record<number, 'down' | 'up'> }[] = [
    { lane: 'you', callout: 'Your question goes on the end of the conversation.', arrows: { 0: 'down', 1: 'down', 2: 'down' } },
    { lane: 'model', callout: 'It’s still just guessing text. This text happens to be a note.', arrows: { 1: 'down', 2: 'down' } },
    { lane: 'program', callout: 'The app spots the note in the model’s text.', arrows: { 2: 'up' } },
    { lane: 'program', callout: 'Ordinary code. It doesn’t guess.', arrows: {} },
    { lane: 'conv', callout: 'Pasted in as plain text. To the model it’s just more words.', arrows: { 2: 'down' } },
    { lane: 'model', callout: 'Starts over and rereads everything.', arrows: { 0: 'up', 1: 'up', 2: 'up' } },
  ];

  for (const root of document.querySelectorAll<HTMLElement>('.tr')) setup(root);

  function setup(root: HTMLElement) {
    const { questions } = JSON.parse(root.dataset.relay!) as { questions: Q[] };
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll(s)] as T[];
    root.querySelector<HTMLElement>('.tr-ui')!.hidden = false;
    root.querySelector<HTMLElement>('.tr-static')!.hidden = true;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) root.classList.add('tr-still');

    const lanes = Object.fromEntries($$('.tr-lane').map((el) => [el.dataset.lane!, el]));
    const arrows = $$('.tr-arrow');
    const live = $('.tr-live');
    const bubble = $('.tr-bubble'), status = $('.tr-status'), statusText = $('.tr-status-text');
    const answer = $('.tr-answer'), answerText = $('.tr-answer-text');
    const mstate = $('.tr-mstate'), note = $('.tr-note'), noteText = $('.tr-note-text');
    const pstate = $('.tr-pstate'), job = $('.tr-job'), jobText = $('.tr-job-text'), fill = $('.tr-fill i'), result = $('.tr-result'), resultText = $('.tr-result code');
    const sweep = $('.tr-sweep'), loop = $('.tr-loop');
    const line = (k: string) => $(`.tr-line-${k}`);
    const lineText = (k: string) => $(`.tr-line-${k} .tr-line-text`);
    const chips = $$<HTMLButtonElement>('.tr-chip'), views = $$<HTMLButtonElement>('.tr-view button');
    const dots = $$<HTMLButtonElement>('.tr-dot');
    const back = $<HTMLButtonElement>('.tr-back'), next = $<HTMLButtonElement>('.tr-next'), play = $<HTMLButtonElement>('.tr-play');

    let q = 0, view: 'you' | 'model' = 'model', step = 0, prog = reduce ? 1 : 0;

    function render(k: number, p: number) {
      const Qn = questions[q];
      const S = STEPS[k];
      root.dataset.step = String(k + 1);
      live.textContent = `Step ${k + 1} of ${N} · ${LANE_NAMES[S.lane]}`;
      for (const [id, el] of Object.entries(lanes)) {
        el.classList.toggle('is-now', id === S.lane);
        el.classList.toggle('is-also', id === 'you' && (k === 2 || k === 5));
        el.querySelector<HTMLElement>('.tr-callout')!.textContent = id === S.lane ? S.callout : '';
      }
      arrows.forEach((el, i) => {
        const d = S.arrows[i];
        el.dataset.dir = d ?? '';
        el.querySelector('span')!.textContent = d === 'down' ? '↓' : d === 'up' ? '↑' : '';
      });

      // You
      bubble.textContent = Qn.chip;
      status.hidden = !(k >= 2 && k <= 4);
      statusText.textContent = Qn.status;
      status.classList.toggle('tr-flag', k === 2);
      answer.hidden = k < 5;
      answerText.textContent = k === 5 ? type(Qn.answer, (p - 0.35) / 0.55) : '';

      // The model
      lanes.model.classList.toggle('tr-off', k >= 2 && k <= 4);
      mstate.textContent = k === 0 ? 'Not running yet.'
        : k === 1 ? (p < 0.35 ? 'Reads the whole conversation…' : 'Guesses the next text, one token at a time.')
        : k <= 4 ? 'Not running. Nothing is thinking while it waits.'
        : (p < 0.35 ? 'Run again. Reads it all from the top…' : 'Guesses the answer, one token at a time.');
      note.hidden = k !== 1 || p < 0.35;
      noteText.textContent = type(Qn.note, (p - 0.35) / 0.45);

      // The program
      pstate.textContent = k <= 1 ? 'Waiting for a note.' : k === 2 ? 'Spots the note. The model’s turn ends.' : k === 3 ? '' : 'Done. Its result is in the conversation.';
      pstate.hidden = k === 3;
      job.hidden = k !== 3;
      root.dataset.icon = Qn.icon;
      jobText.textContent = Qn.programLabel;
      fill.style.width = `${100 * clamp(p / 0.6)}%`;
      result.hidden = p < 0.6;
      resultText.textContent = Qn.result;
      if (k === 3 && Qn.extra) lanes.program.querySelector<HTMLElement>('.tr-callout')!.textContent = `${S.callout} ${Qn.extra}`;

      // The conversation
      const has: Record<string, boolean> = {
        hidden: true,
        q: k >= 0,
        note: k > 1 || (k === 1 && p > 0.85),
        status: k >= 2,
        result: k > 4 || (k === 4 && p > 0.15),
        answer: k === 5 && p > 0.35,
      };
      for (const [id, on] of Object.entries(has)) {
        const el = line(id);
        const only = el.dataset.only;
        el.classList.toggle('is-in', on && (!only || only === view));
      }
      lineText('q').textContent = Qn.chip;
      lineText('note').textContent = Qn.note;
      lineText('status').textContent = Qn.status;
      lineText('result').textContent = Qn.result;
      lineText('answer').textContent = answerText.textContent;
      line('result').classList.toggle('tr-fresh', k === 4);
      line('note').classList.toggle('tr-fresh', k === 1);

      const sweeping = (k === 1 || k === 5) && p < 0.35 && !reduce;
      sweep.style.opacity = sweeping ? '1' : '0';
      sweep.style.top = `${100 * clamp(p / 0.35)}%`;
      loop.classList.toggle('is-in', k === 5 && p > 0.9);

      dots.forEach((d, i) => { d.setAttribute('aria-current', i === k ? 'step' : 'false'); });
      back.disabled = k === 0;
      next.disabled = k === N - 1;
    }

    // The reel: a pure function of time, question a, one step every STEP seconds.
    const STEP = 3.2;
    const total = N * STEP;
    function draw(t: number) {
      const k = Math.min(N - 1, Math.floor(t / STEP));
      render(k, clamp((t - k * STEP) / DUR));
    }
    (window as any).__toolRelay ??= { draw, total, setView: (v: 'you' | 'model') => { view = v; } };

    let raf = 0, t0 = 0;
    function go(k: number) {
      step = Math.max(0, Math.min(N - 1, k));
      cancelAnimationFrame(raf);
      if (reduce || root.dataset.reel) { prog = 1; render(step, 1); return; }
      prog = 0;
      t0 = performance.now();
      const tick = (now: number) => {
        prog = clamp((now - t0) / 1000 / DUR);
        render(step, prog);
        if (prog < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    }

    let timer = 0;
    function stop() { clearInterval(timer); timer = 0; play.textContent = 'Play'; }
    play.hidden = reduce;
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      play.textContent = 'Pause';
      go(step === N - 1 ? 0 : step + 1);
      timer = window.setInterval(() => {
        if (step >= N - 1) { stop(); return; }
        go(step + 1);
      }, GAP * 1000);
    });
    back.addEventListener('click', () => { stop(); go(step - 1); });
    next.addEventListener('click', () => { stop(); go(step + 1); });
    dots.forEach((d, i) => d.addEventListener('click', () => { stop(); go(i); }));
    chips.forEach((c, i) => c.addEventListener('click', () => {
      stop();
      q = i;
      chips.forEach((x, j) => x.setAttribute('aria-pressed', String(j === i)));
      go(0);
    }));
    views.forEach((b) => b.addEventListener('click', () => {
      view = b.dataset.view as 'you' | 'model';
      views.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.dataset.view = view;
      render(step, prog);
    }));
    root.dataset.view = view;
    render(0, 1);
  }
</script>

<style is:global>
  .tr { padding: 18px; container-type: inline-size; }
  .tr p { margin: 0; }
  .tr [hidden] { display: none !important; }
  .tr button { font: 600 0.9rem/1.25 Inter, sans-serif; color: var(--text); background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 9px 14px; min-height: 40px; cursor: pointer; }
  .tr button:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .tr button:disabled { opacity: .4; cursor: default; }
  .tr-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .tr-chips .tr-chip { text-align: left; border-radius: 14px; font-size: 0.95rem; }
  .tr-chips .tr-chip[aria-pressed="true"] { border-color: var(--teal); background: color-mix(in srgb, var(--teal) 14%, var(--card)); }
  .tr-view { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); margin-bottom: 12px; }
  .tr-view button { border: 0; background: none; color: var(--muted); padding: 9px 14px; }
  .tr-view button[aria-pressed="true"] { color: var(--bg); background: var(--grad); }
  figure.tr p.tr-live { font: 600 0.95rem/1.3 Inter, sans-serif; color: var(--muted); margin-bottom: 10px !important; }

  .tr-stage { display: grid; gap: 0; }
  .tr-lane { --c: var(--line); position: relative; display: grid; grid-template-columns: 9.5em minmax(0, 1fr); gap: 14px; padding: 14px 14px 14px 16px; border-radius: 14px; border: 1px solid var(--line); border-left: 4px solid transparent; background: var(--bg-2); opacity: 0.45; transition: opacity .25s, border-color .25s; }
  .tr-lane.is-also { opacity: 0.9; }
  .tr-lane.is-now { opacity: 1; border-left-color: var(--c); }
  .tr-lane-you { --c: var(--teal); }
  .tr-lane-model { --c: var(--violet); }
  .tr-lane-program { --c: var(--muted); border-style: dashed; border-width: 1.5px 1.5px 1.5px 4px; border-left-style: solid; }
  .tr-lane-conv { --c: var(--text); background: var(--card); }
  figure.tr p.tr-lname { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }
  figure.tr p.tr-lname b { font: 700 1.05rem/1.2 "Space Grotesk", sans-serif; color: var(--c); }
  .tr-lane-program .tr-lname b { color: var(--muted); }
  .tr-lane-conv .tr-lname b { color: var(--text); }
  figure.tr p.tr-lname span { font: 600 0.8rem/1.3 Inter, sans-serif; color: var(--muted); }
  .tr-now { display: none; font: 700 0.74rem/1 Inter, sans-serif; font-style: normal; letter-spacing: .08em; text-transform: uppercase; padding: 4px 8px; border-radius: 999px; color: var(--bg); background: var(--c); margin-top: 4px; }
  .tr-lane-program .tr-now { background: var(--muted); }
  .tr-lane.is-now .tr-now { display: inline-block; }
  .tr-lbody { display: grid; gap: 8px; align-content: start; font-size: 1.05rem; line-height: 1.4; min-width: 0; }
  figure.tr p.tr-callout { font: 600 0.88rem/1.35 Inter, sans-serif; color: var(--c); }
  figure.tr .tr-lane-program p.tr-callout { color: var(--text); }
  figure.tr p.tr-callout:empty { display: none; }
  figure.tr p.tr-callout::before { content: '↑ '; }

  figure.tr p.tr-bubble { justify-self: start; padding: 8px 12px; border-radius: 14px 14px 14px 4px; background: color-mix(in srgb, var(--teal) 16%, var(--card)); border: 1px solid color-mix(in srgb, var(--teal) 45%, transparent); font-weight: 600; }
  figure.tr p.tr-status { font: 600 0.95rem/1.3 Inter, sans-serif; color: var(--muted); font-style: italic; }
  figure.tr p.tr-status.tr-flag::after { content: '↑ The only sign you get of the round trip.'; display: block; margin-top: 4px; font-style: normal; font-size: 0.85rem; color: var(--teal); }
  figure.tr p.tr-answer { font: 600 1.1rem/1.4 "Space Grotesk", sans-serif; min-height: 1.4em; }
  figure.tr p.tr-mstate { color: var(--muted); font-size: 0.98rem; }
  figure.tr .tr-off p.tr-mstate { color: var(--text); font-weight: 600; }
  .tr-lane-model.tr-off { background: repeating-linear-gradient(135deg, var(--bg-2) 0 10px, color-mix(in srgb, var(--muted) 10%, var(--bg-2)) 10px 20px); }
  .tr-note, .tr-line-note code, .tr-result { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .tr-note { justify-self: start; position: relative; display: grid; gap: 4px; padding: 8px 26px 10px 12px; background: var(--card); border: 2px solid var(--violet); border-radius: 6px; clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%); max-width: 100%; }
  .tr-note code, .tr-result code, .tr-line code { font: 600 0.98rem/1.35 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: none; border: 0; border-radius: 0; padding: 0; color: var(--text); overflow-wrap: anywhere; }
  .tr-note::after { content: ''; position: absolute; top: 0; right: 0; width: 14px; height: 14px; background: linear-gradient(45deg, var(--violet) 50%, transparent 50%); }
  .tr-note-tag, .tr-tag { font: 700 0.72rem/1 Inter, sans-serif; font-style: normal; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .tr-note-tag { color: var(--violet); }
  .tr-job { display: grid; gap: 8px; }
  .tr-job-label { display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .tr-ico { width: 22px; height: 22px; flex: none; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; display: none; }
  .tr[data-icon="search"] .tr-ico-search, .tr[data-icon="code"] .tr-ico-code, .tr[data-icon="file"] .tr-ico-file { display: block; }
  .tr-fill { display: block; height: 10px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); overflow: hidden; }
  .tr-fill i { display: block; height: 100%; width: 0; background: var(--muted); }
  figure.tr p.tr-result { justify-self: start; padding: 8px 12px; border-radius: 8px; background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--warn); }
  figure.tr p.tr-pstate { color: var(--muted); font-size: 0.98rem; }

  .tr-strip { position: relative; display: grid; gap: 0; padding: 4px 12px; border-radius: 10px; background: var(--bg); border: 1px solid var(--line); overflow: hidden; min-height: 3em; }
  .tr-sweep { position: absolute; left: 0; right: 0; height: 2.6em; margin-top: -1.3em; background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--violet) 30%, transparent), transparent); pointer-events: none; opacity: 0; }
  .tr-line { display: grid; gap: 3px; max-height: 0; opacity: 0; overflow: hidden; padding: 0; border-left: 4px solid transparent; transition: max-height .2s, opacity .2s, padding .2s; }
  .tr-line.is-in { max-height: 14em; opacity: 1; padding: 8px 0 8px 10px; }
