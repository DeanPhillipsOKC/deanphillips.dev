---
// A real model's miss, tied back to part 1's percentage bars. Two still cards for "The sky is ___", drawn
// like DialDemo's bars (rebuilt here with the wms- prefix, not imported). The check marks the right word.
// Card A (a bad guess) gave the right word a low chance (a big miss), card B (a good guess) a high one
// (a small miss). The cards aren't tied to a moment in training, since an untrained model spreads tiny,
// nearly even chances over every token. Made-up
// percentages. Static HTML, no JavaScript, no motion.
interface Card { bars: [string, number][]; tag: string; tone: 'warn' | 'ok'; label?: string }
interface Props { prompt: string; right: string; cards: Card[]; caption?: string }
const { prompt, right, cards, caption } = Astro.props;
---
<figure class="wms panel bleed">
  <p class="wms-head">How a real model's miss is scored</p>
  <div class="wms-grid">
    {cards.map((c, i) => {
      const top = Math.max(...c.bars.map((b) => b[1]));
      return (
        <section class={`wms-card wms-${c.tone}`}>
          <p class="wms-prompt"><span>{c.label ?? (i === 0 ? 'Bad guess' : 'Good guess')}</span>{prompt}</p>
          <ol class="wms-bars">
            {c.bars.map(([w, p]) => (
              <li class={p === top ? 'wms-lead' : ''}>
                <span class="wms-w">{w}{w === right && <b class="wms-check"> ✓</b>}</span>
                <span class="wms-bar"><i style={`width:${p}%`}></i></span>
                <span class="wms-p">{p}%</span>
              </li>
            ))}
          </ol>
          <p class="wms-tag">{c.tag}</p>
        </section>
      );
    })}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .wms p { margin: 0; }
  .wms-head { font: 700 clamp(1.3rem, 5vw, 1.7rem)/1.2 "Space Grotesk", sans-serif; margin-bottom: 12px !important; }
  .wms-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .wms-card { padding: 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); display: grid; gap: 12px; align-content: start; }
  .wms-warn { --wms-c: var(--warn); }
  .wms-ok { --wms-c: var(--ok); }
  .wms-prompt { font: 700 1.15rem/1.3 "Space Grotesk", sans-serif; display: grid; gap: 2px; }
  .wms-prompt span { font: 700 0.72rem/1.3 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  ol.wms-bars { list-style: none; margin: 0 !important; padding: 0 !important; display: grid; gap: 10px; }
  .wms-bars li { margin: 0 !important; display: grid; grid-template-columns: 4.6em 1fr 2.8em; gap: 8px; align-items: center; white-space: nowrap; font: 600 1rem/1.2 "Space Grotesk", sans-serif; }
  .wms-check { color: var(--ok); }
  .wms-bar { height: 14px; border-radius: 999px; background: var(--card); overflow: hidden; }
  .wms-bar i { display: block; height: 100%; border-radius: inherit; background: color-mix(in srgb, var(--muted) 55%, transparent); }
  .wms-bars li.wms-lead .wms-bar i { background: var(--grad); }
  .wms-p { text-align: right; color: var(--muted); font: 600 0.9rem Inter, sans-serif; font-variant-numeric: tabular-nums; }
  .wms-tag { font: 700 1rem/1.35 "Space Grotesk", sans-serif; color: var(--wms-c); padding: 8px 10px; border-radius: 10px; border: 2px solid var(--wms-c); background: color-mix(in srgb, var(--wms-c) 10%, var(--card)); }
  @media (max-width: 620px) { .wms-grid { grid-template-columns: 1fr; } }
</style>
