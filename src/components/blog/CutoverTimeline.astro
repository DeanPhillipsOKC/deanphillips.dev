---
// The day of the move as a vertical timeline. Each event carries one or more status chips (ok,
// broke, fixed), with the word on the chip so the color isn't the only cue. No times: the order
// is the point. Plain HTML and CSS, nothing to switch off.
type Status = 'ok' | 'broke' | 'fixed';
interface Event { title: string; text: string; status: Status[] }
interface Props { date: string; events: Event[]; caption?: string }
const { date, events, caption } = Astro.props;
const WORD: Record<Status, string> = { ok: 'ok', broke: 'broke', fixed: 'fixed' };
---
<figure class="cutover panel bleed">
  <p class="date">{date}</p>
  <ol class="events">
    {events.map((e) => (
      <li class={e.status[e.status.length - 1]}>
        <div class="row">
          <b>{e.title}</b>
          <span class="chips">
            {e.status.map((s) => <em class={s}>{WORD[s]}</em>)}
          </span>
        </div>
        <p>{e.text}</p>
      </li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .cutover { padding: 18px; }
  .date { margin: 0 0 14px; font: 600 0.75rem/1 Inter, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .cutover .events { list-style: none; margin: 0; padding: 0 0 0 26px; position: relative; display: grid; gap: 14px; }
  .events::before { content: ""; position: absolute; left: 7px; top: 10px; bottom: 10px; width: 2px; background: var(--line); border-radius: 1px; }
  .events li { --c: var(--ok); position: relative; margin: 0; padding: 12px 14px; border-radius: 12px; background: var(--bg-2); border: 1px solid var(--line); }
  .events li.broke { --c: var(--warn); border-color: color-mix(in srgb, var(--warn) 55%, var(--line)); }
  .events li.fixed { --c: var(--teal); }
  .events li::before { content: ""; position: absolute; left: -24px; top: 16px; width: 12px; height: 12px; border-radius: 50%; background: var(--c); border: 2px solid var(--card); box-shadow: 0 0 0 2px var(--c), 0 0 10px color-mix(in srgb, var(--c) 60%, transparent); }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 12px; }
  .row b { font: 600 1rem/1.3 "Space Grotesk", sans-serif; color: var(--text); }
  .chips { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .chips em { font: 600 0.66rem/1 Inter, sans-serif; font-style: normal; letter-spacing: .06em; text-transform: uppercase; padding: 4px 8px; border-radius: 999px; border: 1px solid; }
  .chips .ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 55%, transparent); }
  .chips .broke { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 60%, transparent); background: color-mix(in srgb, var(--warn) 12%, transparent); }
  .chips .fixed { color: var(--teal); border-color: color-mix(in srgb, var(--teal) 55%, transparent); }
  .events p { margin: 6px 0 0; font-size: 0.9rem; line-height: 1.45; color: var(--muted); }
  @media (max-width: 560px) { .cutover { padding: 14px; } .cutover .events { padding-left: 22px; } .events li::before { left: -20px; } }
</style>
