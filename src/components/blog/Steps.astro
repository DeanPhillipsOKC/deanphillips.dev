---
// A row of joined steps that stacks on phones. The last step is outlined as the finish.
// The default slot is an optional note under the row (for example, what happens on failure).
interface Props {
  steps: { title: string; text: string }[];
  caption?: string;
}
const { steps, caption } = Astro.props;
---
<figure class="panel">
  <div class="steps" style={`--n: ${steps.length}`}>
    {steps.map((s) => <div><b>{s.title}</b><span set:html={s.text} /></div>)}
  </div>
  {Astro.slots.has('default') && <p class="note"><slot /></p>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .steps { display: grid; grid-template-columns: repeat(var(--n), 1fr); }
  .steps div { padding: 14px 12px; border: 1px solid var(--line); background: var(--bg-2); font-size: 0.85rem; color: var(--muted); line-height: 1.4; }
  .steps div:first-child { border-radius: 14px 0 0 14px; }
  .steps div:last-child { border-radius: 0 14px 14px 0; border-color: color-mix(in srgb, var(--ok) 60%, var(--line)); }
  .steps div + div { border-left: none; }
  .steps b { display: block; color: var(--text); font-family: "Space Grotesk", sans-serif; font-size: 0.98rem; margin-bottom: 2px; }
  .note { margin: 14px 0 0; font-size: 0.85rem; color: var(--muted); }
  .note :global(b) { color: var(--warn); }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; }
    .steps div:first-child { border-radius: 14px 14px 0 0; }
    .steps div:last-child { border-radius: 0 0 14px 14px; }
    .steps div + div { border-left: 1px solid var(--line); border-top: none; }
    .steps div:last-child { border-left-color: color-mix(in srgb, var(--ok) 60%, var(--line)); }
  }
</style>
