---
// Why the total miss multiplies each miss by itself, as a wrong-vs-right pair of stills. Both cards show
// the same two dots, one 3 above a flat teal line and one 3 below, with amber miss lines. Adding the misses
// as they are gives 0 (a pink "wrong" stamp), and multiplying each by itself gives 9 plus 9, so 18 (a green
// "right" stamp). This is the same total miss FitLine and MissHill use. Static SVG and HTML, no motion.
const cards = [
  { title: 'Just add the misses', a: 'up 3', b: 'down 3', sum: '3 plus (minus 3) = 0', stamp: 'Looks perfect. Isn’t.', tone: 'bad', foot: '' },
  { title: 'Multiply each miss by itself', a: '3 × 3 = 9', b: '3 × 3 = 9', sum: '9 plus 9 = 18', stamp: 'Bad, and it says so.', tone: 'good', foot: 'Big misses count extra.' },
];
---
<figure class="msm panel bleed">
  <div class="msm-grid">
    {cards.map((c) => (
      <section class={`msm-card msm-${c.tone}`}>
        <p class="msm-title">{c.title}</p>
        <svg class="msm-pic" viewBox="0 0 260 190" role="img" aria-label={`Two dots, one 3 above the line and one 3 below. ${c.sum}.`}>
          <line class="msm-line" x1="14" y1="95" x2="246" y2="95" />
          <line class="msm-miss" x1="80" y1="95" x2="80" y2="35" />
          <line class="msm-miss" x1="180" y1="95" x2="180" y2="155" />
          <circle class="msm-dot" cx="80" cy="35" r="7" />
          <circle class="msm-dot" cx="180" cy="155" r="7" />
          <text class="msm-lab" x="92" y="70">{c.a}</text>
          <text class="msm-lab" x="168" y="132" text-anchor="end">{c.b}</text>
        </svg>
        <p class="msm-sum">{c.sum}</p>
        <p class="msm-stamp">{c.stamp}</p>
        {c.foot && <p class="msm-foot">{c.foot}</p>}
      </section>
    ))}
  </div>
  <figcaption>The total miss is every miss multiplied by itself, then added up. People call it the loss. Numbers made up.</figcaption>
</figure>

<style is:global>
  .msm p { margin: 0; }
  .msm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .msm-card { padding: 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); display: grid; gap: 8px; align-content: start; justify-items: center; text-align: center; }
  .msm-bad { --msm-c: var(--pink); }
  .msm-good { --msm-c: var(--ok); }
  .msm-title { font: 700 1.15rem/1.25 "Space Grotesk", sans-serif; }
  .msm-pic { width: 100%; max-width: 300px; height: auto; display: block; }
  .msm-line { stroke: var(--teal); stroke-width: 4; stroke-linecap: round; }
  .msm-miss { stroke: var(--warn); stroke-width: 4; stroke-linecap: round; }
  .msm-dot { fill: var(--text); stroke: var(--card); stroke-width: 2; }
  .msm-lab { font: 700 20px "Space Grotesk", sans-serif; fill: var(--warn); }
  .msm-sum { font: 700 1.35rem/1.2 "Space Grotesk", sans-serif; }
  .msm-stamp { display: inline-block; font: 800 1rem/1.2 "Space Grotesk", sans-serif; text-transform: uppercase; letter-spacing: .04em; color: var(--msm-c); border: 3px solid var(--msm-c); border-radius: 8px; padding: 6px 10px; transform: rotate(-3deg); margin: 4px 0 !important; }
  .msm-foot { font-size: 0.92rem; color: var(--muted); }
  @media (max-width: 620px) { .msm-grid { grid-template-columns: 1fr; } }
</style>
