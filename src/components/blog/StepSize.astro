---
// Step size (the learning rate) as three still rows. Each row is the same valley as MissHill (total miss for
// the slope dial, start height held at 1.02), on nearly the same scale, so the start ball (slope 0) sits high
// on the left wall in every row, and a green flag marks the best slope (1.94). The ball's hops are real
// downhill steps worked out here from the bean data (new slope is the old slope minus step size times how
// steep the ground is), starting from slope 0. Only the first and last hops get a number, placed above the
// arc, so digits never pile up. Tiny steps (0.0004) are still about halfway after five hops. Good steps
// (0.0035) wobble and land. Too big (0.0052, three hops) lands higher each time, and the third hop is drawn
// as an arrow leaving the top of the frame with a "flies off" tag inside it, so nothing is cut off at the edge
// (any step above about 0.0049 diverges here). Static SVG, no JavaScript, no motion.
interface Row { name: string; size: number; hops?: number; tag: string; tone: 'teal' | 'pink' }
interface Props { beans: { weeks: number[]; heights: number[] }; start: number; rows: Row[]; caption?: string }
const { beans, start, rows, caption } = Astro.props;
const { weeks, heights } = beans;
const sse = (t: number) => weeks.reduce((s, w, i) => s + (t * w + start - heights[i]) ** 2, 0);
const slope = (t: number) => weeks.reduce((s, w, i) => s + 2 * (t * w + start - heights[i]) * w, 0);
const W = 320, H = 200, L = 14, R = 306, T = 34, B = 172, X0 = -0.7, X1 = 4.6;
const ymax = 1300;
const sx = (t: number) => L + ((t - X0) / (X1 - X0)) * (R - L);
const sy = (v: number) => B - (v / ymax) * (B - T);
const curve = Array.from({ length: 141 }, (_, i) => X0 + (i / 140) * (X1 - X0)).map((t, i) => `${i ? 'L' : 'M'}${sx(t).toFixed(1)} ${sy(sse(t)).toFixed(1)}`).join(' ');
const hops = (size: number, n: number) => { let t = 0; const out = [0]; for (let k = 0; k < n; k++) { t -= size * slope(t); out.push(t); } return out; };
const id = `stz${Math.round(Math.random() * 1e6)}`;
---
<figure class="stz panel bleed">
  <p class="stz-head">Step size <span>(people call it the learning rate)</span></p>
  <ol class="stz-rows">
    {rows.map((r, ri) => {
      const n = r.hops ?? 5;
      const ts = hops(r.size, n);
      const yOf = (t: number) => sy(sse(t)) - 6;
      return (
        <li class={`stz-row stz-${r.tone}`}>
          <p class="stz-name">{r.name}</p>
          <svg class="stz-pic" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${r.name}. ${r.tag}`}>
            <defs>
              <clipPath id={`${id}c${ri}`}><rect x="0" y="0" width={W} height={H} /></clipPath>
              <marker id={`${id}m${ri}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" class="stz-arrow" /></marker>
            </defs>
            <line class="stz-base" x1={L} y1={B} x2={R} y2={B} />
            <path class="stz-hill" d={curve} clip-path={`url(#${id}c${ri})`} />
            <g class="stz-flag" transform={`translate(${sx(1.94)} ${B})`}>
              <line x1="0" y1="0" x2="0" y2="-26" />
              <path d="M0 -26 L18 -21 L0 -16 Z" />
            </g>
            <text class="stz-best" x={sx(1.94)} y={B + 18} text-anchor="middle">best</text>
            {ts.slice(1).map((t, k) => {
              const a = ts[k];
              const x1 = sx(a), y1 = yOf(a);
              if (sse(t) > ymax) {
                // Leaves the top of the frame: an arrow up and out, with a tag inside the frame.
                const x2 = x1 + (sx(t) - x1) * 0.28;
                return <g><path class="stz-hop" d={`M${x1} ${y1} Q${(x1 + x2) / 2} ${y1 - 30} ${x2} 6`} marker-end={`url(#${id}m${ri})`} /><text class="stz-n stz-off" x={x2 + 10} y="20">flies off ↑</text></g>;
              }
              const x2 = sx(t), y2 = yOf(t);
              const top = Math.max(8, Math.min(y1, y2) - 18 - Math.abs(x2 - x1) * 0.12);
              return <path class="stz-hop" d={`M${x1} ${y1} Q${(x1 + x2) / 2} ${top} ${x2} ${y2}`} />;
            })}
            {ts.slice(1).map((t, k) => {
              if (sse(t) > ymax) return null;
              const label = k === 0 || k === n - 1;
              const a = ts[k], x = sx(t), y = yOf(t);
              const top = Math.max(8, Math.min(yOf(a), y) - 18 - Math.abs(x - sx(a)) * 0.12);
              // Hop 1's number sits over its arc. The last hop's number sits over its landing, kept above
              // the flag so it never lands on the dots that pile up at the bottom.
              // In a row that flies off, hop 1's number goes by its landing instead, clear of the "flies off" tag.
              const flies = ts.some((v) => sse(v) > ymax);
              const atLanding = k > 0 || flies;
              const lx = atLanding ? x : (sx(a) + x) / 2, ly = atLanding ? Math.min(y - 12, B - 40) : Math.max(16, top + 4);
              return <g><circle class="stz-land" cx={x} cy={y + 6} r="4.5" />{label && <text class="stz-n" x={lx} y={ly} text-anchor="middle">{k + 1}</text>}</g>;
            })}
            <circle class="stz-ball" cx={sx(0)} cy={yOf(0) + 4} r="7" />
            <text class="stz-st" x={sx(0) - 10} y={yOf(0) + 9} text-anchor="end">start</text>
          </svg>
          <p class="stz-tag">{r.tag}</p>
        </li>
      );
    })}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .stz p { margin: 0; }
  .stz-head { font: 700 1.2rem/1.3 "Space Grotesk", sans-serif; margin-bottom: 12px !important; }
  .stz-head span { color: var(--muted); font-weight: 500; font-size: 1rem; }
  ol.stz-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .stz-row { margin: 0 !important; padding: 12px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); display: grid; grid-template-columns: 9em minmax(0, 1fr); grid-template-areas: "name pic" "tag pic"; gap: 4px 14px; align-items: center; }
  .stz-teal { --stz-c: var(--teal); }
  .stz-pink { --stz-c: var(--pink); }
  .stz-name { grid-area: name; font: 700 1.15rem/1.2 "Space Grotesk", sans-serif; color: var(--stz-c); align-self: end; }
  .stz-tag { grid-area: tag; font: 600 1rem/1.35 Inter, sans-serif; align-self: start; }
  .stz-pic { grid-area: pic; width: 100%; height: auto; display: block; }
  .stz-base { stroke: var(--line); stroke-width: 1.5; }
  .stz-hill { fill: none; stroke: var(--warn); stroke-width: 2.5; opacity: .85; }
  .stz-flag line { stroke: var(--text); stroke-width: 2; }
  .stz-flag path { fill: var(--ok); }
  .stz-best { font: 700 13px "Space Grotesk", sans-serif; fill: var(--ok); }
  .stz-hop { fill: none; stroke: var(--stz-c); stroke-width: 2.5; }
  .stz-arrow { fill: var(--stz-c); }
  .stz-land { fill: var(--stz-c); }
  .stz-ball { fill: var(--violet); stroke: var(--card); stroke-width: 2; }
  .stz-st { font: 700 13px "Space Grotesk", sans-serif; fill: var(--violet); }
  .stz-n { font: 700 16px "Space Grotesk", sans-serif; fill: var(--text); }
  .stz-off { fill: var(--pink); font-size: 15px; }
  @media (max-width: 560px) {
    .stz-row { grid-template-columns: 1fr; grid-template-areas: "name" "pic" "tag"; }
  }
</style>
