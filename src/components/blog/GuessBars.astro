---
// Part 4's opening still: part 1's tiny model mid-guess on "The sky is ___". Three chance bars (worked out
// with the real softmax from the post's made-up starting dials, so it's the same 41% the ladder and the
// receipt use), and an amber tick on each bar where it should have been (100% for the right answer, 0% for
// the others). One idea: the guess, next to what it should have been. Static HTML, no JavaScript.
import { pcts, type Model, type Sentence } from '../../lib/tiny-model';
interface Props { model: Model; sentence: Sentence; caption?: string }
const { model, sentence, caption } = Astro.props;
const pct = pcts(model, sentence.clues);
---
<figure class="gbr panel bleed">
  <div class="gbr-box">
    <p class="gbr-sent">{sentence.text}&nbsp;<b>___</b></p>
    <ol class="gbr-bars">
      {model.answers.map((a, i) => {
        const should = a === sentence.answer ? 100 : 0;
        return (
          <li class={a === sentence.answer ? 'gbr-right' : ''}>
            <span class="gbr-w">{a}{a === sentence.answer && <em> ✓ right</em>}</span>
            <span class="gbr-bar"><i style={`width:${pct[i]}%`}></i><s style={`left:${should}%`}></s></span>
            <span class="gbr-p">{pct[i]}%<small>should be {should}%</small></span>
          </li>
        );
      })}
    </ol>
    <p class="gbr-key"><span class="gbr-k1"></span>its guess <span class="gbr-k2"></span>what it should have been</p>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .gbr p { margin: 0; }
  .gbr-box { max-width: 520px; margin: 0 auto; display: grid; gap: 14px; }
  .gbr-sent { font: 700 1.6rem/1.2 "Space Grotesk", sans-serif; }
  .gbr-sent b { color: var(--teal); }
  .gbr-bars { list-style: none; margin: 0 !important; padding: 0 !important; display: grid; gap: 16px; }
  .gbr-bars li { margin: 0 !important; display: grid; grid-template-columns: 6.2em 1fr 4.6em; gap: 10px; align-items: center; font: 600 1.05rem/1.2 "Space Grotesk", sans-serif; }
  .gbr-w em { font: 700 0.72rem/1 Inter, sans-serif; font-style: normal; color: var(--teal); }
  .gbr-bar { position: relative; height: 16px; border-radius: 999px; background: var(--bg-2); }
  .gbr-bar i { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: color-mix(in srgb, var(--muted) 55%, transparent); }
  .gbr-right .gbr-bar i { background: var(--teal); }
  .gbr-bar s { position: absolute; top: -6px; bottom: -6px; width: 4px; margin-left: -2px; border-radius: 2px; background: var(--warn); }
  .gbr-p { display: grid; text-align: right; font: 700 1.1rem/1.1 Inter, sans-serif; font-variant-numeric: tabular-nums; }
  .gbr-p small { font: 600 0.7rem/1.3 Inter, sans-serif; color: var(--warn); white-space: nowrap; }
  .gbr-key { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font: 600 0.85rem Inter, sans-serif; color: var(--muted); }
  .gbr-key span { display: inline-block; width: 18px; height: 10px; border-radius: 5px; }
  .gbr-k1 { background: var(--teal); }
  .gbr-k2 { width: 4px !important; height: 16px !important; border-radius: 2px !important; background: var(--warn); margin-left: 8px; }
</style>
