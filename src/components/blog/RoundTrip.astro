---
// One tool round trip as a numbered strip you read top to bottom, like a comic. One example only (a
// weather question), one idea per step, and a "you never see this" tag on the steps that happen out of
// sight. Step 4 shows the whole conversation the model rereads. No controls: it reads the same with or
// without JavaScript. The steps fade in one at a time when it scrolls into view, unless the reader
// prefers less motion. A last row shows that other tools make the same trip with a different note.
interface Props {
  question: string; note: string; tool: string; result: string; answer: string; toolList: string;
  others?: { label: string; note: string }[]; caption?: string;
}
const { question, note, tool, result, answer, toolList, others = [], caption } = Astro.props;
---
<figure class="rt panel bleed">
  <ol class="rt-steps">
    <li class="rt-you" style="--i:0">
      <span class="rt-n">1</span>
      <div class="rt-body">
        <p class="rt-h">You ask.</p>
        <p class="rt-bubble rt-ask">{question}</p>
      </div>
    </li>
    <li class="rt-model rt-hidden" style="--i:1">
      <span class="rt-n">2</span>
      <div class="rt-body">
        <p class="rt-h">The model writes a note instead of an answer. Then it stops.</p>
        <p class="rt-note"><span class="rt-tag">Note</span><code>{note}</code></p>
        <p class="rt-unseen">You never see this</p>
      </div>
    </li>
    <li class="rt-app rt-hidden" style="--i:2">
      <span class="rt-n">3</span>
      <div class="rt-body">
        <p class="rt-h">The app spots the note. A tool does the errand.</p>
        <p class="rt-tool"><span class="rt-tag">Tool</span>{tool}</p>
        <p class="rt-arrow" aria-hidden="true">↓</p>
        <p class="rt-result"><span class="rt-tag">Result</span>{result}</p>
        <p class="rt-unseen">You never see this</p>
      </div>
    </li>
    <li class="rt-conv rt-hidden" style="--i:3">
      <span class="rt-n">4</span>
      <div class="rt-body">
        <p class="rt-h">The result gets pasted into the conversation.</p>
        <div class="rt-stack">
          <p class="rt-line rt-dim"><span class="rt-tag">Hidden</span>{toolList}</p>
          <p class="rt-line"><span class="rt-tag">You</span>{question}</p>
          <p class="rt-line"><span class="rt-tag">Note</span><code>{note}</code></p>
          <p class="rt-line rt-new"><span class="rt-tag">Result</span>{result}</p>
        </div>
        <p class="rt-unseen">You never see this</p>
      </div>
    </li>
    <li class="rt-model" style="--i:4">
      <span class="rt-n">5</span>
      <div class="rt-body">
        <p class="rt-h">The model runs again. It rereads all of it, top to bottom, and answers.</p>
        <p class="rt-bubble rt-ans">{answer}</p>
      </div>
    </li>
  </ol>
  {others.length > 0 && (
    <div class="rt-others">
      <p class="rt-h">Every tool makes the same trip. Only the note changes.</p>
      <ul>{others.map((o) => <li><b>{o.label}</b><code>{o.note}</code></li>)}</ul>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.rt')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    root.classList.add('rt-ready');
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { root.classList.add('rt-go'); io.disconnect(); } }, { threshold: 0.15 });
    io.observe(root);
  }
</script>

<style is:global>
  .rt p { margin: 0; }
  .rt-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .rt-steps > li { display: grid; grid-template-columns: 40px 1fr; gap: 12px; align-items: start; padding: 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); border-left: 4px solid var(--c, var(--line)); }
  .rt-you { --c: var(--teal); }
  .rt-model { --c: var(--violet); }
  .rt-app { --c: var(--warn); }
  .rt-conv { --c: var(--muted); }
  .rt-hidden { border-style: dashed; border-left-style: solid; }
  .rt-n { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font: 700 1.1rem/1 "Space Grotesk", sans-serif; background: color-mix(in srgb, var(--c) 22%, var(--card)); color: var(--text); }
  .rt-body { display: grid; gap: 10px; min-width: 0; }
  .rt-h { font: 700 1.05rem/1.35 "Space Grotesk", sans-serif; }
  .rt-bubble { padding: 10px 14px; border-radius: 14px; font-size: 1rem; line-height: 1.4; max-width: 34em; }
  .rt-ask { background: color-mix(in srgb, var(--teal) 16%, var(--card)); border: 1px solid color-mix(in srgb, var(--teal) 50%, transparent); }
  .rt-ans { background: color-mix(in srgb, var(--violet) 16%, var(--card)); border: 1px solid color-mix(in srgb, var(--violet) 50%, transparent); }
  .rt-tag { display: inline-block; margin-right: 8px; padding: 2px 7px; border-radius: 6px; font: 700 0.68rem/1.4 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; background: var(--card); border: 1px solid var(--line); color: var(--muted); vertical-align: 1px; }
  .rt code { font: 600 0.95rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; overflow-wrap: anywhere; }
  .rt-note, .rt-tool, .rt-result { padding: 10px 12px; border-radius: 10px; background: var(--card); border: 1px solid var(--line); font-size: 0.98rem; line-height: 1.4; }
  .rt-note { border-color: color-mix(in srgb, var(--violet) 55%, transparent); }
  .rt-result { border-color: color-mix(in srgb, var(--warn) 60%, transparent); }
  .rt-arrow { color: var(--muted); font-size: 1.2rem; line-height: 1; padding-left: 14px; }
  .rt-stack { display: grid; gap: 6px; padding: 10px; border-radius: 10px; background: var(--card); border: 1px solid var(--line); }
  .rt-line { font-size: 0.95rem; line-height: 1.4; padding: 6px 8px; border-radius: 8px; }
  .rt-dim { color: var(--muted); font-size: 0.85rem; }
  .rt-new { background: color-mix(in srgb, var(--warn) 14%, transparent); outline: 1px solid color-mix(in srgb, var(--warn) 55%, transparent); }
  .rt-unseen { font: 600 0.78rem/1 Inter, sans-serif; color: var(--muted); }
  .rt-unseen::before { content: '◌ '; }
  .rt-others { margin-top: 14px; display: grid; gap: 10px; }
  .rt-others ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .rt-others li { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; padding: 10px 12px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); }
  .rt-others b { font: 700 0.95rem/1.3 "Space Grotesk", sans-serif; min-width: 7em; }
  .rt-ready .rt-steps > li { opacity: 0; transform: translateY(10px); }
  .rt-go .rt-steps > li { opacity: 1; transform: none; transition: opacity .5s ease, transform .5s ease; transition-delay: calc(var(--i) * .45s); }
  @media (max-width: 560px) {
    .rt-steps > li { grid-template-columns: 30px 1fr; gap: 10px; padding: 12px; }
    .rt-line .rt-tag { display: table; margin-bottom: 4px; }
    .rt-n { width: 30px; height: 30px; font-size: 0.95rem; }
  }
</style>
