---
// Retrieval, drawn the same plain way as the word map from the inference post (a separate file, since
// that one belongs to part 0). A pretend help center and recipe box are chopped into short passages,
// and each passage gets a spot on a map where similar meanings sit close. When the map scrolls into
// view, the passages glide out of their documents to their spots ("filing"). The reader picks a
// question, sees the search note the model writes, guesses which passage sits closest, and then a pin
// drops where the note lands, lines go to the three nearest passages (worked out from the positions,
// not hard-coded), and those three get pasted into the conversation. One question is a failure case,
// where the nearest pages are the wrong ones. Tap any passage to see its stored text.
//
// Every position and passage is made up, and the caption says so. Reduced motion skips the glide and
// the drop. Without JavaScript the map shows in place, with the first question's three nearest below.
interface Passage { label: string; group: string; x: number; y: number; text: string }
interface Query { chip: string; note: string; x: number; y: number; callout?: { label: string; text: string }; warn?: string; answer?: string; answerTag?: string }
interface Group { id: string; label: string; x: number; y: number }
interface Props { passages: Passage[]; queries: Query[]; groups: Group[]; caption?: string }
const { passages, queries, groups, caption } = Astro.props;
const nearest = (q: Query) => passages.map((p) => ({ p, d: Math.hypot(p.x - q.x, p.y - q.y) })).sort((a, b) => a.d - b.d).slice(0, 3).map((n) => n.p);
const first = queries[0];
const firstNear = nearest(first);
---
<figure class="sm panel bleed" data-map={JSON.stringify({ passages, queries })}>
  <div class="sm-keep">
    <p class="sm-keep-model">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 12l4-5"/></svg>
      <span><b>The model</b> keeps the dials. No pages.</span>
    </p>
    <p class="sm-keep-tool">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h9l5 5v13H5z"/><path d="M14 3v5h5M8 13h8M8 17h6"/></svg>
      <span><b>The search tool</b> keeps every passage, word for word, filed under its spot.</span>
    </p>
  </div>

  <div class="sm-chips" role="group" aria-label="Pick a question" hidden>
    {queries.map((q, i) => <button type="button" class="sm-chip" data-q={i} aria-pressed="false">{q.chip}</button>)}
  </div>
  <p class="sm-note-row" hidden><span class="sm-who">The model writes</span><span class="sm-note"><em>note</em><code></code></span></p>
  <div class="sm-ask" hidden>
    <p><b>Guess first.</b> Tap the passage you think sits closest to the note.</p>
    <button type="button" class="sm-show">Just show me</button>
  </div>

  <div class="sm-map">
    <svg class="sm-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"></svg>
    <p class="sm-doc sm-doc-help" aria-hidden="true"><span></span>help-center.pdf</p>
    <p class="sm-doc sm-doc-recipe" aria-hidden="true"><span></span>recipes.doc</p>
    {groups.map((g) => <p class={`sm-group sm-group-${g.id}`} style={`left:${g.x}%;top:${g.y}%`}>{g.label}</p>)}
    {passages.map((p) => (
      <button type="button" class={`sm-p sm-p-${p.group}`} data-label={p.label} data-x={p.x} data-y={p.y} style={`left:${p.x}%;top:${p.y}%`}>{p.label}</button>
    ))}
    <span class="sm-pin" hidden aria-hidden="true"><i></i></span>
  </div>
  <p class="sm-legend" hidden><span class="sm-legend-pin"></span> where your search note lands <span class="sm-legend-n">1</span><span class="sm-legend-n">2</span><span class="sm-legend-n">3</span> the three closest passages</p>
  <p class="sm-tip" aria-live="polite" hidden></p>
  <p class="sm-result" aria-live="polite" hidden></p>

  <div class="sm-out">
    <p class="sm-out-head">Pasted into the conversation</p>
    <p class="sm-out-sub">For “{first.chip}” the note <code>{first.note}</code> lands nearest these three.</p>
    <p class="sm-warn" hidden></p>
    <ol class="sm-picks">
      {firstNear.map((p) => (
        <li><em>pasted in</em><b>{p.label}</b><span>“{p.text}”</span></li>
      ))}
    </ol>
    <p class="sm-then">Then the model guesses an answer, reading these.</p>
    <p class="sm-answer" hidden><span class="sm-answer-text"></span><em class="sm-answer-tag"></em></p>
  </div>
  <button type="button" class="sm-again" hidden>Watch it file the pages again</button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  type Passage = { label: string; group: string; x: number; y: number; text: string };
  type Query = { chip: string; note: string; x: number; y: number; callout?: { label: string; text: string }; warn?: string; answer?: string; answerTag?: string };
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
  const DOC: Record<string, [number, number]> = { help: [25, 50], recipe: [75, 50] };

  for (const root of document.querySelectorAll<HTMLElement>('.sm')) {
    const { passages, queries } = JSON.parse(root.dataset.map!) as { passages: Passage[]; queries: Query[] };
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const map = $('.sm-map'), svg = root.querySelector<SVGSVGElement>('.sm-lines')!;
    const chipsBox = $('.sm-chips'), chips = [...root.querySelectorAll<HTMLButtonElement>('.sm-chip')];
    const noteRow = $('.sm-note-row'), noteCode = $('.sm-note code');
    const ask = $('.sm-ask'), show = $<HTMLButtonElement>('.sm-show');
    const legend = $('.sm-legend');
    const tip = $('.sm-tip'), res = $('.sm-result'), pin = $('.sm-pin');
    const out = $('.sm-out'), sub = $('.sm-out-sub'), warn = $('.sm-warn'), picks = $('.sm-picks');
    const ans = $('.sm-answer'), ansText = $('.sm-answer-text'), ansTag = $('.sm-answer-tag');
    const again = $<HTMLButtonElement>('.sm-again');
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.sm-p')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) root.classList.add('sm-still');
    const byLabel = new Map(passages.map((p) => [p.label, p]));

    let current = -1;
    let guessing = false;

    // Start from a clean board: the static answer below the map is only for readers without JavaScript.
    chipsBox.hidden = false;
    out.hidden = true;

    function nearest(q: Query) {
      return passages.map((p) => ({ p, d: Math.hypot(p.x - q.x, p.y - q.y) })).sort((a, b) => a.d - b.d).slice(0, 3).map((n) => n.p);
    }

    function clearMarks() {
      svg.replaceChildren();
      pin.hidden = true;
      legend.hidden = true;
      for (const b of btns) { b.classList.remove('is-near', 'is-guess', 'is-dim'); delete b.dataset.rank; }
      res.hidden = true;
      out.hidden = true;
    }

    function pick(i: number) {
      current = i;
      const q = queries[i];
      chips.forEach((c, j) => c.setAttribute('aria-pressed', String(j === i)));
      clearMarks();
      tip.hidden = true;
      noteRow.hidden = false;
      noteCode.textContent = q.note;
      ask.hidden = false;
      guessing = true;
      map.classList.add('sm-guessing');
    }

    function reveal(guess?: string) {
      const q = queries[current];
      guessing = false;
      ask.hidden = true;
      map.classList.remove('sm-guessing');
      const nn = nearest(q);
      pin.hidden = false;
      legend.hidden = false;
      pin.style.left = `${q.x}%`;
      pin.style.top = `${q.y}%`;
      pin.classList.remove('sm-drop'); void pin.offsetWidth; pin.classList.add('sm-drop');
      svg.replaceChildren();
      nn.forEach((p, i) => {
        const l = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        l.setAttribute('x1', String(q.x)); l.setAttribute('y1', String(q.y));
        l.setAttribute('x2', String(p.x)); l.setAttribute('y2', String(p.y));
        l.setAttribute('vector-effect', 'non-scaling-stroke');
        l.style.animationDelay = `${0.35 + i * 0.2}s`;
        svg.append(l);
      });
      for (const b of btns) {
        const r = nn.findIndex((p) => p.label === b.dataset.label);
        b.classList.toggle('is-near', r >= 0);
        b.classList.toggle('is-dim', r < 0);
        if (r >= 0) b.dataset.rank = String(r + 1);
        b.classList.toggle('is-guess', b.dataset.label === guess);
      }
      if (guess) {
        const r = nn.findIndex((p) => p.label === guess);
        res.hidden = false;
        res.textContent = r >= 0 ? `You picked #${r + 1} of the three closest.` : 'Not in the top three. The numbers show the three closest.';
        res.classList.toggle('sm-hit', r >= 0);
      }
      sub.textContent = `The three passages nearest the note get pasted in, word for word.`;
      warn.hidden = !q.warn;
      warn.textContent = q.warn ?? '';
      picks.replaceChildren();
      nn.forEach((p, i) => {
        const li = document.createElement('li');
        li.innerHTML = '<em>pasted in</em><b></b><span></span>';
        li.querySelector('b')!.textContent = `${i + 1}. ${p.label}`;
        li.querySelector('span')!.textContent = `“${p.text}”`;
        if (q.callout && q.callout.label === p.label) {
          const c = document.createElement('strong');
          c.className = 'sm-call';
          c.textContent = q.callout.text;
          li.append(c);
        }
        li.style.animationDelay = `${0.9 + i * 0.15}s`;
        picks.append(li);
      });
      ans.hidden = !q.answer;
      ansText.textContent = q.answer ?? '';
      ansTag.textContent = q.answerTag ?? '';
      out.hidden = false;
      out.classList.toggle('sm-bad', !!q.warn);
    }

    for (const b of btns) b.addEventListener('click', () => {
      const p = byLabel.get(b.dataset.label!)!;
      if (guessing) { reveal(p.label); return; }
      tip.hidden = false;
      tip.innerHTML = '<em>stored word for word</em><b></b> <span></span>';
      tip.querySelector('b')!.textContent = p.label;
      tip.querySelector('span')!.textContent = `“${p.text}”`;
    });
    chips.forEach((c, i) => c.addEventListener('click', () => pick(i)));
    show.addEventListener('click', () => reveal());

    // Filing: every passage starts inside its document and glides out to its spot.
    function file() {
      clearMarks();
      map.classList.add('sm-filing');
      const t0 = performance.now(), dur = 1200;
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        btns.forEach((b, i) => {
          const p = byLabel.get(b.dataset.label!)!;
          const [fx, fy] = DOC[p.group];
          const k = ease(Math.max(0, Math.min(1, t * 1.3 - (i % 6) * 0.05)));
          b.style.left = `${fx + (p.x - fx) * k}%`;
          b.style.top = `${fy + (p.y - fy) * k}%`;
          b.style.opacity = String(Math.min(1, k * 3));
        });
        if (t < 1) requestAnimationFrame(step);
        else {
          map.classList.remove('sm-filing');
          btns.forEach((b) => { b.style.opacity = ''; });
          if (current >= 0 && !guessing) reveal();
        }
      };
      requestAnimationFrame(step);
    }
    if (reduce) continue;
    again.hidden = false;
    again.addEventListener('click', file);
    map.classList.add('sm-wait');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      map.classList.remove('sm-wait');
      file();
    }, { threshold: 0.4 });
    io.observe(map);
  }
</script>

<style is:global>
  .sm { padding: 16px; }
  .sm p { margin: 0; }
  .sm [hidden] { display: none !important; }
  .sm button { font: 600 0.9rem/1.25 Inter, sans-serif; color: var(--text); background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 9px 14px; min-height: 40px; cursor: pointer; }
  .sm button:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .sm code { font: 600 0.95rem/1.35 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: none; border: 0; border-radius: 0; padding: 0; color: var(--text); overflow-wrap: anywhere; }

  figure.sm .sm-keep { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
  figure.sm .sm-keep p { display: flex; gap: 10px; align-items: flex-start; padding: 12px; border-radius: 12px; font-size: 1rem; line-height: 1.4; }
  figure.sm .sm-keep svg { width: 26px; height: 26px; flex: none; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sm-keep-model { background: color-mix(in srgb, var(--violet) 12%, var(--card)); border: 1px solid color-mix(in srgb, var(--violet) 45%, transparent); }
  .sm-keep-model svg { stroke: var(--violet); }
  .sm-keep-tool { background: var(--bg-2); border: 1.5px dashed var(--line); }
  .sm-keep-tool svg { stroke: var(--muted); }

  .sm-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .sm-chips .sm-chip { border-radius: 14px; text-align: left; font-size: 0.95rem; }
  .sm-chips .sm-chip[aria-pressed="true"] { border-color: var(--teal); background: color-mix(in srgb, var(--teal) 14%, var(--card)); }
  figure.sm p.sm-note-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-bottom: 10px !important; }
  .sm-who { font: 700 0.8rem/1 Inter, sans-serif; text-transform: uppercase; letter-spacing: .06em; color: var(--violet); }
  .sm-note { display: inline-grid; gap: 3px; padding: 7px 24px 8px 11px; background: var(--card); border: 2px solid var(--violet); border-radius: 6px; clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%); }
  .sm-note { position: relative; }
  .sm-note::after { content: ''; position: absolute; top: 0; right: 0; width: 12px; height: 12px; background: linear-gradient(45deg, var(--violet) 50%, transparent 50%); }
  .sm-note em, .sm-picks em, .sm-tip em { font: 700 0.72rem/1 Inter, sans-serif; font-style: normal; text-transform: uppercase; letter-spacing: .06em; color: var(--violet); }
  .sm .sm-ask { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 10px; font-size: 1.05rem; }

  .sm-map { position: relative; aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; background:
    radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--muted) 30%, transparent) 1px, transparent 0) 0 0 / 22px 22px, var(--bg-2); }
  .sm-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sm-lines line { stroke: var(--violet); stroke-width: 2.5; stroke-dasharray: 5 4; }
  .sm .sm-p { position: absolute; transform: translate(-50%, -50%); width: max-content; max-width: 30%; padding: 5px 9px; min-height: 0; border-radius: 10px; font: 600 0.88rem/1.15 "Space Grotesk", sans-serif; text-align: center; background: color-mix(in srgb, var(--c) 14%, var(--card)); border: 1px solid color-mix(in srgb, var(--c) 55%, transparent); transition: opacity .3s, box-shadow .2s; z-index: 1; }
  .sm-p-help { --c: var(--teal); }
  .sm-p-recipe { --c: var(--warn); }
  .sm-guessing .sm-p:hover { box-shadow: 0 0 0 2px var(--violet); }
  .sm .sm-p.is-dim { opacity: 0.4; }
  .sm .sm-p.is-near { box-shadow: 0 0 0 2px var(--violet); z-index: 3; }
  .sm .sm-p[data-rank]::after { content: attr(data-rank); position: absolute; top: -9px; right: -9px; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font: 700 0.75rem/1 Inter, sans-serif; color: var(--bg); background: var(--violet); }
  .sm .sm-p.is-guess { outline: 2px dashed var(--text); outline-offset: 3px; }
  figure.sm p.sm-group { position: absolute; transform: translate(-50%, -50%); font: 700 0.8rem/1.1 Inter, sans-serif; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); text-align: center; white-space: nowrap; }
  figure.sm p.sm-group::before { content: ''; display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; vertical-align: 0; }
  .sm-group-help::before { background: var(--teal); }
  .sm-group-recipe::before { background: var(--warn); }
  figure.sm p.sm-doc { position: absolute; top: 50%; transform: translate(-50%, -50%); display: grid; justify-items: center; gap: 6px; font: 600 0.82rem/1 ui-monospace, Menlo, monospace; color: var(--muted); opacity: 0; transition: opacity .4s; z-index: 0; }
  figure.sm p.sm-doc span { width: 46px; height: 58px; border-radius: 4px; background: var(--card); border: 1.5px solid var(--line); box-shadow: 5px 5px 0 -1px var(--card), 5px 5px 0 0 var(--line), 10px 10px 0 -1px var(--card), 10px 10px 0 0 var(--line); }
  .sm-doc-help { left: 25%; }
  .sm-doc-recipe { left: 75%; }
  figure.sm .sm-filing p.sm-doc { opacity: 1; }
  figure.sm .sm-filing p.sm-group { opacity: 0; }
  figure.sm .sm-wait .sm-p, figure.sm .sm-wait p.sm-group { opacity: 0; }
  figure.sm .sm-wait p.sm-doc { opacity: 1; }
  .sm-pin { position: absolute; transform: translate(-50%, -50%); z-index: 4; display: grid; justify-items: center; pointer-events: none; }
  .sm-pin i { width: 18px; height: 18px; border-radius: 50%; border: 4px solid var(--violet); background: color-mix(in srgb, var(--violet) 25%, var(--card)); }
  figure.sm p.sm-legend { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font: 600 0.85rem/1.3 Inter, sans-serif; color: var(--muted); }
  .sm-legend-pin { width: 16px; height: 16px; border-radius: 50%; border: 3px solid var(--violet); }
  .sm-legend-n { width: 20px; height: 20px; border-radius: 50%; display: inline-grid; place-items: center; font: 700 0.8rem/1 Inter, sans-serif; color: var(--bg); background: var(--violet); }
  .sm-pin b { position: absolute; top: 100%; margin-top: 2px; font: 700 0.8rem/1 Inter, sans-serif; color: var(--bg); background: var(--violet); padding: 3px 6px; border-radius: 6px; white-space: nowrap; }

  figure.sm p.sm-tip, .sm-result { margin-top: 10px !important; padding: 10px 12px; border-radius: 10px; background: var(--card); border: 1px solid var(--line); font-size: 1rem; line-height: 1.4; }
  figure.sm p.sm-tip { display: grid; gap: 4px; }
  figure.sm p.sm-tip em { color: var(--muted); }
  figure.sm p.sm-result { border-color: var(--line); font-weight: 600; }
  figure.sm p.sm-result.sm-hit { border-color: var(--ok); }

  .sm-out { margin-top: 14px; padding: 14px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); display: grid; gap: 10px; }
  figure.sm p.sm-out-head { font: 700 1.05rem/1.2 "Space Grotesk", sans-serif; }
  figure.sm p.sm-out-sub { color: var(--muted); font-size: 0.95rem; }
  figure.sm p.sm-warn { padding: 8px 12px; border-radius: 8px; font-weight: 600; color: var(--text); background: color-mix(in srgb, var(--warn) 18%, var(--card)); border: 1px solid var(--warn); }
  figure.sm p.sm-warn::before { content: '⚠ '; color: var(--warn); }
  .sm .sm-picks { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sm-picks li { margin: 0; display: grid; gap: 3px; padding: 8px 12px; border-left: 4px solid var(--warn); background: var(--bg-2); border-radius: 0 8px 8px 0; font-size: 1rem; line-height: 1.4; }
  .sm-picks em { color: var(--warn); }
  .sm-picks b { font-family: "Space Grotesk", sans-serif; }
  .sm-picks span { color: var(--muted); }
  .sm-call { font: 600 0.88rem/1.35 Inter, sans-serif; color: var(--violet); }
  .sm-call::before { content: '↑ '; }
  figure.sm p.sm-then { font-weight: 600; }
  figure.sm p.sm-answer { display: grid; gap: 6px; justify-items: start; }
  .sm-answer-text { padding: 8px 12px; border-radius: 14px 14px 14px 4px; background: color-mix(in srgb, var(--violet) 14%, var(--card)); border: 1px solid color-mix(in srgb, var(--violet) 45%, transparent); font: 600 1.05rem/1.35 "Space Grotesk", sans-serif; }
  .sm-answer-tag { font: 700 0.85rem/1.3 Inter, sans-serif; font-style: normal; color: var(--pink); }
  .sm-answer-tag::before { content: '✗ '; }
  .sm-again { margin-top: 12px; }

  @media (prefers-reduced-motion: no-preference) {
    .sm-pin.sm-drop { animation: sm-drop .45s cubic-bezier(.3, 1.4, .6, 1) both; }
    .sm-lines line { animation: sm-fade .3s both; }
    .sm-picks li { animation: sm-slide .35s ease-out both; }
  }
  @keyframes sm-drop { from { transform: translate(-50%, -160%); opacity: 0; } }
  @keyframes sm-fade { from { opacity: 0; } }
  @keyframes sm-slide { from { opacity: 0; transform: translateY(10px); } }

  @media (max-width: 560px) {
    .sm { padding: 12px; }
    figure.sm .sm-keep { grid-template-columns: 1fr; }
    .sm-map { aspect-ratio: 3 / 4; }
    .sm .sm-p { font-size: 0.8rem; padding: 4px 6px; max-width: 31%; }
    figure.sm p.sm-group { white-space: normal; max-width: 30%; }
  }
</style>
