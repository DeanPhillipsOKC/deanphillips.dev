---
// A text-message style thread between an agent and me, with centered system events between
// bubbles. `text` may contain inline HTML (<b>, <code>, <br>). Options render as lettered lines.
interface Message {
  from: 'bot' | 'me' | 'email' | 'event';
  text: string;
  name?: string;
  time?: string;
  options?: string[];
  quote?: string;
}
interface Props {
  title: string;
  subtitle?: string;
  messages: Message[];
  caption?: string;
}
const { title, subtitle, messages, caption } = Astro.props;
---
<figure class="panel">
  <div class="thread">
    <header>
      <span class="avatar bot" aria-hidden="true">
        <svg viewBox="0 0 32 32"><path d="M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="3" r="2" fill="currentColor"/><rect x="6" y="8" width="20" height="17" rx="6" fill="currentColor"/><circle cx="12" cy="16" r="2.4" fill="var(--bg-2)"/><circle cx="20" cy="16" r="2.4" fill="var(--bg-2)"/><path d="M12.5 21h7" stroke="var(--bg-2)" stroke-width="1.8" stroke-linecap="round"/><path d="M4 15v4M28 15v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </span>
      <span><b>{title}</b>{subtitle && <small>{subtitle}</small>}</span>
    </header>
    <ol>
      {messages.map((m) => m.from === 'event' ? (
        <li class="event"><span set:html={m.text} /></li>
      ) : m.from === 'email' ? (
        <li class="row">
          <span class="avatar mail" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </span>
          <div class="bubble email">
            <span class="who">{m.name ?? 'Support email'}{m.time && <time>{m.time}</time>}</span>
            <span set:html={m.text} />
          </div>
        </li>
      ) : (
        <li class:list={['row', m.from]}>
          {m.from === 'bot' ? (
            <span class="avatar bot" aria-hidden="true">
              <svg viewBox="0 0 32 32"><path d="M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="3" r="2" fill="currentColor"/><rect x="6" y="8" width="20" height="17" rx="6" fill="currentColor"/><circle cx="12" cy="16" r="2.4" fill="var(--bg-2)"/><circle cx="20" cy="16" r="2.4" fill="var(--bg-2)"/><path d="M12.5 21h7" stroke="var(--bg-2)" stroke-width="1.8" stroke-linecap="round"/><path d="M4 15v4M28 15v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </span>
          ) : (
            <img class="avatar" src="/img/dean-256.webp" alt="" width="32" height="32" loading="lazy" />
          )}
          <div class:list={['bubble', m.from]}>
            <span class="who">{m.name ?? (m.from === 'bot' ? 'Support agent' : 'Dean')}{m.time && <time>{m.time}</time>}</span>
            <span set:html={m.text} />
            {m.quote && <blockquote set:html={m.quote} />}
            {m.options?.map((o, i) => <span class="opt"><b>{String.fromCharCode(65 + i)}</b> <span set:html={o} /></span>)}
          </div>
        </li>
      ))}
    </ol>
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .thread { max-width: 560px; margin: 0 auto; background: var(--bg-2); border: 1px solid var(--line); border-radius: 24px; overflow: hidden; }
  header { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); background: var(--card); }
  header b { display: block; font-size: 0.95rem; }
  header small { display: block; font-size: 0.75rem; color: var(--muted); }
  ol { list-style: none; margin: 0; padding: 16px 14px 6px; }
  .row { display: flex; align-items: flex-end; gap: 8px; margin-bottom: 14px; }
  .row.me { flex-direction: row-reverse; }
  .avatar { flex: none; width: 32px; height: 32px; border-radius: 50%; object-fit: cover; display: grid; place-items: center; }
  .avatar.bot { background: color-mix(in srgb, var(--violet) 22%, var(--card)); color: var(--violet); }
  .avatar.bot svg { width: 22px; height: 22px; }
  .avatar.mail { background: var(--card); border: 1px solid var(--line); color: var(--muted); }
  .avatar.mail svg { width: 16px; height: 16px; }
  header .avatar { width: 38px; height: 38px; }
  header .avatar svg { width: 26px; height: 26px; }
  .bubble { max-width: 82%; font-size: 0.86rem; line-height: 1.5; padding: 10px 13px; border-radius: 18px; }
  .bubble.bot { background: var(--card); border: 1px solid var(--line); border-bottom-left-radius: 5px; }
  .bubble.email { background: transparent; border: 1px dashed var(--line); border-bottom-left-radius: 5px; color: var(--muted); font-style: italic; }
  .bubble.me { background: color-mix(in srgb, var(--teal) 22%, var(--card)); border-bottom-right-radius: 5px; }
  .who { display: flex; gap: 8px; align-items: baseline; font-size: 0.7rem; font-weight: 600; color: var(--muted); margin-bottom: 3px; font-style: normal; }
  time { font-weight: 400; }
  .opt { display: block; margin-top: 6px; }
  .opt b { color: var(--teal); }
  blockquote { margin: 8px 0 2px; padding: 6px 10px; border-left: 3px solid var(--teal); background: var(--bg-2); border-radius: 6px; font-size: 0.82rem; color: var(--muted); }
  .bubble :global(code) { font-size: 0.8em; }
  .event { text-align: center; margin: 4px 0 14px; }
  .event span { display: inline-block; font-size: 0.72rem; color: var(--muted); background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; max-width: 92%; line-height: 1.4; }
  .event :global(b) { color: var(--text); font-weight: 600; white-space: nowrap; }
  @media (max-width: 560px) {
    .thread { border-radius: 18px; }
    ol { padding: 14px 10px 4px; }
    .bubble { max-width: 86%; font-size: 0.84rem; }
  }
</style>
