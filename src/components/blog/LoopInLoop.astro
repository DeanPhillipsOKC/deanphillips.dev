---
// The agents post's two loop pictures. Both are still pictures with no controls. They read the same with or
// without JavaScript, and the parts fade in once when they scroll into view unless the reader prefers less
// motion. Colors: the model violet, the harness and its results teal, the surprise --warn, Done --ok.
//
// mode="diagram": the bigger loop. The model box (with part 0's small loop as one line of pills, titles
// read from inference.json so they match part 0) and the harness box, joined by two labeled arrows. A tool
// request goes right, the whole conversation with the result added comes back. The model box ends in the
// Done exit, the harness box in its own way to stop. Under 620px the boxes stack and the arrows point down
// and up between them.
//
// mode="run": one made-up run as a numbered strip, one card per turn. Each card shows what the model wrote
// (its notes and the tool request) and what came back. Turn 2's card calls out the branch nobody wrote
// (script vs agent lines from the data), and the last card is the answer with no tool request, ending in
// Done. The data is src/data/ai-plainly/ai-plainly-agents.json, which AgentsReel also reads.
interface Step { title: string }
interface Turn { wrote: string; tool: string | null; back: string | null; surprise?: boolean; branch?: boolean }
interface RunData { job: string; turns: Turn[]; branch: { script: string; agent: string } }
interface Props { mode?: 'diagram' | 'run'; loop?: Step[]; run?: RunData; caption?: string }
const { mode = 'diagram', loop = [], run, caption } = Astro.props;
const titles = loop.map((s) => s.title);
const dial = '<svg class="lil-ico" viewBox="-10 -10 20 20" aria-hidden="true"><circle r="8" /><line x1="0" y1="0" x2="4" y2="-6" /></svg>';
const clip = '<svg class="lil-ico lil-ico-clip" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2" /><rect x="9" y="2" width="6" height="4" rx="1" /><path d="M8.5 11h7M8.5 15h5" /></svg>';
---
{mode === 'diagram' && (
<figure class="lil lil-diagram panel bleed">
  <div class="lil-ring">
    <section class="lil-box lil-model lil-fade" style="--i:0" aria-label="The model">
      <p class="lil-head"><Fragment set:html={dial} /><b>The model</b><span class="lil-own lil-own-m">uses the dials</span></p>
      <div class="lil-small">
        <p class="lil-strip" aria-label={`The small loop from part 0: ${titles.join(', ')}, then again`}>
          {titles.map((t, i) => (<span class="lil-step"><span class="lil-pip">{t}</span><span class="lil-to" aria-hidden="true">{i < titles.length - 1 ? '→' : '↺'}</span></span>))}
        </p>
        <p class="lil-per">The part 0 loop. One lap per token, about 140 laps a turn (made up).</p>
      </div>
      <p class="lil-writes"><span class="lil-k">It writes</span><span class="lil-pill lil-pill-think">notes to itself</span><span class="lil-then">then maybe</span><span class="lil-pill lil-pill-req">a tool request</span></p>
      <p class="lil-exit"><span class="lil-exit-t">No tool request?</span><span class="lil-exit-a" aria-hidden="true">→</span><span class="lil-done">Done</span></p>
    </section>
    <div class="lil-arrows lil-fade" style="--i:1">
      <p class="lil-arrow lil-arrow-go"><span>a tool request</span><i aria-hidden="true"></i></p>
      <p class="lil-arrow lil-arrow-back"><span>the whole conversation, result added</span><i aria-hidden="true"></i></p>
    </div>
    <section class="lil-box lil-harness lil-fade" style="--i:2" aria-label="The harness">
      <p class="lil-head"><Fragment set:html={clip} /><b>The harness</b><span class="lil-own lil-own-h">regular program</span></p>
      <p class="lil-aka">the app from part 1</p>
      <p class="lil-eg"><span class="lil-chip lil-chip-tool">weather, Saturday</span><span class="lil-eg-a" aria-hidden="true">↓</span><span class="lil-chip lil-chip-back">Rain 7 to 11 am</span></p>
      <p class="lil-does">Runs the tool and pastes the result onto the end of the conversation.</p>
      <p class="lil-stamp">The model isn't running here</p>
      <p class="lil-stop">It can also stop the run (too many turns, too much time or money, or it needs your OK).</p>
    </section>
  </div>
  <p class="lil-foot">One trip around = one turn</p>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
)}

{mode === 'run' && run && (
<figure class="lil lil-run panel bleed">
  <p class="lil-job lil-fade" style="--i:0"><span class="lil-k">Your job</span><span>{run.job}</span></p>
  <ol class="lil-turns">
    {run.turns.map((t, i) => (
      <li class={`lil-turn lil-fade${t.tool ? '' : ' lil-turn-last'}`} style={`--i:${i + 1}`}>
        <span class="lil-n">{i + 1}</span>
        <div class="lil-tbody">
          <p class="lil-th">Turn {i + 1}</p>
          {t.tool ? (
            <p class="lil-line"><span class="lil-k lil-k-m">Notes to itself</span><span class="lil-think">{t.wrote}</span></p>
          ) : (
            <p class="lil-line"><span class="lil-k lil-k-m">Its answer</span><span class="lil-answer">{t.wrote}</span></p>
          )}
          <p class="lil-line"><span class="lil-k lil-k-m">Tool request</span>{t.tool ? <span class="lil-chip lil-chip-tool">{t.tool}</span> : <span class="lil-chip lil-chip-none">none</span>}</p>
          {t.back && <p class={`lil-line${t.surprise ? ' lil-surp' : ''}`}><span class="lil-k lil-k-h">Came back</span><span class="lil-chip lil-chip-back">{t.back}</span>{t.surprise && <em class="lil-surp-t">Saturday is out</em>}</p>}
          {t.branch && (
            <div class="lil-branch">
              <p class="lil-branch-h">Nobody wrote this step</p>
              <p class="lil-vs"><b class="lil-vs-no">Script</b>{run.branch.script}</p>
              <p class="lil-vs"><b class="lil-vs-yes">Agent</b>{run.branch.agent}</p>
            </div>
          )}
          {!t.tool && <p class="lil-fin"><span class="lil-done">Done</span>Nothing left for the harness to run, so it stops.</p>}
        </div>
      </li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.lil')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    root.classList.add('lil-ready');
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { root.classList.add('lil-go'); io.disconnect(); } }, { threshold: 0.12 });
    io.observe(root);
  }
</script>

<style is:global>
  .lil p { margin: 0; }
  .lil-ico { width: 22px; height: 22px; flex: none; }
  .lil-ico circle { fill: none; stroke: currentColor; stroke-width: 2; }
  .lil-ico line { stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; }
  .lil-ico-clip { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .lil-head { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .lil-head b { font: 700 1.3rem/1.15 "Space Grotesk", sans-serif; color: var(--text); }
  .lil-model .lil-head { color: var(--violet); }
  .lil-harness .lil-head { color: var(--teal); }
  .lil-own { font: 600 0.82rem/1 Inter, sans-serif; padding: 5px 9px; border-radius: 999px; }
  .lil-own-m { color: var(--violet); background: color-mix(in srgb, var(--violet) 14%, transparent); }
  .lil-own-h { color: var(--teal); background: color-mix(in srgb, var(--teal) 14%, transparent); }
  .lil-k { display: inline-block; flex: none; padding: 3px 8px; border-radius: 6px; font: 700 0.72rem/1.4 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; background: var(--card); border: 1px solid var(--line); color: var(--muted); }
  .lil-k-m { color: var(--violet); border-color: color-mix(in srgb, var(--violet) 50%, transparent); }
  .lil-k-h { color: var(--teal); border-color: color-mix(in srgb, var(--teal) 50%, transparent); }
  .lil-chip { display: inline-block; max-width: 100%; font: 600 0.92rem/1.25 Inter, sans-serif; padding: 7px 12px; border-radius: 999px; }
  .lil-chip-tool { color: var(--violet); background: var(--card); border: 1.5px dashed var(--violet); }
  .lil-chip-back { color: var(--teal); background: var(--card); border: 1.5px solid var(--teal); }
  .lil-chip-none { color: var(--muted); border: 1.5px dashed var(--muted); }
  .lil-done { display: inline-block; font: 700 1rem/1 "Space Grotesk", sans-serif; color: var(--bg); background: var(--ok); padding: 8px 16px; border-radius: 999px; }

  /* Diagram: model | arrows | harness. */
  .lil-ring { display: grid; grid-template-columns: minmax(0, 1fr) 124px minmax(0, 1fr); align-items: stretch; }
  .lil-box { border-radius: 16px; padding: 16px; background: var(--bg-2); border: 3px solid var(--line); display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .lil-model { border-color: var(--violet); }
  .lil-harness { border-color: var(--teal); }
  .lil-small { display: grid; gap: 6px; padding: 10px; border-radius: 12px; background: var(--card); }
  .lil-strip { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 4px; }
  .lil-pip { font: 600 0.85rem/1 Inter, sans-serif; padding: 6px 9px; border-radius: 999px; white-space: nowrap; color: var(--violet); border: 1.5px solid color-mix(in srgb, var(--violet) 55%, var(--line)); }
  .lil-step { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  .lil-to { font: 700 1rem/1 Inter, sans-serif; color: var(--violet); }
  .lil-per { font: 500 0.88rem/1.35 Inter, sans-serif; color: var(--muted); }
  .lil-writes { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; }
  .lil-pill { font: 600 0.92rem/1.1 Inter, sans-serif; padding: 7px 11px; border-radius: 999px; }
  .lil-pill-think { color: var(--violet); background: color-mix(in srgb, var(--violet) 16%, transparent); border: 1.5px solid var(--violet); }
  .lil-pill-req { color: var(--violet); border: 1.5px dashed var(--violet); }
  .lil-then { font: 500 0.88rem/1 Inter, sans-serif; color: var(--muted); }
  .lil-exit { margin-top: auto !important; display: flex; align-items: center; flex-wrap: nowrap; gap: 8px 10px; padding-top: 10px; border-top: 2px dashed color-mix(in srgb, var(--ok) 60%, transparent); }
  .lil-exit-t { font: 600 0.95rem/1.3 Inter, sans-serif; color: var(--ok); }
  .lil-exit-a { font: 700 1.2rem/1 Inter, sans-serif; color: var(--ok); }
  .lil-aka { margin-top: -6px !important; font: italic 500 0.9rem/1.3 Inter, sans-serif; color: var(--muted); }
  .lil-eg { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 10px; border-radius: 12px; background: var(--card); }
  .lil-eg-a { padding-left: 16px; font: 700 1.1rem/1 Inter, sans-serif; color: var(--muted); }
  .lil-does { font: 500 1rem/1.4 Inter, sans-serif; color: var(--text); }
  .lil-stamp { text-align: center; font: 700 1.05rem/1.25 "Space Grotesk", sans-serif; color: var(--muted); border: 2.5px dashed var(--muted); border-radius: 12px; padding: 9px 12px; }
  .lil-stop { margin-top: auto !important; padding-top: 10px; border-top: 2px dashed var(--line); font: 500 0.88rem/1.35 Inter, sans-serif; color: var(--muted); }
  .lil-arrows { display: flex; flex-direction: column; justify-content: center; gap: 40px; padding: 0 8px; }
  .lil-arrow { display: grid; gap: 6px; text-align: center; font: 600 0.9rem/1.3 Inter, sans-serif; }
  .lil-arrow i { position: relative; display: block; height: 3px; border-radius: 2px; }
  .lil-arrow i::after { content: ''; position: absolute; top: -7px; border: 8px solid transparent; }
  .lil-arrow-go { color: var(--violet); }
  .lil-arrow-go i { background: var(--violet); margin-right: 8px; }
  .lil-arrow-go i::after { right: -12px; border-left: 12px solid var(--violet); border-right: 0; }
  .lil-arrow-back { color: var(--teal); }
  .lil-arrow-back i { background: var(--teal); margin-left: 8px; order: -1; }
  .lil-arrow-back i::after { left: -12px; border-right: 12px solid var(--teal); border-left: 0; }
  .lil-foot { margin: 16px auto 0 !important; width: fit-content; max-width: 100%; text-align: center; font: 600 0.95rem/1.3 Inter, sans-serif; color: var(--muted); background: var(--bg-2); border-radius: 999px; padding: 8px 16px; }

  /* Run: one numbered card per turn. */
  .lil-job { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; margin-bottom: 14px !important; padding: 12px 14px; border-radius: 14px; background: color-mix(in srgb, var(--muted) 14%, var(--card)); font: 500 1.02rem/1.4 Inter, sans-serif; color: var(--text); }
  .lil-turns { list-style: none; margin: 0 !important; padding: 0 !important; display: grid; gap: 12px; }
  .lil-turn { margin: 0 !important; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px; align-items: start; padding: 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); border-left: 4px solid var(--violet); }
  .lil-turn-last { border-left-color: var(--ok); }
  .lil-n { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font: 700 1.1rem/1 "Space Grotesk", sans-serif; background: color-mix(in srgb, var(--violet) 22%, var(--card)); color: var(--text); }
  .lil-turn-last .lil-n { background: color-mix(in srgb, var(--ok) 25%, var(--card)); }
  .lil-tbody { display: grid; gap: 10px; min-width: 0; }
  .lil-th { font: 700 1.05rem/1.3 "Space Grotesk", sans-serif; color: var(--text); }
  .lil-line { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .lil-think { font: italic 500 1rem/1.4 Inter, sans-serif; color: var(--text); }
  .lil-answer { flex-basis: 100%; padding: 10px 14px; border-radius: 14px; font: 500 1rem/1.4 Inter, sans-serif; color: var(--text); background: color-mix(in srgb, var(--violet) 16%, var(--card)); border: 1px solid color-mix(in srgb, var(--violet) 50%, transparent); }
  .lil-surp .lil-chip-back { border-color: var(--warn); box-shadow: inset 4px 0 0 var(--warn); }
  .lil-surp-t { font: italic 600 0.9rem/1.3 Inter, sans-serif; color: var(--warn); }
  .lil-branch { display: grid; gap: 6px; padding: 10px 12px; border-radius: 10px; border: 2px solid var(--warn); background: color-mix(in srgb, var(--warn) 10%, var(--card)); }
  .lil-branch-h { font: 700 1rem/1.3 "Space Grotesk", sans-serif; color: var(--warn); }
  .lil-vs { font: 500 0.95rem/1.4 Inter, sans-serif; color: var(--text); }
  .lil-vs b { display: inline-block; min-width: 4.4em; margin-right: 6px; font: 700 0.75rem/1.4 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; }
  .lil-vs-no { color: var(--muted); }
  .lil-vs-yes { color: var(--violet); }
  .lil-fin { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; font: 600 0.95rem/1.35 Inter, sans-serif; color: var(--ok); }

  .lil-ready .lil-fade { opacity: 0; transform: translateY(10px); }
  .lil-go .lil-fade { opacity: 1; transform: none; transition: opacity .5s ease, transform .5s ease; transition-delay: calc(var(--i) * .35s); }

  @media (max-width: 620px) {
    .lil-ring { grid-template-columns: minmax(0, 1fr); }
    .lil-arrows { flex-direction: row; justify-content: space-around; gap: 12px; padding: 10px 0; }
    .lil-arrow { flex: 1; grid-template-columns: auto minmax(0, 1fr); align-items: center; text-align: left; gap: 10px; }
    .lil-arrow i { width: 3px; height: 44px; margin: 0 !important; order: -1; }
    .lil-arrow i::after { left: -6.5px; }
    .lil-arrow-go i::after { top: auto; right: auto; bottom: -10px; border: 8px solid transparent; border-top: 11px solid var(--violet); border-bottom: 0; }
    .lil-arrow-back i::after { top: -10px; border: 8px solid transparent; border-bottom: 11px solid var(--teal); border-top: 0; }
    .lil-turn { grid-template-columns: 30px minmax(0, 1fr); gap: 10px; padding: 12px; }
    .lil-n { width: 30px; height: 30px; font-size: 0.95rem; }
  }
</style>
