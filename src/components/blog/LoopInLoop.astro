---
// The agents post's main picture: the bigger loop. Two stations take turns. On the left, the model (violet,
// "uses the dials") holds part 0's small loop as a strip of five pills (titles read from inference.json, so
// they match part 0 exactly) and a trip counter. It writes notes to itself (its thinking) and maybe a tool
// request, one token at a time. On the right, the harness (teal, "regular program", the app from part 1)
// runs the tool and pastes the result onto the end of the conversation, with a small made-up example and a
// stamp that says this model isn't running there. A top arrow (a tool request) and a bottom arrow (the whole
// conversation, result added) make the ring. Exits: a green "Done" off the model (an answer with no tool
// request), and a grey one off the harness (it stops the run).
//
// mode="diagram": tap a station for a one-line explanation. When it scrolls into view the small loop plays
// one slow lap (each pill lit for 300 ms, counter at 1), then all pills hold a soft fill while the counter
// steps to about 140 (nothing changes faster than every 150 ms). Reduced motion shows the final count.
// Without JavaScript the diagram is the same, with an ordered list under it. Under 620px the ring stacks:
// model, a drawn down arrow (with Done offset to the right), harness, and a return line up the left edge
// with its label written flat underneath.
//
// mode="run": the same two-station ring, compact, with the request and result chips riding the arcs. Under
// it, a "conversation tape" that grows one block per piece of text, a "who's working" strip, and a turn
// card. Next turn plays a turn (about 2.6 s). Turn 2 pauses for a guess first, with last turn's result kept
// on the card. Every frame is drawn by render(turn, p), a pure function of the turn and its progress p.
// The card's height is reserved for its tallest state, so the buttons don't jump. Reduced motion jumps to
// the end of each turn. Without JavaScript all four turns are listed, with the final tape and the guess's
// answer in a <details>.
interface Step { title: string }
interface Turn { wrote: string; tool: string | null; back: string | null; tag?: string; trips: number; wroteSize: number; backSize: number; surprise?: boolean; brainPower?: boolean }
interface BP { question: string; options: string[]; answer: string; right: string; wrong: string; script: string; agent: string }
interface RunData { job: string; jobSize: number; turns: Turn[]; brainPower: BP }
interface Props { mode?: 'diagram' | 'run'; loop: Step[]; run?: RunData; caption?: string }
const { mode = 'diagram', loop, run, caption } = Astro.props;
const titles = loop.map((s) => s.title);
const dial = '<svg class="lil-dial" viewBox="-10 -10 20 20" aria-hidden="true"><circle r="8" /><line x1="0" y1="0" x2="4" y2="-6" /></svg>';
const clip = '<svg class="lil-clip" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2" /><rect x="9" y="2" width="6" height="4" rx="1" /><path d="M8.5 11h7M8.5 15h5" /></svg>';
const SCALE = run ? run.jobSize + run.turns.reduce((s, t) => s + t.wroteSize + t.backSize, 0) + 200 : 1;
const fmt = (n: number) => n.toLocaleString('en-US');
let total = run?.jobSize ?? 0;
const sizes = run ? run.turns.map((t) => (total += t.wroteSize + t.backSize)) : [];
---
{mode === 'diagram' && (
<figure class="lil lil-diagram panel bleed">
  <div class="lil-ring">
    <p class="lil-arc lil-arc-top"><span>a tool request</span></p>
    <section class="lil-box lil-model" data-explain="model" aria-label="The model">
      <p class="lil-head"><Fragment set:html={dial} /><b>The model</b><span class="lil-own lil-own-m">uses the dials</span></p>
      <div class="lil-small">
        <p class="lil-strip" aria-label={`The small loop from part 0: ${titles.join(', ')}, then again`}>
          {titles.map((t, i) => <span class="lil-step"><span class="lil-pip" data-i={i}>{t}</span><span class="lil-to" aria-hidden="true">{i < titles.length - 1 ? '→' : '↺'}</span></span>)}
        </p>
        <p class="lil-count"><span class="lil-cl">trips</span><b class="lil-n">about 140</b><em class="lil-cn">per turn (made up)</em></p>
      </div>
      <p class="lil-per">The part 0 loop. One lap per token.</p>
      <p class="lil-out"><span class="lil-pill lil-pill-think">notes to itself (its thinking)</span><span class="lil-then">then maybe</span><span class="lil-pill lil-pill-req">a tool request</span></p>
      <p class="lil-note">Both written one token at a time.</p>
    </section>
    <section class="lil-box lil-harness" data-explain="harness" aria-label="The harness">
      <p class="lil-head"><Fragment set:html={clip} /><b>The harness</b><span class="lil-own lil-own-h">regular program</span></p>
      <p class="lil-aka">the app from part 1</p>
      <ul class="lil-does">
        <li>runs the tool</li>
        <li>pastes the result onto the end of the conversation</li>
      </ul>
      <p class="lil-eg"><span class="lil-chip lil-chip-tool">weather, Saturday</span><span class="lil-eg-a" aria-hidden="true">→</span><span class="lil-chip lil-chip-back">Rain 7 to 11 am</span><em>made-up example</em></p>
      <p class="lil-stamp">This model isn't running here</p>
      <p class="lil-hand">↑ No background thinking between calls</p>
    </section>
    <p class="lil-arc lil-arc-bot"><span>the whole conversation, result added</span></p>
    <p class="lil-arc-sub">Its next step depends on what came back</p>
    <p class="lil-mdown" aria-hidden="true"><i class="lil-mdown-line"></i><span>a tool request</span></p>
    <p class="lil-mret" aria-hidden="true"></p>
    <p class="lil-mret-l" aria-hidden="true"><b>↺ result added, call the model again</b><small>Its next step depends on what came back</small></p>
    <p class="lil-exit lil-exit-done"><i class="lil-exit-line"></i><span class="lil-done" data-explain="done">Done</span><span class="lil-exit-t">Wrote an answer with no tool request</span></p>
    <p class="lil-exit lil-exit-stop"><i class="lil-exit-line"></i><span class="lil-exit-t">or the harness says stop (too many turns, too much time or money, or it needs your OK first)</span></p>
  </div>
  <p class="lil-foot">One trip around this big ring = one turn</p>
  <p class="lil-explain" aria-live="polite" hidden></p>
  <ol class="lil-nojs">
    <li>The model writes notes to itself and maybe a tool request, one token at a time.</li>
    <li>The harness runs the tool and pastes the result in.</li>
    <li>Repeat until the model writes an answer with no tool request, or the harness stops it.</li>
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
)}

{mode === 'run' && run && (
<figure class="lil lil-run panel bleed" data-lil-run={JSON.stringify({ ...run, scale: SCALE })}>
  <div class="lil-live" hidden>
    <div class="lil-st">
      <p class="lil-arc lil-arc-top lil-rarc" aria-hidden="true"><span>tool request</span><em class="lil-chip lil-chip-tool"></em></p>
      <section class="lil-mini lil-mini-m">
        <p class="lil-head"><Fragment set:html={dial} /><b>The model</b></p>
        <p class="lil-mc">this turn <b class="lil-rn">0</b> trips</p>
        <p class="lil-mt">total so far <b class="lil-rt">0</b></p>
        <p class="lil-rdone">Done</p>
      </section>
      <section class="lil-mini lil-mini-h">
        <p class="lil-head"><Fragment set:html={clip} /><b>The harness</b></p>
        <p class="lil-mstamp">model not running</p>
      </section>
      <p class="lil-arc lil-arc-bot lil-rarc" aria-hidden="true"><span>result added</span><em class="lil-chip lil-chip-back"></em></p>
      <p class="lil-rret" aria-hidden="true"></p>
    </div>
    <p class="lil-lab">The conversation <span class="lil-size"></span></p>
    <div class="lil-tape" aria-hidden="true">
      <i class="lil-tb lil-tb-job" style={`width:${(100 * run.jobSize / SCALE).toFixed(2)}%`}></i>
      {run.turns.map((t, i) => (<><i class="lil-tb lil-tb-m" data-w={i}></i><i class="lil-tb lil-tb-h" data-b={i}>{t.tag && <span>{t.tag}</span>}</i></>))}
    </div>
    <p class="lil-legend"><span><i class="lil-sw lil-sw-job"></i>your job</span><span><i class="lil-sw lil-sw-m"></i>the model wrote</span><span><i class="lil-sw lil-sw-h"></i>tool result</span></p>
    <p class="lil-lab">Who's working</p>
    <div class="lil-who" aria-hidden="true">
      {run.turns.map((t, i) => (<><i class="lil-ws lil-ws-m" data-wm={i}></i>{t.tool && <i class="lil-ws lil-ws-h" data-wh={i}><span class="lil-ws-long">model not running</span><span class="lil-ws-short">model off</span></i>}</>))}
    </div>
    <div class="lil-card" aria-live="polite">
      <p class="lil-tn"></p>
      <p class="lil-row lil-row-job"><span class="lil-k lil-k-job">your job</span><span class="lil-v">{run.job}</span></p>
      <p class="lil-row lil-row-prev lil-surp"><span class="lil-k lil-k-h">came back last turn</span><span class="lil-v"></span></p>
      <p class="lil-row lil-row-w"><span class="lil-k lil-k-m">the model wrote (its thinking)</span><span class="lil-v"></span></p>
      <p class="lil-row lil-row-t"><span class="lil-k lil-k-m">tool request</span><span class="lil-v"></span></p>
      <p class="lil-row lil-row-b"><span class="lil-k lil-k-h">came back</span><span class="lil-v"></span></p>
      <div class="lil-bp" hidden>
        <p class="lil-bp-q"><b>Brain power.</b> {run.brainPower.question}</p>
        <p class="lil-bp-o">{run.brainPower.options.map((o) => <button type="button" data-pick={o}>{o}</button>)}</p>
      </div>
      <p class="lil-bp-r" hidden></p>
      <div class="lil-vs" hidden>
        <p class="lil-vs-no"><b><span aria-hidden="true">✗ </span>Script</b>{run.brainPower.script}</p>
        <p class="lil-vs-yes"><b><span aria-hidden="true">✓ </span>Agent</b>{run.brainPower.agent}</p>
      </div>
      <p class="lil-fin" hidden>Done. No tool request, so the harness stops.</p>
    </div>
    <div class="lil-ctrl">
      <button type="button" class="lil-back">Back</button>
      <span class="lil-cnt"></span>
      <button type="button" class="lil-next">Next turn</button>
    </div>
  </div>
  <div class="lil-static">
    <p class="lil-row lil-row-job"><span class="lil-k lil-k-job">your job</span><span class="lil-v">{run.job}</span></p>
    <ol class="lil-scards">
      {run.turns.map((t, i) => (
        <li>
          <p class="lil-tn">Turn {i + 1} of {run.turns.length} <span class="lil-size">conversation length {fmt(sizes[i])} (made-up units)</span></p>
          <p class="lil-row"><span class="lil-k lil-k-m">the model wrote (its thinking)</span><span class="lil-v">{t.wrote}</span></p>
          <p class="lil-row"><span class="lil-k lil-k-m">tool request</span><span class="lil-v">{t.tool ?? 'none'}</span></p>
          {t.back && <p class="lil-row"><span class="lil-k lil-k-h">came back</span><span class="lil-v">{t.back}</span></p>}
          {t.brainPower && <details><summary>Brain power. {run.brainPower.question}</summary><p>{run.brainPower.wrong} {run.brainPower.script} {run.brainPower.agent}</p></details>}
          {!t.tool && <p class="lil-fin">Done. No tool request, so the harness stops.</p>}
        </li>
      ))}
    </ol>
    <p class="lil-lab">The conversation at the end (made-up units)</p>
    <div class="lil-tape" aria-hidden="true">
      <i class="lil-tb lil-tb-job" style={`width:${(100 * run.jobSize / SCALE).toFixed(2)}%`}></i>
      {run.turns.map((t) => (<><i class="lil-tb lil-tb-m" style={`width:${(100 * t.wroteSize / SCALE).toFixed(2)}%`}></i>{t.backSize > 0 && <i class="lil-tb lil-tb-h" style={`width:${(100 * t.backSize / SCALE).toFixed(2)}%`}>{t.tag && <span>{t.tag}</span>}</i>}</>))}
    </div>
    <p class="lil-legend"><span><i class="lil-sw lil-sw-job"></i>your job</span><span><i class="lil-sw lil-sw-m"></i>the model wrote</span><span><i class="lil-sw lil-sw-h"></i>tool result</span></p>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
)}

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const ease = (x: number) => 1 - Math.pow(1 - clamp(x), 3);

  // Diagram mode: tap to explain, and one slow lap of the small loop when the figure scrolls into view.
  const EXPLAIN: Record<string, string> = {
    model: 'One call. It writes notes to itself and maybe a tool request, token by token.',
    harness: 'A regular program. It runs the tool and pastes the result in, then calls the model again.',
    done: "No tool request means there's nothing for the harness to do, so it stops.",
  };
  for (const root of document.querySelectorAll<HTMLElement>('.lil-diagram')) {
    root.classList.add('lil-js');
    const say = root.querySelector<HTMLElement>('.lil-explain')!;
    say.hidden = false;
    say.textContent = 'Tap the model, the harness, or Done.';
    const hits = [...root.querySelectorAll<HTMLElement>('[data-explain]')];
    for (const el of hits) {
      el.tabIndex = 0;
      el.setAttribute('role', 'button');
      el.setAttribute('aria-pressed', 'false');
      const pick = () => {
        for (const h of hits) { const on = h === el; h.classList.toggle('lil-on', on); h.setAttribute('aria-pressed', String(on)); }
        say.textContent = EXPLAIN[el.dataset.explain!];
      };
      el.addEventListener('click', (e) => { e.stopPropagation(); pick(); });
      el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); } });
    }
    if (reduce) continue;
    const n = root.querySelector<HTMLElement>('.lil-n')!;
    const cl = root.querySelector<HTMLElement>('.lil-cl')!;
    const cn = root.querySelector<HTMLElement>('.lil-cn')!;
    const pips = [...root.querySelectorAll<HTMLElement>('.lil-pip')];
    const strip = root.querySelector<HTMLElement>('.lil-strip')!;
    const LAP = 300 * pips.length, FAST = 1500, STEP = 150;
    n.textContent = '0';
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = now - t0;
        if (t < LAP) {
          // One slow lap: each pill lit for 300 ms, in order. This is trip 1.
          const i = Math.floor(t / 300);
          pips.forEach((p, j) => p.classList.toggle('lil-lit', j === i));
          cl.textContent = 'trip'; n.textContent = '1'; cn.textContent = 'one lap, one token';
        } else if (t < LAP + FAST) {
          // Then the same lap again and again. The pills hold a soft fill, and the counter steps every 150 ms.
          pips.forEach((p) => p.classList.remove('lil-lit'));
          strip.classList.add('lil-soft');
          const s = Math.floor((t - LAP) / STEP), steps = Math.floor(FAST / STEP);
          cl.textContent = 'trips'; n.textContent = String(Math.max(2, Math.round(140 * s / steps)));
          cn.textContent = 'the same lap again, about 140 times (made up)';
        } else {
          strip.classList.remove('lil-soft');
          cl.textContent = 'trips'; n.textContent = 'about 140'; cn.textContent = 'per turn (made up)';
          return;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.45 });
    io.observe(root);
  }

  // Run mode.
  type Turn = { wrote: string; tool: string | null; back: string | null; trips: number; wroteSize: number; backSize: number; surprise?: boolean; brainPower?: boolean };
  type Run = { job: string; jobSize: number; turns: Turn[]; scale: number; brainPower: { answer: string; right: string; wrong: string } };
  for (const root of document.querySelectorAll<HTMLElement>('.lil-run')) {
    const R = JSON.parse(root.dataset.lilRun!) as Run;
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll(s)] as T[];
    $('.lil-live').hidden = false;
    $('.lil-static').hidden = true;
    const N = R.turns.length;
    const mini = { m: $('.lil-mini-m'), h: $('.lil-mini-h') };
    const rn = $('.lil-rn'), rt = $('.lil-rt'), rdone = $('.lil-rdone');
    const chipT = $('.lil-chip-tool'), chipB = $('.lil-chip-back');
    const arcs = $$('.lil-rarc');
    const size = $('.lil-live .lil-size');
    const wBlocks = $$('.lil-live [data-w]'), bBlocks = $$('.lil-live [data-b]');
    const wm = $$('[data-wm]'), wh = $$('[data-wh]');
    const card = $('.lil-card');
    const tn = $('.lil-card .lil-tn');
    const row = (k: string) => $(`.lil-card .lil-row-${k}`);
    const val = (k: string) => row(k).querySelector<HTMLElement>('.lil-v')!;
    const bp = $('.lil-bp'), bpR = $('.lil-bp-r'), vs = $('.lil-vs'), fin = $('.lil-fin');
    const bpButtons = $$<HTMLButtonElement>('.lil-bp-o button');
    const back = $<HTMLButtonElement>('.lil-back'), next = $<HTMLButtonElement>('.lil-next'), cnt = $('.lil-cnt');
    const pct = (n: number) => `${(100 * n / R.scale).toFixed(2)}%`;
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const slide = (el: HTMLElement, x: number) => el.style.setProperty('--x', x.toFixed(4));

    let turn = 0, p = 1, picked = '', asking = false, raf = 0;

    // Everything on screen comes from (turn, p). Turn 0 is the start. In a turn with a tool, the model
    // writes for p in 0 to 0.4, the request travels 0.4 to 0.55, the harness works 0.55 to 0.8, and the
    // result travels back and lands 0.8 to 1. The last turn has no tool, so it only writes, then stops.
    function render(k: number, q: number) {
      const T = R.turns[k - 1];
      const hasTool = !!T?.tool;
      const write = k === 0 ? 1 : hasTool ? clamp(q / 0.4) : clamp(q / 0.7);
      const go = hasTool ? clamp((q - 0.4) / 0.15) : 0;
      const work = hasTool ? q >= 0.55 && q < 0.8 : false;
      const ret = hasTool ? clamp((q - 0.8) / 0.2) : 0;
      const modelOn = k > 0 && !asking && (hasTool ? q < 0.4 : q < 0.7);
      const modelOff = hasTool && !asking && q >= 0.4 && q < 1;
      const done = k === N && q >= 0.7;

      mini.m.classList.toggle('lil-act', modelOn);
      mini.m.classList.toggle('lil-dim', modelOff);
      mini.h.classList.toggle('lil-act', work);
      mini.h.classList.toggle('lil-off', modelOff);
      const now = k === 0 || asking ? 0 : Math.floor(T.trips * ease(write));
      rn.textContent = String(now);
      rt.textContent = String(R.turns.slice(0, Math.max(0, k - 1)).reduce((a, t) => a + t.trips, 0) + now);
      rdone.classList.toggle('lil-show', done);

      arcs[0].classList.toggle('lil-show', hasTool && !asking && q >= 0.4 && q < 0.8);
      chipT.textContent = T?.tool ?? '';
      slide(chipT, ease(go));
      arcs[1].classList.toggle('lil-show', hasTool && !asking && q >= 0.8);
      chipB.textContent = T?.back ?? '';
      chipB.classList.toggle('lil-surp', !!T?.surprise);
      slide(chipB, 1 - ease(ret));

      // The tape: earlier turns are full, this one grows.
      let s = R.jobSize;
      R.turns.forEach((t, i) => {
        const w = i < k - 1 ? 1 : i === k - 1 && !asking ? ease(write) : 0;
        const b = i < k - 1 ? 1 : i === k - 1 && !asking ? ease(ret) : 0;
        wBlocks[i].style.width = pct(t.wroteSize * w);
        bBlocks[i].style.width = pct(t.backSize * b);
        s += t.wroteSize * w + t.backSize * b;
      });
      size.innerHTML = `length ${fmt(s)} <em>(made-up units)</em>`;

      // Who's working.
      R.turns.forEach((t, i) => {
        const past = i < k - 1, cur = i === k - 1 && !asking;
        wm[i].classList.toggle('lil-show', past || (cur && q > 0));
        wm[i].classList.toggle('lil-act', cur && modelOn);
      });
      let j = 0;
      R.turns.forEach((t, i) => {
        if (!t.tool) return;
        const el = wh[j++];
        const past = i < k - 1, cur = i === k - 1 && !asking;
        el.classList.toggle('lil-show', past || (cur && q >= 0.55));
        el.classList.toggle('lil-act', cur && work);
      });

      // The turn card.
      const bpTurn = !!T?.brainPower;
      const P = R.turns[k - 2];
      tn.innerHTML = k === 0 ? 'Before turn 1' : `Turn ${k} of ${N}`;
      row('job').hidden = k !== 0;
      row('prev').hidden = !(asking && P?.back);
      val('prev').textContent = P?.back ?? '';
      row('w').hidden = k === 0 || asking;
      val('w').textContent = T ? T.wrote.slice(0, Math.ceil(T.wrote.length * write)) : '';
      row('t').hidden = k === 0 || asking || (hasTool ? q < 0.4 : q < 0.7);
      val('t').innerHTML = hasTool ? `<span class="lil-chip lil-chip-tool">${T.tool}</span>` : '<span class="lil-chip lil-chip-none">none</span>';
      row('b').hidden = k === 0 || !hasTool || asking || q < 0.95;
      val('b').textContent = T?.back ?? '';
      row('b').classList.toggle('lil-surp', !!T?.surprise);
      bp.hidden = !(bpTurn && asking);
      bpR.hidden = vs.hidden = !(bpTurn && picked && !asking);
      bpR.textContent = picked === R.brainPower.answer ? R.brainPower.right : R.brainPower.wrong;
      fin.hidden = !done;
      cnt.textContent = k === 0 ? 'Press Start' : `${k} of ${N}`;
      back.disabled = k === 0;
      next.disabled = asking;
      next.textContent = k === N ? 'Start over' : k === 0 ? 'Start' : 'Next turn';
    }

    // Reserve the card's tallest state (the brain-power turn, after the guess) so the buttons don't jump.
    function sizeCard() {
      const saved = { turn, p, picked, asking };
      card.style.minHeight = '';
      let h = 0;
      R.turns.forEach((t, i) => {
        for (const ask of t.brainPower ? [true, false] : [false]) {
          asking = ask; picked = ask ? '' : '(a wrong pick, the longer line)';
          render(i + 1, 1);
          h = Math.max(h, card.offsetHeight);
        }
      });
      ({ turn, p, picked, asking } = saved);
      card.style.minHeight = `${h}px`;
      render(turn, p);
    }

    function play(k: number) {
      cancelAnimationFrame(raf);
      turn = k;
      asking = !!R.turns[k - 1]?.brainPower && !picked;
      if (asking || reduce || k === 0) { p = asking ? 0 : 1; render(turn, p); return; }
      const t0 = performance.now();
      const step = (now: number) => {
        p = clamp((now - t0) / 2600);
        render(turn, p);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    for (const b of bpButtons) {
      b.addEventListener('click', () => {
        picked = b.dataset.pick!;
        for (const x of bpButtons) {
          x.disabled = true;
          x.classList.toggle('lil-right', x.dataset.pick === R.brainPower.answer);
          x.classList.toggle('lil-chosen', x === b);
        }
        play(turn);
      });
    }
    next.addEventListener('click', () => play(turn === N ? 0 : turn + 1));
    back.addEventListener('click', () => { cancelAnimationFrame(raf); asking = false; turn = Math.max(0, turn - 1); p = 1; render(turn, p); });
    render(0, 1);
    sizeCard();
    let rz = 0;
    addEventListener('resize', () => { clearTimeout(rz); rz = window.setTimeout(sizeCard, 150); });
  }
</script>

