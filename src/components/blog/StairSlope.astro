---
// "A dial is a slope" as a numbered comic of four still panels. Each panel has a staircase drawn on
// squares with "1 over" under a tread and "N up" beside a riser, a knob drawn like DialDemo's (ring, arc,
// needle, number; teal above zero, pink below), and one big label. Panel 4 ties back to part 1's sky to
// blue dial, whose input is only ever 0 or 1 (the clue is in the sentence or it isn't) and whose push
// comes before the percentage. All inline SVG, no JavaScript and no motion, so every reader sees the same.
// One column on phones, two by two from 640px.
const U = 36;
const knob = (v: number) => {
  const ang = (v / 4) * 135, r = 16, a0 = -Math.PI / 2, a1 = a0 + (ang * Math.PI) / 180;
  const p = (a: number) => `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
  return { ang, d: Math.abs(ang) < 1 ? '' : `M ${p(a0)} A ${r} ${r} 0 0 ${ang > 0 ? 1 : 0} ${p(a1)}`, neg: v < 0 };
};
// A staircase of n steps, each 1 over and `up` up, starting at (x0, y0) in SVG units.
const stairs = (n: number, up: number, x0: number, y0: number) => {
  let d = `M${x0} ${y0}`, x = x0, y = y0;
  for (let i = 0; i < n; i++) { x += U; d += ` H${x}`; if (up !== 0) { y -= up * U; d += ` V${y}`; } }
  return { d, x, y };
};
const panels = [
  { n: 1, v: 0, up: 0, label: '0 up for each step over. Flat.', tag: '' },
  { n: 2, v: 2, up: 2, label: '2 up for each step over. Uphill.', tag: 'the bean plant, about 2 cm a week' },
  { n: 3, v: -1, up: -1, label: 'Below zero. Downhill.', tag: 'a push turns into a pull' },
];
---
<figure class="sts panel bleed">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><pattern id="sts-squares" width="36" height="36" patternUnits="userSpaceOnUse" x="32" y="16"><path d="M36 0H0V36" style="fill:none;stroke:var(--line);stroke-width:1" /></pattern></defs></svg>
  <ol class="sts-grid">
    {panels.map((p) => {
      const k = knob(p.v);
      const n = p.up === 2 ? 2 : 3;
      const H = p.up === 2 ? 190 : 150;
      const x0 = 68, y0 = p.up === 2 ? 160 : p.up === -1 ? 52 : 88;
      const s = stairs(n, p.up, x0, y0);
      const tone = p.v < 0 ? 'sts-neg' : p.v > 0 ? 'sts-pos' : 'sts-flat';
      const tread = { x: x0 + U / 2, y: p.up < 0 ? y0 - 10 : y0 + 24 };
      const riserX = x0 + U + 8, riserY = p.up < 0 ? y0 + 24 : y0 - (p.up * U) / 2 + 6;
      const ticks = Array.from({ length: n + 1 }, (_, i) => x0 + i * U);
      return (
        <li class={`sts-card ${tone}`}>
          <div class="sts-top">
            <span class="sts-num">{p.n}</span>
            <svg class="sts-knob" viewBox="-20 -20 40 40" aria-hidden="true">
              <circle r="16" class="sts-ring" />
              {k.d && <path class={`sts-arc${k.neg ? ' sts-arc-neg' : ''}`} d={k.d} />}
              <line x1="0" y1="0" x2="0" y2="-12" class="sts-needle" transform={`rotate(${k.ang})`} />
            </svg>
            <b class="sts-kv">{p.v > 0 ? `+${p.v}` : p.v}</b>
          </div>
          <svg class="sts-pic" viewBox={`0 0 240 ${H}`} role="img" aria-label={p.label}>
            <rect class="sts-sq" width="240" height={H} />
            <line class="sts-slope" x1={x0} y1={y0} x2={s.x} y2={s.y} />
            {p.up === 0 && ticks.map((t) => <line class="sts-tickm" x1={t} x2={t} y1={y0 - 7} y2={y0 + 7} />)}
            <path class="sts-step" d={s.d} />
            <text class="sts-over" x={tread.x} y={tread.y} text-anchor="middle">1 over</text>
            {p.up !== 0 && <text class="sts-up" x={riserX} y={riserY}>{p.up > 0 ? `${p.up} up` : '1 down'}</text>}
            {p.up === 0 && <text class="sts-up" x={s.x + 10} y={y0 + 5}>0 up</text>}
          </svg>
          <p class="sts-label">{p.label}</p>
          {p.tag && <p class="sts-tag">{p.tag}</p>}
        </li>
      );
    })}
    <li class="sts-card sts-pos">
      <div class="sts-top">
        <span class="sts-num">4</span>
        <svg class="sts-knob" viewBox="-20 -20 40 40" aria-hidden="true">
          <circle r="16" class="sts-ring" />
          <path class="sts-arc" d={knob(2).d} />
          <line x1="0" y1="0" x2="0" y2="-12" class="sts-needle" transform={`rotate(${knob(2).ang})`} />
        </svg>
        <b class="sts-kv">+2</b>
      </div>
      <svg class="sts-pic" viewBox="0 0 240 190" role="img" aria-label="Part 1's sky to blue dial. With no sky the push toward blue is 0. With sky in the sentence it is 2.">
        <rect class="sts-sq" width="240" height="190" />
        <line class="sts-axisline" x1="40" y1="150" x2="226" y2="150" />
        <line class="sts-axisline" x1="40" y1="150" x2="40" y2="20" />
        <text class="sts-small" x="12" y="85" text-anchor="middle" transform="rotate(-90 12 85)">push toward blue</text>
        <line class="sts-slope" x1="70" y1="150" x2="190" y2="58" />
        <path class="sts-step" d="M70 150 H190 V58" />
        <circle class="sts-spot" cx="70" cy="150" r="6" />
        <circle class="sts-spot" cx="190" cy="58" r="6" />
        <text class="sts-small" x="70" y="170" text-anchor="middle">no "sky"</text>
        <text class="sts-small" x="190" y="170" text-anchor="middle">"sky" in it</text>
        <text class="sts-over" x="130" y="140" text-anchor="middle">1 over</text>
        <text class="sts-up" x="198" y="110">2 up</text>
      </svg>
      <p class="sts-label">Part 1's sky to blue dial. Same thing, with only one step.</p>
      <p class="sts-tag">the push comes before it turns into a percentage</p>
    </li>
  </ol>
  <figcaption>Slope means how far up you go for each step over. Every dial in part 1 was one. The values are made up. Part 1's percentages come after the push and don't follow a straight line.</figcaption>
</figure>

<style is:global>
  .sts p { margin: 0; }
  ol.sts-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 14px; }
  .sts-card { margin: 0 !important; padding: 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); display: grid; gap: 8px; align-content: start; }
  .sts-pos { --sts-c: var(--teal); }
  .sts-neg { --sts-c: var(--pink); }
  .sts-flat { --sts-c: var(--muted); }
  .sts-top { display: flex; align-items: center; gap: 10px; }
  .sts-num { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--card); border: 1px solid var(--line); font: 700 1rem/1 "Space Grotesk", sans-serif; }
  .sts-knob { width: 46px; height: 46px; margin-left: auto; }
  .sts-ring { fill: var(--card); stroke: var(--line); stroke-width: 2; }
  .sts-arc { fill: none; stroke: var(--teal); stroke-width: 3.5; stroke-linecap: round; }
  .sts-arc-neg { stroke: var(--pink); }
  .sts-needle { stroke: var(--text); stroke-width: 3; stroke-linecap: round; }
  .sts-kv { font: 700 1.3rem/1 ui-monospace, Menlo, monospace; min-width: 2em; color: var(--sts-c); }
  .sts-pic { width: 100%; max-width: 320px; height: auto; display: block; margin: 0 auto; }
  .sts-step { fill: none; stroke: var(--sts-c); stroke-width: 5; stroke-linejoin: round; stroke-linecap: round; }
  .sts-slope { stroke: var(--sts-c); stroke-width: 2; stroke-dasharray: 5 5; opacity: .6; }
  .sts-over, .sts-up { font: 700 17px "Space Grotesk", sans-serif; fill: var(--text); }
  .sts-small { font: 600 13px Inter, sans-serif; fill: var(--muted); }
  .sts-sq { fill: url(#sts-squares); }
  .sts-tickm { stroke: var(--sts-c); stroke-width: 3; }
  .sts-axisline { stroke: var(--line); stroke-width: 2; }
  .sts-spot { fill: var(--text); }
  .sts-label { font: 700 1.15rem/1.3 "Space Grotesk", sans-serif; }
  .sts-tag { font-size: 0.9rem; color: var(--muted); }
  @media (min-width: 640px) { ol.sts-grid { grid-template-columns: 1fr 1fr; } }
</style>
