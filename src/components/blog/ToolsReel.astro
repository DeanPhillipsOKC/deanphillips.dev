---
// The silent social video for the tools post (part 1 of "AI, plainly"). It is never shown to readers:
// the figure stays display:none unless a recording script sets data-reel on it, and it is aria-hidden.
// It retells ToolRelay's weather round trip in eight shots, one idea per shot, with big words on top:
// the question, the model's guesses turning into a note, the app spotting the note while the model stops,
// a tool doing the errand, the result pasted into the conversation, the model rereading and answering,
// the "what you see" view, and an end card. It uses the post's bands and colors (You teal, the model
// violet, the conversation as a card strip, the app and its tools gray and dashed, pasted lines amber).
//
// Everything is drawn as a pure function of time, so scripts/video/ai-plainly-tools-reel.mjs can record
// it frame by frame: it sets data-reel (or data-og for the link preview) and calls
// window.__toolsReel.draw(seconds). There is no loop and no timer, so reduced motion has nothing to stop,
// and without JavaScript nothing shows (the figure is hidden either way).
interface Q { chip: string; note: string; status: string; programLabel: string; result: string; answer: string }
interface Props { q: Q; guesses: [string, number][] }
const { q, guesses } = Astro.props;
---
<figure class="trl" aria-hidden="true" data-q={JSON.stringify(q)} data-guesses={JSON.stringify(guesses.slice(0, 3))}>
  <p class="trl-head"><span class="trl-h1"></span> <span class="trl-h2"></span></p>
  <div class="trl-stage">
    <section class="trl-band trl-you" data-band="you">
      <p class="trl-name"><b>You</b><em class="trl-now">Now</em></p>
      <div class="trl-slot" data-slot="ask"><p class="trl-bubble">{q.chip}</p></div>
      <div class="trl-slot" data-slot="status"><p class="trl-status">{q.status}</p></div>
      <div class="trl-slot" data-slot="answer"><p class="trl-answer"><span class="trl-answer-text"></span></p></div>
    </section>
    <section class="trl-band trl-model" data-band="model">
      <p class="trl-name"><b>The model</b><span>guesses text</span><em class="trl-now">Now</em></p>
      <div class="trl-slot" data-slot="mwait"><p class="trl-state">Waiting for your question</p></div>
      <div class="trl-slot" data-slot="bars">
        <p class="trl-ask">Its first guess <span>(made-up %)</span></p>
        <ul class="trl-bars"></ul>
      </div>
      <div class="trl-slot" data-slot="note"><p class="trl-note"><span class="trl-tag trl-tag-note">note</span><code class="trl-note-text"></code></p></div>
      <div class="trl-slot" data-slot="off"><p class="trl-state trl-off">Not running. Nothing is thinking while it waits.</p></div>
      <div class="trl-slot" data-slot="reread"><p class="trl-state trl-on">Running again. Rereading everything from the top.</p></div>
    </section>
    <section class="trl-band trl-conv" data-band="conv">
      <p class="trl-name"><b>The conversation</b><span class="trl-view">what the model reads</span><em class="trl-move trl-move-note">↓ the note</em><em class="trl-move trl-move-paste">↑ the result</em></p>
      <div class="trl-strip">
        <span class="trl-sweep"></span>
        <div class="trl-slot" data-slot="c-hidden"><p class="trl-line trl-line-hidden"><span class="trl-tag">hidden</span>A list of tools it can ask for (you never see it)</p></div>
        <div class="trl-slot" data-slot="c-q"><p class="trl-line"><span class="trl-tag trl-tag-you">You</span>{q.chip}</p></div>
        <div class="trl-slot" data-slot="c-note"><p class="trl-line trl-line-note"><span class="trl-tag trl-tag-note">note</span><code>{q.note}</code></p></div>
        <div class="trl-slot" data-slot="c-paste"><p class="trl-line trl-line-paste"><span class="trl-tag trl-tag-paste">pasted in</span><code>{q.result}</code></p></div>
        <div class="trl-slot" data-slot="c-answer"><p class="trl-line"><span class="trl-tag trl-tag-model">The model</span><span class="trl-c-answer"></span></p></div>
      </div>
    </section>
    <section class="trl-band trl-app" data-band="app">
      <p class="trl-name"><b>The app and its tools</b><span>ordinary code, no guessing</span><em class="trl-now">Now</em></p>
      <div class="trl-slot" data-slot="await"><p class="trl-state">Waiting for a note</p></div>
      <div class="trl-slot" data-slot="spot"><p class="trl-state trl-act">Spotted the note. Hands it to a search tool.</p></div>
      <div class="trl-slot" data-slot="work">
        <p class="trl-plabel">{q.programLabel}</p>
        <p class="trl-fill"><i></i></p>
      </div>
      <div class="trl-slot" data-slot="result"><p class="trl-result"><span class="trl-tag">result</span><code>{q.result}</code></p></div>
      <div class="trl-slot" data-slot="adone"><p class="trl-state">Done. Result pasted in.</p></div>
    </section>
  </div>
  <div class="trl-end">
    <p class="trl-end-1">It never touched the internet.</p>
    <p class="trl-end-2">It wrote a note and read the reply.</p>
    <p class="trl-end-3">AI, plainly · deanphillips.dev</p>
  </div>
  <p class="trl-foot">Weather and percentages made up for the demo</p>
</figure>

<script>
  type Q = { chip: string; note: string; status: string; programLabel: string; result: string; answer: string };
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const ease = (x: number) => 1 - (1 - clamp(x)) ** 3;
  // Fades in over [a, a + d] and, when b is given, out over [b, b + d].
  const win = (t: number, a: number, b = Infinity, d = 0.35) => Math.min(ease((t - a) / d), 1 - ease((t - b) / d));
  const type = (s: string, t: number, a: number, b: number) => s.slice(0, Math.round(s.length * clamp((t - a) / (b - a))));

  // The shots: start time, headline, an optional second headline sentence and when it appears.
  const SHOTS: [number, string, string?, number?][] = [
    [0, 'Can a chatbot really search the web?'],
    [3, 'It can only guess words.', 'So it writes a note.', 4.9],
    [7.5, 'The app spots the note. The model stops.'],
    [11, 'A tool does the actual errand.'],
    [14.5, 'The reply gets pasted into the chat.'],
    [18, 'The model runs again. It rereads everything.'],
    [23.5, 'You only ever see this part.'],
    [27.5, ''],
  ];
  const TOTAL = 32;

  const root = document.querySelector<HTMLElement>('.trl');
  if (root) {
    const q: Q = JSON.parse(root.dataset.q!);
    const guesses: [string, number][] = JSON.parse(root.dataset.guesses!);
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const h1 = $('.trl-h1'), h2 = $('.trl-h2'), stage = $('.trl-stage'), end = $('.trl-end');
    const bars = $('.trl-bars');
    const rows = guesses.map(([tok, p], i) => {
      const li = document.createElement('li');
      li.innerHTML = '<span class="trl-tok"></span><span class="trl-bar"><i></i></span><span class="trl-pct"></span>';
      li.querySelector('.trl-tok')!.textContent = tok;
      bars.append(li);
      return { li, bar: li.querySelector<HTMLElement>('i')!, pct: li.querySelector<HTMLElement>('.trl-pct')!, p, win: i === 0 };
    });
    const slots = new Map<string, HTMLElement>();
    for (const el of root.querySelectorAll<HTMLElement>('.trl-slot')) slots.set(el.dataset.slot!, el);
    const bands = new Map<string, HTMLElement>();
    for (const el of root.querySelectorAll<HTMLElement>('.trl-band')) bands.set(el.dataset.band!, el);
    let natural = new Map<string, number>();
    let measuredAt = -1;
    function measure() {
      measuredAt = root!.clientWidth;
      natural = new Map();
      // Measure with the answer fully typed, so its slots open to their full height.
      const typed = [...root!.querySelectorAll<HTMLElement>('.trl-answer-text, .trl-c-answer')];
      for (const el of typed) el.textContent = q.answer;
      $('.trl-note-text').textContent = q.note;
      for (const [k, el] of slots) { el.style.height = 'auto'; natural.set(k, el.scrollHeight); }
    }
    // A slot opens to its natural height as v goes from 0 to 1, and fades with it.
    function slot(k: string, v: number) {
      const el = slots.get(k)!;
      el.style.height = `${natural.get(k)! * v}px`;
      el.style.opacity = String(v);
    }
    function band(k: string, on: boolean, dimmed = 0.42) {
      const el = bands.get(k)!;
      el.classList.toggle('is-now', on);
      el.style.opacity = on || k === 'conv' ? '1' : String(dimmed);
    }

    function draw(t: number) {
      if (measuredAt !== root!.clientWidth) measure();
      t = Math.max(0, Math.min(TOTAL, t));
      let s = 0;
      while (s + 1 < SHOTS.length && t >= SHOTS[s + 1][0]) s++;
      const [a, head, second, at] = SHOTS[s];
      const b = s + 1 < SHOTS.length ? SHOTS[s + 1][0] : TOTAL;
      const hv = win(t, a + (s ? 0.1 : 0), b - 0.3, 0.3);
      h1.textContent = head;
      h1.style.opacity = String(s ? hv : 1);
      h2.textContent = second ?? '';
      h2.style.opacity = String(second ? Math.min(win(t, at!), hv) : 0);

      // Which band is acting.
      const now = t < 3 ? 'you' : t < 7.5 ? 'model' : t < 11 ? 'app' : t < 14.5 ? 'app' : t < 18 ? 'conv' : t < 23.5 ? 'model' : 'conv';
      for (const k of bands.keys()) band(k, k === now, t >= 23.5 && k !== 'conv' ? 0.3 : 0.42);
      bands.get('you')!.classList.toggle('is-now', now === 'you' || (t >= 20 && t < 23.5));
      if (t >= 20 && t < 23.5) bands.get('you')!.style.opacity = '1';
      bands.get('conv')!.classList.toggle('is-lit', now === 'conv');

      // You: the question, then the status line while the tool works, then the answer.
      slot('ask', win(t, 0.25, 7.6, 0.4));
      slot('status', win(t, 8.6, 19.6));
      slot('answer', win(t, 19.9));
      $('.trl-answer-text').textContent = type(q.answer, t, 20.1, 22.3);

      // The model: waiting, the first guess as bars, the note typing out, switched off, running again.
      slot('mwait', win(t, 0, 3, 0.3));
      slot('bars', win(t, 3.1, 6.9, 0.35));
      const grow = ease((t - 3.4) / 1.0);
      const picked = t > 4.6;
      for (const r of rows) {
        r.bar.style.width = `${r.p * grow}%`;
        r.pct.textContent = `${Math.round(r.p * grow)}%`;
        r.li.classList.toggle('trl-win', picked && r.win);
        r.li.classList.toggle('trl-lose', picked && !r.win);
      }
      slot('note', win(t, 4.9, 6.9, 0.35));
      $('.trl-note-text').textContent = type(q.note, t, 5.1, 6.4);
      slot('off', win(t, 7.7, 18, 0.35));
      slot('reread', win(t, 18.2, 23.5));
      bands.get('model')!.classList.toggle('is-off', t >= 7.5 && t < 18);

      // The conversation grows downward. In shot 7 the lines you never see fold away.
      const fold = 1 - ease((t - 24.3) / 0.7);
      slot('c-hidden', Math.min(win(t, 0.4), fold));
      slot('c-q', win(t, 0.9));
      slot('c-note', Math.min(win(t, 7.2), fold));
      slot('c-paste', Math.min(win(t, 15.35), fold));
      slot('c-answer', win(t, 19.9));
      $('.trl-c-answer').textContent = type(q.answer, t, 20.1, 22.3);
      $('.trl-view').textContent = t >= 24 ? 'what you see' : 'what the model reads';
      $<HTMLElement>('.trl-view').classList.toggle('is-you', t >= 24);
      $<HTMLElement>('.trl-move-note').style.opacity = String(win(t, 6.8, 8.6, 0.3));
      $<HTMLElement>('.trl-move-paste').style.opacity = String(win(t, 14.9, 17.4, 0.3));
      const sweep = $<HTMLElement>('.trl-sweep');
      const sp = (t - 18.4) / 1.5;
      sweep.style.opacity = sp > 0 && sp < 1 ? '1' : '0';
      sweep.style.top = `${clamp(sp) * 100}%`;
      // The newest line gets a highlight for a moment.
      for (const [k, from] of [['c-note', 7.2], ['c-paste', 15.35], ['c-answer', 19.9]] as const) {
        slots.get(k)!.classList.toggle('is-new', t >= from && t < from + 2.4);
      }

      // The app and its tools: waiting, spotting the note, doing the errand, done.
      slot('await', win(t, 0, 3, 0.3));
      slot('spot', win(t, 7.9, 11, 0.3));
      slot('work', win(t, 11.1, 15.0, 0.35));
      $<HTMLElement>('.trl-fill i').style.width = `${ease((t - 11.4) / 1.6) * 100}%`;
      slot('result', win(t, 13.1, 15.0, 0.35));
      slot('adone', win(t, 15.7, 18.2, 0.35));

      // The end card replaces the stage.
      const e = ease((t - 27.6) / 0.6);
      stage.style.opacity = String(1 - e);
      end.style.opacity = String(ease((t - 28.1) / 0.6));
      $<HTMLElement>('.trl-end-2').style.opacity = String(ease((t - 28.9) / 0.6));
      $<HTMLElement>('.trl-end-3').style.opacity = String(ease((t - 29.6) / 0.6));
      $<HTMLElement>('.trl-head').style.display = t >= 27.5 ? 'none' : '';
    }
    (window as any).__toolsReel = { draw, total: TOTAL };
  }
</script>

<style is:global>
  .trl { display: none; }
  body:has(.trl[data-reel], .trl[data-og]) header.top { display: none; }
  .trl[data-reel], .trl[data-og] {
    position: fixed; inset: 0; z-index: 2147483647; margin: 0 !important; max-width: none !important; width: 100vw; height: 100vh; box-sizing: border-box;
    padding: 6vw 5vw 4vw; display: flex; flex-direction: column; gap: 3vw; overflow: hidden; container-type: inline-size;
    color: var(--text); font: 500 3.4vw/1.3 Inter, sans-serif;
    background: radial-gradient(120% 70% at 0% 0%, color-mix(in srgb, var(--violet) 18%, transparent), transparent 60%),
      radial-gradient(100% 70% at 100% 100%, color-mix(in srgb, var(--teal) 16%, transparent), transparent 60%), var(--bg);
  }
  .trl p { margin: 0; }
  .trl-head { font: 700 6.2cqw/1.15 "Space Grotesk", sans-serif; letter-spacing: -0.02em; min-height: 2.3em; }
  .trl-head span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .trl-stage { display: flex; flex-direction: column; gap: 2cqw; }
  .trl-band { border: 1px solid var(--line); border-left: 1cqw solid var(--line); border-radius: 2cqw; padding: 1.8cqw 2.6cqw 2cqw; background: color-mix(in srgb, var(--card) 70%, transparent); }
  .trl-name { display: flex; align-items: baseline; gap: 1.6cqw; flex-wrap: wrap; font-size: 2.9cqw; color: var(--muted); }
  .trl-name b { font: 700 3.4cqw/1.2 "Space Grotesk", sans-serif; color: var(--text); }
  .trl-now { margin-left: auto; font: 800 2.4cqw/1 Inter, sans-serif; font-style: normal; letter-spacing: .08em; text-transform: uppercase; padding: 0.8cqw 1.4cqw; border-radius: 99px; background: var(--line); color: var(--text); visibility: hidden; }
  .trl-band.is-now .trl-now { visibility: visible; }
  .trl-you.is-now { border-left-color: var(--teal); } .trl-you.is-now .trl-now { background: var(--teal); color: var(--bg); }
  .trl-model.is-now { border-left-color: var(--violet); } .trl-model.is-now .trl-now { background: var(--violet); color: var(--bg); }
  .trl-app { background: var(--bg-2); border: 0.3cqw dashed var(--line); border-left: 1cqw dashed var(--line); }
  .trl-app.is-now { border-left: 1cqw solid var(--muted); } .trl-app.is-now .trl-now { background: var(--muted); color: var(--bg); }
  .trl-model.is-off { filter: grayscale(1); }
  .trl-slot { overflow: hidden; }
  .trl-slot > * { margin-top: 1.4cqw !important; }
  .trl-bubble { display: inline-block; padding: 1.4cqw 2.4cqw; border-radius: 2.4cqw; background: color-mix(in srgb, var(--teal) 18%, var(--card)); border: 0.3cqw solid var(--teal); font-size: 3.6cqw; }
  .trl-status { font-size: 3.4cqw; color: var(--muted); font-style: italic; }
  .trl-answer { font-size: 3.6cqw; font-weight: 600; min-height: 1.3em; }
  .trl-state { font-size: 3.4cqw; color: var(--muted); }
  .trl-off { color: var(--text); font-weight: 600; }
  .trl-on { color: var(--violet); font-weight: 600; }
  .trl-act { color: var(--text); font-weight: 600; }
  .trl-ask { font-size: 3cqw; color: var(--muted); } .trl-ask span { font-size: 2.6cqw; }
  .trl-bars { list-style: none; margin: 0.6cqw 0 0; padding: 0; display: grid; gap: 0.6cqw; }
  .trl-bars li { display: grid; grid-template-columns: 17cqw 1fr 9cqw; align-items: center; gap: 2cqw; font-size: 3.4cqw; transition: none; }
  .trl-tok { font: 600 3.4cqw/1.2 ui-monospace, Menlo, Consolas, monospace; }
  .trl-bar { height: 3cqw; background: var(--bg-2); border-radius: 99px; overflow: hidden; }
  .trl-bar i { display: block; height: 100%; background: var(--violet); border-radius: 99px; }
  .trl-pct { text-align: right; font-weight: 700; }
  .trl-bars li.trl-lose { opacity: 0.4; }
  .trl-bars li.trl-win .trl-tok { color: var(--violet); }
  .trl-note, .trl-result { display: inline-grid; gap: 0.8cqw; padding: 1.4cqw 5cqw 1.6cqw 2.2cqw; background: var(--card); border: 0.35cqw solid var(--violet); border-radius: 1cqw; position: relative; clip-path: polygon(0 0, calc(100% - 3cqw) 0, 100% 3cqw, 100% 100%, 0 100%); }
  .trl-note::after { content: ''; position: absolute; top: 0; right: 0; width: 3cqw; height: 3cqw; background: linear-gradient(45deg, var(--violet) 50%, transparent 50%); }
  .trl-result { border-color: var(--warn); clip-path: none; padding-right: 2.2cqw; }
  .trl code { font: 600 3.6cqw/1.3 ui-monospace, Menlo, Consolas, monospace; background: none; border: 0; padding: 0; color: var(--text); min-height: 1.3em; }
  .trl-tag { display: inline-block; font: 800 2.3cqw/1 Inter, sans-serif; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
  .trl-tag-note { color: var(--violet); } .trl-tag-paste { color: var(--warn); } .trl-tag-you { color: var(--teal); } .trl-tag-model { color: var(--violet); }
  .trl-view { font-weight: 600; } .trl-view.is-you { color: var(--teal); }
  .trl-move { font: 800 2.8cqw/1 Inter, sans-serif; font-style: normal; color: var(--violet); }
  .trl-move { position: absolute; top: 2.4cqw; right: 2.6cqw; } .trl-move-paste { color: var(--warn); }
  .trl-conv { position: relative; border-left-color: var(--line); background: var(--card); }
  .trl-conv.is-lit { border-left-color: var(--text); }
  .trl-strip { position: relative; }
  .trl-line { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 2cqw; row-gap: 0.4cqw; padding: 1.3cqw 2cqw; border-radius: 1cqw; background: var(--bg-2); border: 1px solid var(--line); font-size: 3.4cqw; }
  .trl-line code { font-size: 3.4cqw; }
  .trl-line-hidden { background: transparent; border: 0.3cqw dashed var(--line); color: var(--muted); }
  .trl-line-note { border: 0.35cqw solid var(--violet); }
  .trl-line-paste { border-left: 1cqw solid var(--warn); }
  .trl-slot.is-new .trl-line { background: color-mix(in srgb, var(--warn) 16%, var(--bg-2)); }
  .trl-sweep { position: absolute; left: -1cqw; right: -1cqw; height: 4cqw; margin-top: -2cqw; background: color-mix(in srgb, var(--violet) 35%, transparent); border-radius: 1cqw; z-index: 1; pointer-events: none; }
  .trl-plabel { font-size: 3.4cqw; font-weight: 600; }
  .trl-fill { height: 2.4cqw; margin-top: 1.2cqw !important; border-radius: 99px; background: var(--card); overflow: hidden; border: 1px solid var(--line); }
  .trl-fill i { display: block; height: 100%; background: var(--muted); }
  .trl-end { position: absolute; inset: 0; display: grid; align-content: center; gap: 3cqw; padding: 0 7cqw; opacity: 0; pointer-events: none; }
  .trl-end-1 { font: 700 8cqw/1.1 "Space Grotesk", sans-serif; letter-spacing: -0.02em; }
  .trl-end-2 { font: 700 6.2cqw/1.15 "Space Grotesk", sans-serif; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .trl-end-3 { margin-top: 4cqw !important; font: 600 3.6cqw/1.3 Inter, sans-serif; color: var(--muted); }
  .trl-foot { margin-top: auto !important; font-size: 2.4cqw; color: var(--muted); }
  /* The link preview: the headline, then only the model band at a size that fits 1200x630. */
  .trl[data-og] { padding: 3.4cqw 5cqw 2.6cqw; gap: 2cqw; display: grid; grid-template-columns: 1fr 1.15fr; grid-template-rows: 1fr auto; align-items: center; column-gap: 4cqw; }
  .trl[data-og] .trl-head { font-size: 4.6cqw; min-height: 0; grid-row: 1; }
  .trl[data-og] .trl-head .trl-h2 { display: block; margin-top: 2cqw; }
  .trl[data-og] .trl-stage { grid-row: 1; font-size: 0.7em; }
  .trl[data-og] .trl-band:not(.trl-model) { display: none; }
  .trl[data-og] .trl-end { display: none; }
  .trl[data-og] .trl-foot { grid-column: 1 / -1; font-size: 1.7cqw; }
  .trl[data-og] .trl-name { font-size: 2cqw; } .trl[data-og] .trl-name b { font-size: 2.6cqw; }
  .trl[data-og] .trl-bars li { grid-template-columns: 10cqw 1fr 6cqw; font-size: 2.4cqw; }
  .trl[data-og] .trl-tok, .trl[data-og] code { font-size: 2.6cqw; white-space: nowrap; }
  .trl[data-og] .trl-bar { height: 2cqw; }
  .trl[data-og] .trl-ask { font-size: 2.1cqw; } .trl[data-og] .trl-ask span { font-size: 1.8cqw; }
  .trl[data-og] .trl-tag, .trl[data-og] .trl-now { font-size: 1.6cqw; }
</style>
