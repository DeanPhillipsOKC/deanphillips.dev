---
// The silent social video for the tools post (part 2 of "AI, plainly"). It is never shown to readers:
// the figure stays display:none unless a recording script sets data-reel on it, and it is aria-hidden.
// It retells the post's main visual (TextThreads): the weather round trip as one-on-one text chats, one
// chat on screen at a time like a phone. You text the app. The app opens a new chat with the model, which
// has no memory, so the message carries everything, and the model replies with a note. The app texts the
// note to a tool and gets the result. Then another new chat with the model, empty again, where the app
// pastes in the whole conversation with the result highlighted, and the model answers. The app texts you
// back, and an end card says who did what. One big headline per beat on top (about 84px at 1080 wide),
// chat text about 43px, the post's avatars and colors (you teal, app amber, model violet, tool blue).
//
// Everything is drawn as a pure function of time, so scripts/video/ai-plainly-tools-reel.mjs can record
// it frame by frame: it sets data-reel (or data-og for the link preview) and calls
// window.__toolsReel.draw(seconds). There is no loop and no timer, so reduced motion has nothing to stop,
// and without JavaScript nothing shows (the figure is hidden either way). Each chat, message, and line
// carries its own times in data attributes: data-in/data-out for a chat, data-dots (the typing dots) and
// data-at (when it pops in) for a message, line, or pill, and data-type to type it out letter by letter instead.
interface Q { chip: string; note: string; status: string; programLabel: string; result: string; answer: string }
interface Props { q: Q; guesses?: [string, number][] }
const { q } = Astro.props;

type Who = 'you' | 'app' | 'model' | 'tool';
interface Line { tag?: string; text: string; code?: boolean; fresh?: boolean; at?: number }
interface Msg { who: Who; lines: Line[]; dots?: number; at: number; type?: [number, number] }
interface Chat { me: Who; them: Who; sub: string; hidden?: boolean; banner?: [string, number]; end?: [string, number, boolean?]; in: number; out: number; msgs: Msg[] }
const TOOLS = 'search the web, run code, read a shared file';
const CHATS: Chat[] = [
  { me: 'you', them: 'app', sub: 'your chat', in: -1, out: 3.8, msgs: [
    { who: 'you', at: 0, type: [0.1, 1.3], lines: [{ text: q.chip }] },
  ] },
  { me: 'app', them: 'model', sub: 'new chat', hidden: true, in: 3.8, out: 12.0,
    banner: ['No memory. Every message carries everything.', 4.4], end: ['Chat over. It keeps nothing.', 10.0, true], msgs: [
    { who: 'app', dots: 5.1, at: 5.7, lines: [{ tag: 'Tools', text: TOOLS }, { tag: 'You', text: q.chip }] },
    { who: 'model', dots: 7.4, at: 8.0, lines: [{ tag: 'Note', text: q.note, code: true }] },
  ] },
  { me: 'app', them: 'tool', sub: 'tool chat', hidden: true, in: 12.0, out: 16.2, msgs: [
    { who: 'app', dots: 12.5, at: 13.0, lines: [{ text: q.note, code: true }] },
    { who: 'tool', dots: 14.0, at: 14.6, lines: [{ tag: 'Result', text: q.result }] },
  ] },
  { me: 'app', them: 'model', sub: 'new chat', hidden: true, in: 16.2, out: 23.8,
    banner: ['New chat. Empty again.', 16.8], msgs: [
    { who: 'app', dots: 17.9, at: 18.4, lines: [
      { tag: 'Tools', text: TOOLS }, { tag: 'You', text: q.chip, at: 18.8 },
      { tag: 'Note', text: q.note, code: true, at: 19.2 }, { tag: 'Result', text: q.result, fresh: true, at: 19.8 },
    ] },
    { who: 'model', dots: 21.2, at: 21.9, lines: [{ text: q.answer }] },
  ] },
  { me: 'you', them: 'app', sub: 'your chat', in: 23.8, out: 28.0, msgs: [
    { who: 'you', at: -1, lines: [{ text: q.chip }] },
    { who: 'app', dots: 24.3, at: 24.9, lines: [{ text: q.answer }] },
  ], end: ['The other three chats happened out of sight.', 25.9] },
];
const NAME: Record<Who, string> = { you: 'You', app: 'The app', model: 'The model', tool: 'The tool' };
const ICON: Record<Who, string> = {
  you: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  app: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01M9 6.5h.01"/>',
  model: '<circle cx="12" cy="12" r="8"/><path d="M12 12l4-5"/><path d="M12 2v2M22 12h-2M2 12h2"/>',
  tool: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l6 6"/>',
};
const av = (w: Who) => `<svg viewBox="0 0 24 24" aria-hidden="true">${ICON[w]}</svg>`;
const whose = (w: Who) => (w === 'you' ? 'your' : `${NAME[w].toLowerCase()}'s`);
---
<figure class="trl" aria-hidden="true">
  <div class="trl-main">
    <div class="trl-head">
      <p class="trl-hl" data-layer="a"><span></span></p>
      <p class="trl-hl" data-layer="b"><span></span></p>
    </div>
    <div class="trl-stage">
      {CHATS.map((c) => (
        <section class={`trl-phone${c.hidden ? ' trl-hid' : ''}`} data-in={c.in} data-out={c.out}>
          <header class="trl-top">
            <span class={`trl-av trl-${c.them}`} set:html={av(c.them)} />
            <div class="trl-who">
              <p class="trl-name">{NAME[c.them]}</p>
              <p class="trl-sub">On {whose(c.me)} phone · {c.sub}</p>
            </div>
            {c.hidden && <span class="trl-hide">Hidden from you</span>}
          </header>
          <div class="trl-log">
            {c.banner && <p class="trl-banner trl-pop" data-at={c.banner[1]}>{c.banner[0]}</p>}
            {c.msgs.map((m) => (
              <>
                {m.dots !== undefined && (
                  <p class={`trl-dots trl-c-${m.who}${m.who === c.me ? ' trl-mine' : ''}`} data-from={m.dots} data-to={m.at}><i></i><i></i><i></i></p>
                )}
                <div class={`trl-msg trl-pop trl-c-${m.who}${m.who === c.me ? ' trl-mine' : ''}`} data-at={m.at} data-type={m.type?.join(',')}>
                  {m.lines.map((l) => (
                    <p class={`trl-line${l.fresh ? ' trl-fresh' : ''}${l.at !== undefined ? ' trl-pop' : ''}`} data-at={l.at}>
                      {l.tag && <span class="trl-tag">{l.tag}</span>}
                      {l.code ? <code data-text={l.text}>{l.text}</code> : <span data-text={l.text}>{l.text}</span>}
                    </p>
                  ))}
                </div>
              </>
            ))}
            {c.end && <p class={`trl-end-pill trl-pop${c.end[2] ? ' trl-over' : ''}`} data-at={c.end[1]}>{c.end[0]}</p>}
          </div>
        </section>
      ))}
    </div>
    <p class="trl-foot">The weather is made up for the demo.</p>
  </div>
  <div class="trl-end">
    <p class="trl-end-1">The model never touched the internet.</p>
    <p class="trl-end-2"><span>The app did the remembering and the errands.</span></p>
    <p class="trl-end-3">Part 2 of AI, plainly<br /><b>deanphillips.dev</b></p>
  </div>
</figure>

<script>
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const ease = (x: number) => 1 - (1 - clamp(x)) ** 3;
  // A small overshoot, so a message pops in like a text arriving.
  const pop = (x: number) => { const c = clamp(x); return 1 + 2.2 * (c - 1) ** 3 + 1.2 * (c - 1) ** 2; };

  // One big headline per beat: start time and words. An empty headline hands over to the end card.
  const SHOTS: [number, string][] = [
    [0, 'Can a chatbot really search the web?'],
    [3.8, 'The app opens a new chat with the model.'],
    [7.2, 'It replies with a note, not an answer.'],
    [9.8, 'Chat over. It keeps nothing.'],
    [12.0, 'The app texts the note to a tool.'],
    [13.8, 'The result comes back.'],
    [16.2, 'A new chat again. Empty.'],
    [17.9, 'The app pastes in the whole conversation.'],
    [21.0, 'Now the model can answer.'],
    [23.8, 'The app texts you back.'],
    [25.6, 'You only see this chat.'],
    [28.0, ''],
  ];
  const TOTAL = 34;
  const XF = 0.35; // headline crossfade
  const SLIDE = 0.5; // chat-to-chat slide

  const root = document.querySelector<HTMLElement>('.trl');
  if (root) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
    const main = $('.trl-main'), end = $('.trl-end');
    const layers = $$('.trl-hl');
    const phones = $$('.trl-phone');
    const num = (el: HTMLElement, k: string) => Number(el.dataset[k]);

    function headline(el: HTMLElement, s: number, v: number) {
      el.firstElementChild!.textContent = SHOTS[s][1];
      el.classList.toggle('is-hook', s === 0);
      el.style.opacity = String(v);
    }

    function draw(t: number) {
      t = Math.max(0, Math.min(TOTAL, t));
      const og = 'og' in root!.dataset;

      // Headline: the new line fades in over the old one, so the top never goes blank.
      let s = 0;
      while (s + 1 < SHOTS.length && t >= SHOTS[s + 1][0]) s++;
      if (og) s = 0;
      const into = s && !og ? ease((t - SHOTS[s][0]) / XF) : 1;
      headline(layers[0], s, into);
      if (s && into < 1) headline(layers[1], s - 1, 1 - into);
      else layers[1].style.opacity = '0';

      // Chats: the next one slides in from the right while the last one slides off to the left.
      for (const p of phones) {
        const a = num(p, 'in'), b = num(p, 'out');
        const e = ease((t - a) / SLIDE), l = ease((t - b) / SLIDE);
        const on = og ? p === phones[1] : t >= a && t < b + SLIDE;
        p.style.display = on ? '' : 'none';
        if (!on) continue;
        p.style.transform = og ? 'none' : `translateX(${(1 - e) * 108 - l * 108}%)`;
        p.style.opacity = og ? '1' : String(Math.min(0.3 + 0.7 * e, 1 - 0.7 * l));
        for (const el of $$('.trl-pop', p)) {
          const at = num(el, 'at');
          const k = (t - at) / 0.35;
          el.style.display = t >= at ? '' : 'none';
          el.style.transform = `scale(${0.7 + 0.3 * pop(k)})`;
          el.style.opacity = String(ease(k * 1.6));
        }
        for (const el of $$('.trl-dots', p)) {
          const on = t >= num(el, 'from') && t < num(el, 'to');
          el.style.display = on ? '' : 'none';
          $$('i', el).forEach((d, i) => { d.style.opacity = String(0.35 + 0.65 * Math.max(0, Math.sin((t * 7) - i * 0.9))); });
        }
        for (const el of $$('.trl-msg[data-type]', p)) {
          const [ta, tb] = el.dataset.type!.split(',').map(Number);
          for (const tx of $$('[data-text]', el)) {
            const full = tx.dataset.text!;
            const n = Math.round(full.length * clamp((t - ta) / (tb - ta)));
            // The untyped rest stays in place, invisible, so the bubble keeps its size while it types.
            tx.innerHTML = '';
            tx.append(full.slice(0, n));
            const rest = document.createElement('span');
            rest.className = 'trl-ghost';
            rest.textContent = full.slice(n);
            tx.append(rest);
          }
        }
        // Once a chat is over, its messages fade back: the model keeps nothing.
        const endPill = p.querySelector<HTMLElement>('.trl-over');
        const over = endPill ? ease((t - num(endPill, 'at')) / 0.5) : 0;
        for (const el of $$('.trl-msg, .trl-banner', p)) el.style.filter = over ? `opacity(${1 - 0.55 * over}) grayscale(${over})` : '';
        // The pasted-in result glows for a moment when it lands.
        for (const el of $$('.trl-fresh', p)) el.classList.toggle('is-glow', t >= num(el, 'at') && t < num(el, 'at') + 1.6);
      }

      // The end card replaces the chats.
      const e = ease((t - 27.8) / 0.5);
      main.style.opacity = String(og ? 1 : 1 - e);
      end.style.opacity = String(og ? 0 : ease((t - 28.1) / 0.5));
      $<HTMLElement>('.trl-end-1').style.opacity = String(ease((t - 28.2) / 0.5));
      $<HTMLElement>('.trl-end-2').style.opacity = String(ease((t - 29.3) / 0.5));
      $<HTMLElement>('.trl-end-3').style.opacity = String(ease((t - 30.5) / 0.5));
    }
    (window as any).__toolsReel = { draw, total: TOTAL };
  }
</script>

<style is:global>
  .trl { display: none; }
  body:has(.trl[data-reel], .trl[data-og]) header.top { display: none; }
  .trl[data-reel], .trl[data-og] {
    position: fixed; inset: 0; z-index: 2147483647; margin: 0 !important; max-width: none !important; width: 100vw; height: 100vh; box-sizing: border-box;
    padding: 4cqw 4.4cqw 3cqw; display: flex; flex-direction: column; overflow: hidden; container-type: inline-size;
    color: var(--text); font: 500 4cqw/1.3 Inter, sans-serif;
    background: radial-gradient(120% 70% at 0% 0%, color-mix(in srgb, var(--violet) 16%, transparent), transparent 60%),
      radial-gradient(100% 70% at 100% 100%, color-mix(in srgb, var(--teal) 14%, transparent), transparent 60%), var(--bg);
  }
  .trl p { margin: 0; }
  .trl-main { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; }
  .trl-head { display: grid; align-items: end; min-height: 18.2cqw; margin-bottom: 3cqw; }
  .trl-hl { grid-area: 1 / 1; font: 700 8.2cqw/1.1 "Space Grotesk", sans-serif; letter-spacing: -0.02em; color: var(--text); }
  .trl-hl.is-hook span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .trl-stage { position: relative; flex: none; height: 90.5cqw; overflow: hidden; border-radius: 3.4cqw; }
  .trl-phone { position: absolute; inset: 0; display: flex; flex-direction: column; border-radius: 3.4cqw; border: 0.3cqw solid var(--line); background: var(--bg-2); overflow: hidden; }
  .trl-hid { border-style: dashed; border-color: var(--muted); }
  .trl-top { display: flex; align-items: center; gap: 2.4cqw; padding: 2.4cqw 3cqw; background: var(--card); border-bottom: 0.2cqw solid var(--line); }
  .trl-who { flex: 1; min-width: 0; }
  .trl-name { font: 700 4.8cqw/1.15 "Space Grotesk", sans-serif; }
  .trl-sub { font-size: 3cqw; font-weight: 600; color: var(--muted); }
  .trl-hide { flex: none; font: 700 2.7cqw/1.2 Inter, sans-serif; letter-spacing: .05em; text-transform: uppercase; color: var(--text); padding: 1cqw 2cqw; border: 0.25cqw dashed var(--muted); border-radius: 99px; }
  .trl-av { flex: none; width: 9cqw; height: 9cqw; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--c) 22%, var(--card)); border: 0.45cqw solid var(--c); }
  .trl-av svg { width: 5cqw; height: 5cqw; fill: none; stroke: var(--c); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .trl-you, .trl-c-you { --c: var(--teal); }
  .trl-app, .trl-c-app { --c: var(--warn); }
  .trl-model, .trl-c-model { --c: var(--violet); }
  .trl-tool, .trl-c-tool { --c: #4b93f0; }
  .trl-log { display: flex; flex-direction: column; gap: 2cqw; padding: 2.6cqw 3cqw; }
  .trl-msg, .trl-dots { align-self: flex-start; max-width: 90%; min-width: 0; box-sizing: border-box; padding: 2cqw 3cqw; border-radius: 3.6cqw 3.6cqw 3.6cqw 0.8cqw; background: color-mix(in srgb, var(--c) 15%, var(--card)); border: 0.3cqw solid color-mix(in srgb, var(--c) 55%, transparent); transform-origin: 0% 100%; }
  .trl-mine { align-self: flex-end; border-radius: 3.6cqw 3.6cqw 0.8cqw 3.6cqw; background: color-mix(in srgb, var(--c) 28%, var(--card)); transform-origin: 100% 100%; }
  .trl-msg { display: flex; flex-direction: column; gap: 1.2cqw; }
  .trl-line { font-size: 4.3cqw; line-height: 1.3; overflow-wrap: anywhere; transform-origin: 0 50%; }
  .trl-ghost { opacity: 0; }
  .trl-fresh { margin: 0 -1.2cqw !important; padding: 0.6cqw 1.2cqw; border-radius: 1.4cqw; background: color-mix(in srgb, var(--warn) 22%, transparent); outline: 0.3cqw solid color-mix(in srgb, var(--warn) 75%, transparent); }
  .trl-fresh.is-glow { box-shadow: 0 0 0 1cqw color-mix(in srgb, var(--warn) 30%, transparent); }
  .trl-tag { display: inline-block; margin-right: 1.6cqw; padding: 0.3cqw 1.2cqw; border-radius: 1cqw; font: 800 2.6cqw/1.4 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; background: var(--bg-2); border: 0.2cqw solid var(--line); color: var(--muted); vertical-align: 0.5cqw; }
  .trl-fresh .trl-tag { color: var(--warn); border-color: var(--warn); }
  .trl code { font: 600 4.1cqw/1.3 "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace; background: none; border: 0; padding: 0; color: var(--text); }
  .trl-dots { display: flex; gap: 1.4cqw; padding: 2.6cqw 3.4cqw; }
  .trl-dots i { width: 2cqw; height: 2cqw; border-radius: 50%; background: var(--c); }
  .trl-banner { align-self: center; text-align: center; font: 700 3.5cqw/1.3 Inter, sans-serif; color: var(--text); padding: 1.6cqw 3cqw; border-radius: 2.6cqw; background: color-mix(in srgb, var(--violet) 16%, var(--card)); border: 0.3cqw dashed color-mix(in srgb, var(--violet) 70%, transparent); max-width: 92%; box-sizing: border-box; }
  .trl-end-pill { align-self: center; text-align: center; font: 700 3.5cqw/1.3 Inter, sans-serif; color: var(--text); padding: 1.2cqw 3.4cqw; border-radius: 99px; background: var(--card); border: 0.3cqw solid var(--muted); }
  .trl-foot { margin-top: 2cqw !important; font-size: 3cqw; font-weight: 600; color: var(--muted); }
  .trl-end { position: absolute; inset: 0; display: grid; align-content: center; gap: 5cqw; padding: 0 7cqw; opacity: 0; pointer-events: none; }
  .trl-end-1 { font: 700 9cqw/1.08 "Space Grotesk", sans-serif; letter-spacing: -0.02em; }
  .trl-end-2 { font: 700 7.2cqw/1.12 "Space Grotesk", sans-serif; letter-spacing: -0.01em; }
  .trl-end-2 span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .trl-end-3 { margin-top: 4cqw !important; font: 600 4.4cqw/1.4 Inter, sans-serif; color: var(--muted); }
  .trl-end-3 b { font: 700 6cqw/1.3 "Space Grotesk", sans-serif; color: var(--text); }
  /* The link preview (1200x630): the hook on the left, the model's chat with its note on the right. */
  .trl[data-og] { padding: 3.6cqw 4.4cqw 2.4cqw; font-size: 2.2cqw; }
  .trl[data-og] .trl-stage { height: auto; flex: 1; }
  .trl[data-og] .trl-main { display: grid; grid-template-columns: 1fr 1.25fr; grid-template-rows: 1fr auto; column-gap: 4cqw; }
  .trl[data-og] .trl-head { min-height: 0; margin: 0; align-items: center; }
  .trl[data-og] .trl-hl { font-size: 5.6cqw; }
  .trl[data-og] .trl-stage { border-radius: 2cqw; }
  .trl[data-og] .trl-phone { border-radius: 2cqw; border-width: 0.2cqw; }
  .trl[data-og] .trl-top { padding: 1.2cqw 1.8cqw; gap: 1.4cqw; }
  .trl[data-og] .trl-av { width: 4.6cqw; height: 4.6cqw; border-width: 0.25cqw; } .trl[data-og] .trl-av svg { width: 2.6cqw; height: 2.6cqw; }
  .trl[data-og] .trl-name { font-size: 2.6cqw; } .trl[data-og] .trl-sub { font-size: 1.6cqw; }
  .trl[data-og] .trl-hide { font-size: 1.4cqw; padding: 0.5cqw 1.1cqw; border-width: 0.15cqw; }
  .trl[data-og] .trl-log { gap: 1.3cqw; padding: 1.6cqw 1.8cqw; }
  .trl[data-og] .trl-msg { padding: 1.1cqw 1.7cqw; gap: 0.6cqw; border-width: 0.2cqw; border-radius: 2cqw 2cqw 2cqw 0.5cqw; }
  .trl[data-og] .trl-mine { border-radius: 2cqw 2cqw 0.5cqw 2cqw; }
  .trl[data-og] .trl-line { font-size: 2.2cqw; } .trl[data-og] code { font-size: 2.2cqw; white-space: nowrap; }
  .trl[data-og] .trl-msg { max-width: 94%; }
  .trl[data-og] .trl-tag { font-size: 1.4cqw; margin-right: 1cqw; border-width: 0.12cqw; vertical-align: 0.2cqw; }
  .trl[data-og] .trl-banner, .trl[data-og] .trl-end-pill { font-size: 1.9cqw; padding: 0.8cqw 1.8cqw; border-width: 0.2cqw; }
  .trl[data-og] .trl-foot { grid-column: 1 / -1; font-size: 1.6cqw; margin-top: 1.4cqw !important; }
  .trl[data-og] .trl-end { display: none; }
</style>
