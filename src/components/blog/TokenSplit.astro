---
// Step one of inference: text is chopped into tokens, and each token becomes a number. The reader types
// anything and watches it split. This is a toy splitter (common words stay whole, long ones break at
// familiar endings and into chunks), not a real tokenizer, and the ID numbers are made up from a hash.
// The caption says so. Without JavaScript, the starting sentence shows pre-split.
interface Props { text: string; caption?: string }
const { text, caption } = Astro.props;
---
<figure class="tks panel bleed" data-text={text}>
  <label class="tks-label" for="tks-in">Type anything</label>
  <input id="tks-in" class="tks-in" type="text" value={text} maxlength="120" autocomplete="off" spellcheck="false" />
  <p class="tks-row-label">Tokens</p>
  <p class="tks-chips" aria-live="polite">{text}</p>
  <p class="tks-row-label">What the model actually sees</p>
  <p class="tks-ids"></p>
  <p class="tks-sum"></p>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const COMMON = new Set('the a an and or but of to in on at by for with from is are was were be been it its this that these those i you he she we they me my your our their not no yes so if as up out do did does have has had will can just what why how who when where all some more most very little big small happy sad trees tree sky blue paint painting light dog cat car sun water good bad new old day time year way man woman people one two three like make made get got go see say said know think about over into after before than then them there here also only even back well much any many such long'.split(' '));
  const SUFFIX = ['ingly', 'ably', 'ation', 'ness', 'ment', 'able', 'ing', 'ful', 'est', 'ed', 'ly', 'er', 's'];
  const PREFIX = ['un', 're', 'pre', 'over', 'out'];

  function word(w: string): string[] {
    const low = w.toLowerCase();
    if (low.length <= 3 || COMMON.has(low)) return [w];
    const out: string[] = [];
    let core = w, end = '';
    for (const p of PREFIX) if (low.startsWith(p) && low.length - p.length >= 4) { out.push(w.slice(0, p.length)); core = w.slice(p.length); break; }
    for (const s of SUFFIX) if (core.toLowerCase().endsWith(s) && core.length - s.length >= 3) { end = core.slice(-s.length); core = core.slice(0, -s.length); break; }
    if (COMMON.has(core.toLowerCase()) || core.length <= 7) out.push(core);
    else for (let i = 0; i < core.length; i += 4) out.push(core.slice(i, i + 4));
    if (end) out.push(end);
    return out;
  }
  // Like real tokenizers, the space before a word rides along with its first piece.
  function split(text: string): string[] {
    const toks: string[] = [];
    for (const m of text.matchAll(/(\s*)([A-Za-z']+|\d{1,3}|[^\sA-Za-z\d])/g)) {
      const pieces = /[A-Za-z]/.test(m[2]) ? word(m[2]) : [m[2]];
      pieces.forEach((p, i) => toks.push((i === 0 && m[1] ? ' ' : '') + p));
    }
    return toks;
  }
  const id = (t: string) => { let h = 2166136261; for (const c of t) h = Math.imul(h ^ c.charCodeAt(0), 16777619); return (h >>> 0) % 50000 + 200; };
  const HUES = ['var(--teal)', 'var(--violet)', 'var(--warn)', 'var(--pink)', 'var(--ok)'];

  for (const root of document.querySelectorAll<HTMLElement>('.tks')) {
    const input = root.querySelector<HTMLInputElement>('.tks-in')!;
    const chips = root.querySelector<HTMLElement>('.tks-chips')!, ids = root.querySelector<HTMLElement>('.tks-ids')!, sum = root.querySelector<HTMLElement>('.tks-sum')!;
    const draw = () => {
      const toks = split(input.value);
      chips.replaceChildren(); ids.replaceChildren();
      toks.forEach((t, i) => {
        const c = document.createElement('span');
        c.className = 'tks-chip';
        c.style.setProperty('--c', HUES[i % HUES.length]);
        c.style.animationDelay = `${i * 40}ms`;
        c.textContent = t.replace(/^ /, '␣');
        chips.append(c);
        const n = document.createElement('span');
        n.className = 'tks-id';
        n.style.setProperty('--c', HUES[i % HUES.length]);
        n.textContent = String(id(t));
        ids.append(n);
      });
      const words = (input.value.match(/[A-Za-z']+|\d+/g) || []).length;
      sum.textContent = toks.length ? `${words} ${words === 1 ? 'word' : 'words'} became ${toks.length} tokens.` : '';
    };
    input.addEventListener('input', draw);
    draw();
  }
</script>

<style is:global>
  .tks p { margin: 0; }
  .tks-label, .tks-row-label { display: block; font: 600 0.75rem/1.3 Inter, sans-serif; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .tks-row-label { margin-top: 18px !important; }
  .tks-in { width: 100%; box-sizing: border-box; font: 500 1.05rem/1.4 Inter, sans-serif; padding: 12px 14px; border-radius: 12px; border: 2px solid var(--line); background: var(--bg-2); color: var(--text); }
  .tks-in:focus { outline: none; border-color: var(--teal); }
  .tks-chips, .tks-ids { display: flex; flex-wrap: wrap; gap: 6px; }
  .tks-chip { font: 600 1.05rem/1 "Space Grotesk", sans-serif; white-space: pre; padding: 7px 9px; border-radius: 8px; border: 1px solid color-mix(in srgb, var(--c) 60%, transparent); background: color-mix(in srgb, var(--c) 16%, transparent); animation: tks-in .3s ease-out backwards; }
  .tks-id { font: 600 0.82rem/1 ui-monospace, Menlo, monospace; padding: 6px 7px; border-radius: 6px; color: var(--c); background: var(--bg-2); }
  .tks-sum { margin-top: 14px !important; font-size: 0.95rem; color: var(--muted); }
  @keyframes tks-in { from { opacity: 0; transform: translateY(6px) scale(.9); } }
  @media (prefers-reduced-motion: reduce) { .tks-chip { animation: none; } }
</style>
