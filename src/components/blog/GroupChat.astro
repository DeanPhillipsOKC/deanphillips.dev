---
// One tool round trip as a group chat, seen from the user's phone. Four members: you, the app, the
// model, and a tool. Your messages sit on the right, everyone else's on the left with an avatar, a name,
// and who the message is for. Thought bubbles (dashed clouds) show what a member is holding in memory:
// the app keeps the conversation, and the model holds only what it was just handed. Grey event lines
// mark when the model starts and stops running. Messages a real chat app would hide from you are tagged
// "hidden from you". A still picture read top to bottom. Messages fade in once on scroll unless the
// reader prefers less motion, and everything shows without JavaScript.
type Who = 'you' | 'app' | 'model' | 'tool';
interface Line { tag?: string; text: string; code?: boolean; fresh?: boolean }
interface Item { kind: 'msg' | 'think' | 'event'; who?: Who; to?: Who; hidden?: boolean; text?: string; lines?: Line[] }
interface Props { title: string; items: Item[]; others?: { label: string; note: string }[]; caption?: string }
const { title, items, others = [], caption } = Astro.props;
const NAME: Record<Who, string> = { you: 'You', app: 'The app', model: 'The model', tool: 'The tool' };
const ICON: Record<Who, string> = {
  you: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  app: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01M9 6.5h.01"/>',
  model: '<circle cx="12" cy="12" r="8"/><path d="M12 12l4-5"/><path d="M12 2v2M22 12h-2M2 12h2"/>',
  tool: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l6 6"/>',
};
const av = (w: Who) => `<svg viewBox="0 0 24 24" aria-hidden="true">${ICON[w]}</svg>`;
const members: Who[] = ['you', 'app', 'model', 'tool'];
---
<figure class="gc panel bleed">
  <div class="gc-phone">
    <header class="gc-head">
      <div class="gc-faces">{members.map((m) => <span class={`gc-av gc-${m}`} set:html={av(m)} />)}</div>
      <p class="gc-title">{title}</p>
      <p class="gc-members">{members.map((m) => NAME[m]).join(', ')}</p>
    </header>
    <ol class="gc-log">
      {items.map((it, i) => {
        if (it.kind === 'event') return <li class="gc-event" style={`--i:${i}`}><span>{it.text}</span></li>;
        const w = it.who!;
        const mine = w === 'you';
        const think = it.kind === 'think';
        return (
          <li class={`gc-row${mine ? ' gc-mine' : ''}${it.hidden ? ' gc-hid' : ''} gc-c-${w}`} style={`--i:${i}`}>
            {!mine && <span class={`gc-av gc-${w}`} set:html={av(w)} />}
            <div class={think ? 'gc-think' : 'gc-bub'}>
              <p class="gc-who">
                {think ? <>{NAME[w]} is holding</> : <>{NAME[w]}{it.to && <> to {NAME[it.to].toLowerCase()}</>}</>}
                {it.hidden && <span class="gc-hide">hidden from you</span>}
              </p>
              {it.lines!.map((l) => <p class={`gc-line${l.fresh ? ' gc-fresh' : ''}`}>{l.tag && <span class="gc-tag">{l.tag}</span>}{l.code ? <code>{l.text}</code> : l.text}</p>)}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
  {others.length > 0 && (
    <div class="gc-others">
      <p class="gc-oh">Every tool makes the same trip. Only the note changes.</p>
      <ul>{others.map((o) => <li><b>{o.label}</b><code>{o.note}</code></li>)}</ul>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.gc')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    const rows = [...root.querySelectorAll<HTMLElement>('.gc-log > li')];
    rows.forEach((el) => el.classList.add('gc-wait'));
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.remove('gc-wait'); io.unobserve(e.target); }
    }, { threshold: 0.3 });
    rows.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  .gc p { margin: 0; }
  .gc-phone { max-width: 560px; margin: 0 auto; border-radius: 22px; border: 1px solid var(--line); background: var(--bg-2); overflow: hidden; }
  .gc-head { display: grid; justify-items: center; gap: 4px; padding: 14px 12px 12px; border-bottom: 1px solid var(--line); background: var(--card); }
  .gc-faces { display: flex; }
  .gc-faces .gc-av { margin-left: -8px; border-color: var(--card); }
  .gc-faces .gc-av:first-child { margin-left: 0; }
  .gc-title { font: 700 1.05rem/1.3 "Space Grotesk", sans-serif; }
  .gc-members { font-size: 0.8rem; color: var(--muted); }
  .gc-log { list-style: none; margin: 0; padding: 14px 12px 16px; display: grid; gap: 10px; }
  .gc-log > li { transition: opacity .45s ease, transform .45s ease; }
  .gc-log > li.gc-wait { opacity: 0; transform: translateY(10px); }
  .gc-row { display: flex; gap: 8px; align-items: flex-end; max-width: 88%; }
  .gc-mine { margin-left: auto; justify-content: flex-end; }
  .gc-av { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--c) 22%, var(--card)); border: 2px solid var(--c); }
  .gc-av svg { width: 19px; height: 19px; fill: none; stroke: var(--c); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .gc-you, .gc-c-you { --c: var(--teal); }
  .gc-app, .gc-c-app { --c: var(--warn); }
  .gc-model, .gc-c-model { --c: var(--violet); }
  .gc-tool, .gc-c-tool { --c: #4b93f0; }
  .gc-bub { display: grid; gap: 5px; min-width: 0; padding: 8px 12px 10px; border-radius: 16px 16px 16px 4px; background: color-mix(in srgb, var(--c) 15%, var(--card)); border: 1.5px solid color-mix(in srgb, var(--c) 55%, transparent); }
  .gc-mine .gc-bub { border-radius: 16px 16px 4px 16px; background: color-mix(in srgb, var(--teal) 30%, var(--card)); }
  .gc-hid .gc-bub { border-style: dashed; }
  .gc-think { position: relative; display: grid; gap: 4px; min-width: 0; padding: 8px 14px 10px; border-radius: 20px; border: 1.5px dashed var(--muted); background: var(--card); margin-left: 10px; }
  .gc-think::before, .gc-think::after { content: ''; position: absolute; border: 1.5px dashed var(--muted); border-radius: 50%; background: var(--card); }
  .gc-think::before { width: 11px; height: 11px; left: -12px; bottom: 6px; }
  .gc-think::after { width: 6px; height: 6px; left: -20px; bottom: 2px; }
  .gc-think .gc-line { font-style: italic; }
  .gc-who { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; font: 700 0.74rem/1.3 Inter, sans-serif; color: var(--c); }
  .gc-think .gc-who { color: var(--muted); }
  .gc-hide { font: 600 0.66rem/1.4 Inter, sans-serif; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); padding: 0 6px; border: 1px dashed var(--line); border-radius: 999px; }
  .gc-line { font-size: 0.97rem; line-height: 1.4; overflow-wrap: anywhere; }
  .gc-fresh { background: color-mix(in srgb, var(--warn) 16%, transparent); outline: 1px solid color-mix(in srgb, var(--warn) 55%, transparent); border-radius: 6px; padding: 2px 6px; }
  .gc-tag { display: inline-block; margin-right: 6px; padding: 1px 6px; border-radius: 5px; font: 700 0.64rem/1.5 Inter, sans-serif; font-style: normal; letter-spacing: .06em; text-transform: uppercase; background: var(--bg-2); border: 1px solid var(--line); color: var(--muted); vertical-align: 1px; }
  .gc code { font: 600 0.93rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .gc-event { text-align: center; }
  .gc-event span { display: inline-block; font: 600 0.78rem/1.35 Inter, sans-serif; color: var(--muted); padding: 4px 12px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); }
  .gc-others { max-width: 560px; margin: 14px auto 0; display: grid; gap: 10px; }
  .gc-oh { font: 700 1rem/1.35 "Space Grotesk", sans-serif; }
  .gc-others ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .gc-others li { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; padding: 10px 12px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); }
  .gc-others b { font: 700 0.95rem/1.3 "Space Grotesk", sans-serif; min-width: 7em; }
  @media (prefers-reduced-motion: reduce) { .gc-log > li { transition: none; } }
  @media (max-width: 560px) {
    .gc-log { padding: 12px 8px 14px; }
    .gc-row { max-width: 94%; }
    .gc-line { font-size: 0.93rem; }
  }
</style>
