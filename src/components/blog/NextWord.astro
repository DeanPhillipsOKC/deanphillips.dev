---
// The post's opening animation: an AI answer being written one token at a time. For each guess, the
// candidate next tokens grow as bars, one gets picked (usually the top one, once not), and it pops onto
// the end of the answer. Then the whole answer is read again for the next guess. The percentages are
// made up to show the idea, and the caption says so.
//
// Drawn as a pure function of time, so scripts/video/next-word-reel.mjs can record it frame by frame:
// it sets data-reel on the figure (the loop stops) and calls window.__nextWord.draw(seconds).
// Without JavaScript, or with reduced motion, it shows the finished answer and the last guess.
//
// Optional props (all default to the inference post's wording, so leaving them out changes nothing):
// whoLabel names the answer row, doneText replaces "and that's the answer.", reelTop and reelEnd are the
// reel's headline and takeaway, mono shows the picks as monospace text in a violet "note" chip (for a
// tool request, which is guessed text too), answerNote is a small callout under the answer row, and
// firstNote is a callout shown on the first guess once it's picked. holdFirst (off by default) stops on
// guess 1 with the bars empty and asks the reader to pick what they would write first (or tap "Show
// me"). Then guess 1 plays and holds three times as long, and firstNote stays pinned under the answer
// until the answer is done.
interface Step { pick: string; options: [string, number][] }
interface Props {
  question: string; steps: Step[]; caption?: string;
  whoLabel?: string; doneText?: string; reelTop?: string; reelEnd?: string; mono?: boolean; answerNote?: string; firstNote?: string; holdFirst?: boolean;
}
const { question, steps, caption, whoLabel = 'The AI', doneText, reelTop = 'This is how an AI answers you.', reelEnd = 'One guess at a time.', mono = false, answerNote, firstNote, holdFirst = false } = Astro.props;
const answer = steps.map((s) => s.pick).join('');
const last = steps[steps.length - 1];
---
<figure class={`nw panel bleed${mono ? ' nw-mono' : ''}`} data-steps={JSON.stringify(steps)} data-done={doneText} data-first={firstNote} data-hold={holdFirst ? '1' : undefined}>
  <p class="nw-reel-top" aria-hidden="true">{reelTop}</p>
  <div class="nw-stage">
    <p class="nw-q"><span class="nw-who">You asked</span><span class="nw-qtext">{question}</span></p>
    <p class="nw-a"><span class="nw-who">{whoLabel}</span><span class="nw-atext">{answer}</span><span class="nw-cursor" aria-hidden="true"></span></p>
    {holdFirst && firstNote && <p class="nw-pin" hidden>{firstNote}</p>}
    {answerNote && <p class="nw-anote">{answerNote}</p>}
    <div class="nw-guess">
      <p class="nw-head"><span class="nw-n">Guess {steps.length}</span> <span class="nw-what">what comes next?</span></p>
      <ol class="nw-bars">
        {last.options.map(([tok, pct], i) => (
          <li class={i === 0 ? 'chosen' : ''}><span class="nw-tok">{tok.trim() || tok}</span><span class="nw-bar"><i style={`width:${pct}%`}></i></span><span class="nw-pct">{pct}%</span></li>
        ))}
      </ol>
      <p class="nw-note" aria-live="off"></p>
      {holdFirst && (
        <div class="nw-ask" hidden>
          <p class="nw-ask-q">Your turn. What would you write first?</p>
          <div class="nw-ask-btns">
            {steps[0].options.map(([tok]) => <button type="button" class="nw-ask-opt" data-tok={tok}>{tok.trim() || tok}</button>)}
            <button type="button" class="nw-ask-show">Show me</button>
          </div>
        </div>
      )}
      {holdFirst && <p class="nw-yours" hidden></p>}
    </div>
  </div>
  <p class="nw-reel-end" aria-hidden="true">{reelEnd}<span>deanphillips.dev</span></p>
  <button type="button" class="nw-pause" hidden>Pause</button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  type Step = { pick: string; options: [string, number][] };
  const D = 2.2; // seconds per guess (slow enough for someone who has never seen this)
  const HOLD = 3.2; // the finished answer stays up this long before the loop restarts
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const ease = (t: number) => 1 - (1 - t) ** 3;

  for (const root of document.querySelectorAll<HTMLElement>('.nw')) setup(root);

  function setup(root: HTMLElement) {
    const steps: Step[] = JSON.parse(root.dataset.steps!);
    const doneText = root.dataset.done ?? 'and that’s the answer.';
    const firstNote = root.dataset.first ?? '';
    const hold = root.dataset.hold === '1';
    // With holdFirst, guess 1 plays at normal speed and then stays up for two more guesses' worth of time.
    const EXTRA = hold ? 2 * D : 0;
    const total = steps.length * D + HOLD + EXTRA;
    const warp = (t: number) => (t < D ? t : t < D + EXTRA ? D - 0.001 : t - EXTRA);
    const pin = root.querySelector<HTMLElement>('.nw-pin');
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const atext = $('.nw-atext'), n = $('.nw-n'), what = $('.nw-what'), bars = $('.nw-bars'), note = $('.nw-note');
    const guess = $('.nw-guess'), pause = $<HTMLButtonElement>('.nw-pause');
    const endNote = $('.nw-reel-end');

    // One row per candidate, rebuilt when the guess changes.
    let shown = -1;
    let rows: { li: HTMLElement; bar: HTMLElement; pct: HTMLElement; p: number }[] = [];
    function build(k: number) {
      shown = k;
      bars.replaceChildren();
      rows = steps[k].options.map(([tok, p]) => {
        const li = document.createElement('li');
        li.innerHTML = `<span class="nw-tok"></span><span class="nw-bar"><i></i></span><span class="nw-pct"></span>`;
        li.querySelector('.nw-tok')!.textContent = tok.trim() || tok;
        if (tok === steps[k].pick) li.dataset.pick = '1';
        bars.append(li);
        return { li, bar: li.querySelector<HTMLElement>('i')!, pct: li.querySelector<HTMLElement>('.nw-pct')!, p };
      });
    }

    function draw(t: number) {
      t = ((t % total) + total) % total;
      t = warp(t);
      const k = Math.min(steps.length - 1, Math.floor(t / D));
      const phase = t < steps.length * D ? (t - k * D) / D : 1;
      const done = t >= steps.length * D;
      // The answer so far: every earlier pick, plus this one once it has been chosen.
      const upto = k + (phase > 0.62 ? 1 : 0);
      atext.innerHTML = '';
      for (let i = 0; i < upto; i++) {
        const s = document.createElement('span');
        s.textContent = steps[i].pick;
        if (i === k && !done) {
          const a = ease(clamp((phase - 0.62) / 0.2));
          s.className = 'nw-new';
          s.style.opacity = String(a);
          s.style.setProperty('--y', `${(1 - a) * 0.6}em`);
        }
        atext.append(s);
      }
      if (shown !== k) build(k);
      n.textContent = `Guess ${k + 1}`;
      what.textContent = done ? doneText : 'what comes next?';
      const grow = ease(clamp(phase / 0.36));
      const pickOn = phase > 0.44;
      const top = Math.max(...steps[k].options.map(([, p]) => p));
      for (const r of rows) {
        r.bar.style.width = `${r.p * grow}%`;
        r.pct.textContent = `${Math.round(r.p * grow)}%`;
        r.li.classList.toggle('chosen', pickOn && !!r.li.dataset.pick);
        r.li.classList.toggle('dim', pickOn && !r.li.dataset.pick);
      }
      const offPick = steps[k].options.find(([tok]) => tok === steps[k].pick)![1] < top;
      note.textContent = pickOn && offPick && !done ? 'Not the top pick. It rolls the dice a little.' : pickOn && k === 0 && !done && !pin ? firstNote : '';
      note.classList.toggle('nw-note-first', !offPick && k === 0 && !!firstNote && !!note.textContent);
      guess.style.opacity = done ? String(1 - 0.55 * ease(clamp((t - steps.length * D) / 0.6))) : '1';
      root.classList.toggle('nw-done', done);
      if (pin) { pin.hidden = false; pin.style.visibility = !done && (k > 0 || pickOn) ? 'visible' : 'hidden'; }
      endNote.style.opacity = done ? String(ease(clamp((t - steps.length * D - 0.4) / 0.6))) : '0';
    }

    (window as any).__nextWord ??= { draw, total, D };

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { draw(steps.length * D - 0.01); return; }
    draw(0);
    let playing = true, visible = false, clock = 0, last = 0;
    pause.hidden = false;
    if (hold) {
      // Wait for the reader's guess before anything plays.
      playing = false;
      pause.hidden = true;
      const ask = root.querySelector<HTMLElement>('.nw-ask')!, yours = root.querySelector<HTMLElement>('.nw-yours')!;
      ask.hidden = false;
      bars.style.visibility = 'hidden';
      const start = (tok?: string) => {
        ask.hidden = true;
        bars.style.visibility = '';
        if (tok !== undefined) {
          yours.hidden = false;
          yours.textContent = tok === steps[0].pick ? `You picked “${tok.trim()}”. So did the model.` : `You picked “${tok.trim()}”. The model picked “${steps[0].pick.trim()}”.`;
        }
        pause.hidden = false;
        playing = true;
      };
      root.querySelectorAll<HTMLButtonElement>('.nw-ask-opt').forEach((b) => b.addEventListener('click', () => start(b.dataset.tok!)));
      root.querySelector<HTMLButtonElement>('.nw-ask-show')!.addEventListener('click', () => start());
    }
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);
    pause.addEventListener('click', () => { playing = !playing; pause.textContent = playing ? 'Pause' : 'Play'; });
    function frame(now: number) {
      if (root.dataset.reel) return;
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (playing && visible) { clock += dt; draw(clock); }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame((now) => { last = now; requestAnimationFrame(frame); });
  }
</script>

<style is:global>
  .post-body .nw, .nw { position: relative; padding: 0; overflow: hidden; container-type: inline-size; }
  .nw-stage { padding: clamp(18px, 5cqw, 64px); display: grid; gap: clamp(12px, 3cqw, 36px); font-size: clamp(15px, 3.1cqw, 46px);
    background: radial-gradient(120% 80% at 0% 0%, color-mix(in srgb, var(--violet) 16%, transparent), transparent 60%),
                radial-gradient(100% 80% at 100% 100%, color-mix(in srgb, var(--teal) 14%, transparent), transparent 60%); }
  .nw p { margin: 0; }
  .nw-who { display: block; font: 600 0.62em/1.3 Inter, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.35em; }
  .nw-q .nw-qtext { font: 600 1em/1.35 "Space Grotesk", sans-serif; }
  .nw-a { font: 600 1.32em/1.35 "Space Grotesk", sans-serif; min-height: 2.8em; }
  .nw-atext { white-space: pre-wrap; }
  .nw-new { display: inline-block; white-space: pre; transform: translateY(var(--y, 0)); background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nw-cursor { display: inline-block; width: 0.08em; height: 1em; margin-left: 0.06em; vertical-align: -0.12em; background: var(--teal); animation: nw-blink 1s steps(1) infinite; }
  .nw-done .nw-cursor { opacity: 0; animation: none; }
  @keyframes nw-blink { 50% { opacity: 0; } }
  .nw-guess { border-top: 1px solid var(--line); padding-top: clamp(10px, 2.6cqw, 30px); transition: none; }
  .nw-head { font: 600 0.78em/1.3 Inter, sans-serif; color: var(--muted); margin-bottom: 0.7em !important; }
  .nw-n { color: var(--teal); }
  .nw-bars { list-style: none; margin: 0 !important; padding: 0 !important; display: grid; gap: 0.42em; }
  .nw-bars li { margin: 0; display: grid; grid-template-columns: 6.2em 1fr 3.2em; align-items: center; gap: 0.6em; font: 600 0.8em/1.2 Inter, sans-serif; transition: opacity .25s; }
  .nw-tok { font-family: "Space Grotesk", sans-serif; font-size: 1.1em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nw-bar { height: 0.95em; border-radius: 999px; background: var(--bg-2); overflow: hidden; }
  .nw-bar i { display: block; height: 100%; border-radius: inherit; background: color-mix(in srgb, var(--muted) 55%, transparent); }
  .nw-bars li.chosen .nw-bar i { background: var(--grad); }
  .nw-bars li.chosen .nw-tok { color: var(--teal); }
  .nw-bars li.dim { opacity: 0.45; }
  .nw-pct { text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; }
  .nw-note { min-height: 1.3em; margin-top: 0.6em !important; font: 600 0.7em/1.3 Inter, sans-serif; color: var(--warn); }
  .nw-mono .nw-atext { display: inline-block; font: 600 0.92em/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; padding: 0.3em 1.1em 0.3em 0.6em; border: 2px solid var(--violet); background: var(--card); border-radius: 6px; min-width: 2em; min-height: 1.4em; clip-path: polygon(0 0, calc(100% - 0.7em) 0, 100% 0.7em, 100% 100%, 0 100%); vertical-align: middle; position: relative; }
  .nw-mono .nw-atext::after { content: ''; position: absolute; top: 0; right: 0; width: 0.7em; height: 0.7em; background: linear-gradient(45deg, var(--violet) 50%, transparent 50%); }
  .nw-mono .nw-a { min-height: 0; font-size: 1.1em; }
  .nw-mono .nw-bars .nw-tok { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre; }
  figure.nw p.nw-anote { font: 600 max(0.8rem, 0.62em)/1.35 Inter, sans-serif; color: var(--violet); margin-top: -0.4em !important; }
  figure.nw p.nw-anote::before { content: '↑ '; }
  figure.nw p.nw-note.nw-note-first { color: var(--violet); font-size: max(0.8rem, 0.7em); }
  figure.nw p.nw-note.nw-note-first::before { content: '↑ '; }
  figure.nw p.nw-pin { font: 700 max(0.9rem, 0.7em)/1.35 Inter, sans-serif; color: var(--violet); margin-top: -0.4em !important; }
  figure.nw p.nw-pin::before { content: '↑ '; }
  .nw-ask { display: grid; gap: 0.5em; margin-top: 0.4em; }
  figure.nw p.nw-ask-q { font: 700 max(1rem, 0.8em)/1.3 "Space Grotesk", sans-serif; }
  .nw-ask-btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .nw .nw-ask-btns button { font: 600 1rem/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--text); background: var(--card); border: 1.5px solid var(--violet); border-radius: 10px; padding: 9px 14px; min-height: 42px; cursor: pointer; }
  .nw .nw-ask-btns .nw-ask-show { font-family: Inter, sans-serif; border-color: var(--line); border-radius: 999px; color: var(--muted); }
  .nw .nw-ask-btns button:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .nw-guess:has(.nw-ask:not([hidden])) .nw-bars { display: none; }
  figure.nw p.nw-yours { font: 600 max(0.85rem, 0.66em)/1.35 Inter, sans-serif; color: var(--muted); margin-top: 0.4em !important; }
  .nw [hidden] { display: none !important; }
  .nw-pause { position: absolute; top: 12px; right: 12px; font: 600 0.78rem/1 Inter, sans-serif; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); color: var(--muted); cursor: pointer; }
  .nw figcaption { padding: 0 18px 16px; }
  .nw[data-reel] { position: fixed; inset: 0; z-index: 9999; margin: 0 !important; width: 100vw; height: 100vh; max-width: none !important; box-sizing: border-box; padding: 6cqw 0 !important; gap: 4cqw; border: 0; border-radius: 0; display: grid; align-content: center; background: var(--bg); }
  .nw[data-reel] .nw-pause, .nw[data-reel] figcaption { display: none; }
  .nw[data-reel] .nw-stage { font-size: var(--reel-size, 3.5cqw); align-content: start; background: none; }
  .nw[data-reel] { background: radial-gradient(120% 70% at 0% 0%, color-mix(in srgb, var(--violet) 18%, transparent), transparent 60%), radial-gradient(100% 70% at 100% 100%, color-mix(in srgb, var(--teal) 16%, transparent), transparent 60%), var(--bg) !important; }
  .nw-reel-top, .nw-reel-end { display: none; }
  .nw[data-reel] .nw-reel-top { display: block; margin: 0; padding: 0 5cqw; font: 700 var(--reel-title, 5.1cqw)/1.15 "Space Grotesk", sans-serif; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nw[data-reel] .nw-reel-end { display: block; margin: 0; padding: 0 5cqw; min-height: 2.6em; font: 700 4.6cqw/1.25 "Space Grotesk", sans-serif; opacity: 0; transition: none; }
  .nw[data-reel] .nw-reel-end span { display: block; font: 600 3cqw/1.4 Inter, sans-serif; color: var(--muted); }
</style>
