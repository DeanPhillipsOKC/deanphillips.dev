---
// One tool round trip as a stack of one-on-one text threads, read top to bottom. You text the app. The
// app texts the model, the tool, and then the model again, and every time it texts the model it's a brand
// new chat, because the model has no memory. So the app's message has to carry the whole conversation.
// Each thread is drawn from the sender's phone: the sender's messages on the right, the other side on
// the left. A short line between threads says what happens next. Threads you'd never see are tagged.
// A still picture. Threads fade in once on scroll unless the reader prefers less motion, and everything
// shows without JavaScript.
type Who = 'you' | 'app' | 'model' | 'tool';
interface Line { tag?: string; text: string; code?: boolean; fresh?: boolean; dim?: boolean }
interface Thread {
  me: Who; them: Who; sub: string; hidden?: boolean; link?: string; banner?: string; end?: string;
  msgs: { who: Who; lines: Line[] }[];
}
interface Props { threads: Thread[]; others?: { label: string; note: string }[]; caption?: string }
const { threads, others = [], caption } = Astro.props;
const NAME: Record<Who, string> = { you: 'You', app: 'The app', model: 'The model', tool: 'The tool' };
const ICON: Record<Who, string> = {
  you: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  app: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M6.5 6.5h.01M9 6.5h.01"/>',
  model: '<circle cx="12" cy="12" r="8"/><path d="M12 12l4-5"/><path d="M12 2v2M22 12h-2M2 12h2"/>',
  tool: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l6 6"/>',
};
const av = (w: Who) => `<svg viewBox="0 0 24 24" aria-hidden="true">${ICON[w]}</svg>`;
---
<figure class="tt panel bleed">
  <ol class="tt-list">
    {threads.map((t, i) => (
      <li class="tt-item" style={`--i:${i}`}>
        {t.link && <p class="tt-link"><span aria-hidden="true">↓</span> {t.link}</p>}
        <section class={`tt-phone${t.hidden ? ' tt-hid' : ''}`}>
          <header class="tt-head">
            <span class={`tt-av tt-${t.them}`} set:html={av(t.them)} />
            <div class="tt-hname">
              <p class="tt-name">{NAME[t.them]}</p>
              <p class="tt-sub">On {NAME[t.me].toLowerCase() === 'you' ? 'your' : `${NAME[t.me].toLowerCase()}'s`} phone · {t.sub}{t.hidden && <span class="tt-hide">hidden from you</span>}</p>
            </div>
          </header>
          <div class="tt-log">
            {t.banner && <p class="tt-banner">{t.banner}</p>}
            {t.msgs.map((m) => (
              <div class={`tt-msg tt-c-${m.who}${m.who === t.me ? ' tt-mine' : ''}`}>
                {m.lines.map((l) => <p class={`tt-line${l.fresh ? ' tt-fresh' : ''}${l.dim ? ' tt-dim' : ''}`}>{l.tag && <span class="tt-tag">{l.tag}</span>}{l.code ? <code>{l.text}</code> : l.text}</p>)}
              </div>
            ))}
            {t.end && <p class="tt-end">{t.end}</p>}
          </div>
        </section>
      </li>
    ))}
  </ol>
  {others.length > 0 && (
    <div class="tt-others">
      <p class="tt-oh">Every tool makes the same trip. Only the note changes.</p>
      <ul>{others.map((o) => <li><b>{o.label}</b><code>{o.note}</code></li>)}</ul>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.tt')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    const items = [...root.querySelectorAll<HTMLElement>('.tt-item')];
    items.forEach((el) => el.classList.add('tt-wait'));
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { e.target.classList.remove('tt-wait'); io.unobserve(e.target); }
    }, { threshold: 0.25 });
    items.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  .tt p { margin: 0; }
  .tt-list { list-style: none; margin: 0 auto; padding: 0; max-width: 520px; display: grid; gap: 10px; }
  .tt-item { display: grid; gap: 10px; transition: opacity .5s ease, transform .5s ease; }
  .tt-item.tt-wait { opacity: 0; transform: translateY(12px); }
  .tt-link { text-align: center; font: 600 0.9rem/1.4 Inter, sans-serif; color: var(--muted); padding: 2px 8px; }
  .tt-link span { color: var(--text); }
  .tt-phone { border-radius: 20px; border: 1.5px solid var(--line); background: var(--bg-2); overflow: hidden; }
  .tt-hid { border-style: dashed; }
  .tt-head { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: var(--card); border-bottom: 1px solid var(--line); }
  .tt-hname { flex: 1; min-width: 0; }
  .tt-name { font: 700 1rem/1.2 "Space Grotesk", sans-serif; }
  .tt-sub { font-size: 0.78rem; color: var(--muted); }
  .tt-hide { display: inline-block; margin-left: 8px; font: 600 0.64rem/1.4 Inter, sans-serif; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); padding: 1px 7px; border: 1px dashed var(--line); border-radius: 999px; }
  .tt-av { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--c) 22%, var(--card)); border: 2px solid var(--c); }
  .tt-av svg { width: 20px; height: 20px; fill: none; stroke: var(--c); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .tt-you, .tt-c-you { --c: var(--teal); }
  .tt-app, .tt-c-app { --c: var(--warn); }
  .tt-model, .tt-c-model { --c: var(--violet); }
  .tt-tool, .tt-c-tool { --c: #4b93f0; }
  .tt-log { display: grid; gap: 8px; padding: 12px; }
  .tt-msg { display: grid; gap: 5px; max-width: 86%; min-width: 0; justify-self: start; padding: 8px 12px; border-radius: 16px 16px 16px 4px; background: color-mix(in srgb, var(--c) 15%, var(--card)); border: 1.5px solid color-mix(in srgb, var(--c) 50%, transparent); }
  .tt-mine { justify-self: end; border-radius: 16px 16px 4px 16px; background: color-mix(in srgb, var(--c) 28%, var(--card)); }
  .tt-line { font-size: 0.97rem; line-height: 1.4; overflow-wrap: anywhere; }
  .tt-fresh { background: color-mix(in srgb, var(--warn) 18%, transparent); outline: 1px solid color-mix(in srgb, var(--warn) 60%, transparent); border-radius: 6px; padding: 2px 6px; }
  .tt-dim { color: var(--muted); font-style: italic; font-size: 0.9rem; }
  .tt-tag { display: inline-block; margin-right: 6px; padding: 1px 6px; border-radius: 5px; font: 700 0.64rem/1.5 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; background: var(--bg-2); border: 1px solid var(--line); color: var(--muted); vertical-align: 1px; }
  .tt code { font: 600 0.93rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .tt-banner { justify-self: center; text-align: center; font: 600 0.82rem/1.4 Inter, sans-serif; color: var(--text); padding: 6px 12px; border-radius: 12px; background: color-mix(in srgb, var(--violet) 14%, var(--card)); border: 1px dashed color-mix(in srgb, var(--violet) 60%, transparent); max-width: 92%; }
  .tt-end { justify-self: center; text-align: center; font: 600 0.78rem/1.4 Inter, sans-serif; color: var(--muted); padding: 3px 12px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); }
  .tt-others { max-width: 520px; margin: 16px auto 0; display: grid; gap: 10px; }
  .tt-oh { font: 700 1rem/1.35 "Space Grotesk", sans-serif; }
  .tt-others ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .tt-others li { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; padding: 10px 12px; border-radius: 10px; background: var(--bg-2); border: 1px solid var(--line); }
  .tt-others b { font: 700 0.95rem/1.3 "Space Grotesk", sans-serif; min-width: 7em; }
  @media (prefers-reduced-motion: reduce) { .tt-item { transition: none; } }
  @media (max-width: 560px) {
    .tt-log { padding: 10px 8px; }
    .tt-msg { max-width: 92%; }
    .tt-line { font-size: 0.93rem; }
  }
</style>
