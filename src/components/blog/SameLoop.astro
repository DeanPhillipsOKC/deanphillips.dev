---
// Part 2's round trip next to this post's run, as two rows of the same chips, to show an agent is that
// loop kept going. Each row is the question or job, then the chips in order (model, tool, model, ...,
// Done, with each tool chip named by its tool), then how many laps it took. Same colors as AgentLoop: the model violet, the tool and the
// harness teal, Done --ok. A still picture with no controls and no script.
interface Row { label: string; text: string; tools: string[] }
interface Props { tools: Row; agent: Row; caption?: string }
const { tools, agent, caption } = Astro.props;
// Each tool trip is a model chip then the tool's chip (named by the tool), and every row ends model, Done.
const chain = (tools: string[]) => [...tools.flatMap((t) => [{ k: 'model', n: 'model' }, { k: 'tool', n: t }]), { k: 'model', n: 'model' }, { k: 'done', n: 'Done' }];
const rows = [
  { ...tools, cls: 'sl-row-one', note: 'One turn. One trip to a tool, then the answer.' },
  { ...agent, cls: 'sl-row-many', note: `Many turns. The same trip, ${agent.tools.length} times, then the answer.` },
];
---
<figure class="sl panel bleed">
  <div class="sl-rows">
    {rows.map((r) => (
      <div class={`sl-row ${r.cls}`}>
        <p class="sl-q"><span class="sl-k">{r.label}</span><span class="sl-t">{r.text}</span></p>
        <ol class="sl-chain" aria-label={r.note}>
          {chain(r.tools).map((c, i) => (
            <li class={`sl-chip sl-${c.k}`}>{i > 0 && <span class="sl-to" aria-hidden="true">→</span>}<span class="sl-c">{c.n}</span></li>
          ))}
        </ol>
        <p class="sl-note">{r.note}</p>
      </div>
    ))}
  </div>
  <p class="sl-same">Same loop. The agent just keeps going.</p>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .sl p { margin: 0; }
  .sl-rows { max-width: 640px; margin: 0 auto; display: grid; gap: 14px; }
  .sl-row { display: grid; gap: 10px; padding: 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); }
  .sl-q { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .sl-k { flex: none; padding: 3px 8px; border-radius: 6px; font: 700 0.72rem/1.4 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); background: var(--card); border: 1px solid var(--line); }
  .sl-t { font: 600 1.02rem/1.4 Inter, sans-serif; color: var(--text); }
  .sl-chain { list-style: none; margin: 0 !important; padding: 0 !important; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 0; }
  .sl-chip { margin: 0 !important; display: inline-flex; align-items: center; }
  .sl-to { padding: 0 6px; font: 700 1rem/1 Inter, sans-serif; color: var(--muted); }
  .sl-c { display: inline-block; padding: 7px 12px; border-radius: 999px; font: 700 0.95rem/1.1 Inter, sans-serif; border: 2px solid var(--c); color: var(--c); background: color-mix(in srgb, var(--c) 13%, var(--card)); }
  .sl-model { --c: var(--violet); }
  .sl-tool { --c: var(--teal); }
  .sl-done .sl-c { color: var(--bg); background: var(--ok); border-color: var(--ok); }
  .sl-note { font: 600 0.95rem/1.35 Inter, sans-serif; color: var(--muted); }
  .sl-same { margin: 14px auto 0 !important; width: fit-content; max-width: 100%; text-align: center; font: 700 1.05rem/1.3 "Space Grotesk", sans-serif; color: var(--text); background: var(--bg-2); border-radius: 999px; padding: 8px 16px; }
  @media (max-width: 560px) {
    .sl-row { padding: 12px; }
    .sl-c { padding: 6px 10px; font-size: 0.9rem; }
    .sl-to { padding: 0 4px; }
  }
</style>
