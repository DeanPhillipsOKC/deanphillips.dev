---
// The agent's tool ladder, animated from a real lesson run. Each picture the lesson needs drops onto the top
// rung (a free filter) and falls down the ladder until a tool can make it: free filters first, then a free
// throwaway script Claude writes, then a render started from a filter, then a plain render. Paid rungs tick the
// cost counter. Finished pictures line up in the lesson strip. Without JavaScript it's a table of the same data.
interface Try { rung: number; ok: boolean; why: string; cost?: number }
interface Job { label: string; img?: string; tries: Try[] }
interface Props { jobs: Job[]; caption?: string }
const { jobs, caption } = Astro.props;
const rungs = [
  { name: 'Filter', note: 'free, instant' },
  { name: 'Throwaway script', note: 'free, Claude writes it' },
  { name: 'Seeded render', note: 'paid, starts from a filter' },
  { name: 'Render', note: 'paid, image model' },
];
const total = jobs.flatMap((j) => j.tries).reduce((s, t) => s + (t.cost ?? 0), 0);
---
<figure class="ladder panel bleed" data-jobs={JSON.stringify(jobs)}>
  <div class="board" hidden>
    <div class="rungs">
      {rungs.map((r, i) => (
        <div class="rung" data-r={i}>
          <div class="rname"><b>{r.name}</b><span>{r.note}</span></div>
          <div class="shelf"><span class="verdict"></span></div>
        </div>
      ))}
      <div class="card" aria-hidden="true"><img alt="" /><span></span></div>
    </div>
    <div class="side">
      <div class="meter"><p class="label">Spent on images</p><p class="cost">$0.00</p>
        <p class="split"><span class="free">0 free</span> · <span class="paid">0 paid</span></p></div>
      <p class="label">The lesson so far</p>
      <ol class="done"></ol>
      <p class="now" aria-live="polite"></p>
    </div>
  </div>
  <div class="controls" hidden>
    <button type="button" class="play">Pause</button>
    <button type="button" class="again">Start over</button>
  </div>
  <table class="plain-table">
    <thead><tr><th>Picture</th><th>What happened</th><th>Cost</th></tr></thead>
    <tbody>
      {jobs.map((j) => (
        <tr><td>{j.label}</td><td>{j.tries.map((t) => `${rungs[t.rung].name}: ${t.ok ? 'worked' : 'didn\'t work'} (${t.why})`).join('; ')}</td>
          <td>${j.tries.reduce((s, t) => s + (t.cost ?? 0), 0).toFixed(3)}</td></tr>
      ))}
      <tr><td><b>Total</b></td><td></td><td><b>${total.toFixed(2)}</b></td></tr>
    </tbody>
  </table>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  interface Try { rung: number; ok: boolean; why: string; cost?: number }
  interface Job { label: string; img?: string; tries: Try[] }
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  for (const root of document.querySelectorAll<HTMLElement>('.ladder')) {
    const jobs: Job[] = JSON.parse(root.dataset.jobs!);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const board = $<HTMLElement>('.board'), card = $<HTMLElement>('.card'), cost = $<HTMLElement>('.cost');
    const free = $<HTMLElement>('.free'), paid = $<HTMLElement>('.paid'), done = $<HTMLOListElement>('.done');
    const now = $<HTMLElement>('.now'), playBtn = $<HTMLButtonElement>('.play'), again = $<HTMLButtonElement>('.again');
    const rungEls = [...root.querySelectorAll<HTMLElement>('.rung')];
    $('.plain-table').remove();
    board.hidden = false; $<HTMLElement>('.controls').hidden = false;

    let spent = 0, nFree = 0, nPaid = 0, run = 0, paused = false, visible = false;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.3 }).observe(root);
    const gate = async () => { while (paused || !visible) await wait(150); };
    const speed = reduce ? 0 : 1;

    function reset() {
      spent = 0; nFree = 0; nPaid = 0; done.innerHTML = ''; now.textContent = '';
      cost.textContent = '$0.00'; free.textContent = '0 free'; paid.textContent = '0 paid';
      rungEls.forEach((r) => r.classList.remove('lit', 'no', 'yes'));
      card.classList.remove('show');
    }
    function place(r: number) {
      const el = rungEls[r];
      card.style.transform = `translate(0, ${el.offsetTop + el.offsetHeight / 2 - card.offsetHeight / 2}px)`;
    }

    async function play(id: number) {
      reset();
      for (const job of jobs) {
        if (id !== run) return;
        await gate();
        card.querySelector('span')!.textContent = job.label.split(':')[0];
        const im = card.querySelector('img')!;
        if (job.img) { im.src = job.img; im.hidden = false; } else im.hidden = true;
        card.classList.remove('show'); card.style.transition = 'none'; place(0);
        card.style.transform += ' translateY(-40px)'; void card.offsetWidth;
        card.style.transition = ''; card.classList.add('show'); place(0);
        await wait(450 * speed);
        let landed = false, lastRung = 0;
        for (const t of job.tries) {
          if (id !== run) return;
          await gate();
          for (let r = lastRung; r <= t.rung; r++) {
            if (r < t.rung) { rungEls[r].classList.add('lit', 'no'); rungEls[r].querySelector('.verdict')!.textContent = 'skip'; }
            place(r); await wait(260 * speed);
            if (r < t.rung) rungEls[r].classList.remove('lit', 'no');
          }
          lastRung = t.rung;
          const rung = rungEls[t.rung];
          rung.classList.add('lit', t.ok ? 'yes' : 'no');
          rung.querySelector('.verdict')!.textContent = t.ok ? 'works' : 'no good';
          now.textContent = `${job.label}: ${t.why}`;
          if (t.cost) { spent += t.cost; cost.textContent = `$${spent.toFixed(2)}`; cost.classList.remove('bump'); void cost.offsetWidth; cost.classList.add('bump'); }
          await wait(1100 * speed);
          rung.classList.remove('lit', 'yes', 'no');
          if (t.ok) { landed = true; (t.rung <= 1 ? nFree++ : nPaid++); break; }
        }
        free.textContent = `${nFree} free`; paid.textContent = `${nPaid} paid`;
        if (landed) {
          const li = document.createElement('li');
          li.innerHTML = job.img ? `<img src="${job.img}" alt="">` : '';
          li.title = job.label;
          li.append(Object.assign(document.createElement('span'), { textContent: job.label }));
          done.append(li);
        }
        card.classList.remove('show');
        await wait(250 * speed);
      }
      now.textContent = `Done: ${nFree} free, ${nPaid} paid, $${spent.toFixed(2)} in all.`;
      if (!reduce) { await wait(5000); if (id === run) play(++run); }
    }

    playBtn.addEventListener('click', () => { paused = !paused; playBtn.textContent = paused ? 'Play' : 'Pause'; });
    again.addEventListener('click', () => { paused = false; playBtn.textContent = 'Pause'; play(++run); });
    if (reduce) { paused = false; }
    play(run);
  }
</script>

<style>
  [hidden] { display: none !important; }
  .ladder { padding: 18px; display: grid; gap: 14px; }
  .board { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .rungs { position: relative; display: grid; gap: 10px; align-content: start; }
  .rung { display: grid; grid-template-columns: 9.5rem 1fr; gap: 12px; align-items: center; min-height: 74px;
    border-radius: 14px; padding: 8px 12px; background: var(--bg-2); border: 1px solid var(--line);
    transition: border-color .25s, box-shadow .25s, background .25s; }
  .rname { display: grid; gap: 2px; }
  .rname b { font: 600 .95rem/1.2 "Space Grotesk", sans-serif; }
  .rname span { font: 500 .72rem/1.2 Inter, sans-serif; color: var(--muted); }
  .rung[data-r="0"] .rname b, .rung[data-r="1"] .rname b { color: var(--ok); }
  .rung[data-r="2"] .rname b, .rung[data-r="3"] .rname b { color: var(--violet); }
  .shelf { height: 100%; display: flex; justify-content: flex-end; align-items: center; }
  .verdict { font: 700 .72rem/1 Inter, sans-serif; letter-spacing: .08em; text-transform: uppercase; opacity: 0; transition: opacity .2s; }
  .rung.lit { border-color: var(--teal); box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 25%, transparent); }
  .rung.lit .verdict { opacity: 1; }
  .rung.yes { border-color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, var(--bg-2)); }
  .rung.yes .verdict { color: var(--ok); }
  .rung.no .verdict { color: var(--warn); }
  .card { position: absolute; left: calc(9.5rem + 28px); top: 0; display: flex; align-items: center; gap: 8px;
    padding: 6px 10px 6px 6px; border-radius: 12px; background: var(--card); border: 1px solid var(--line);
    box-shadow: 0 8px 24px rgba(0, 0, 0, .35); opacity: 0; max-width: calc(100% - 9.5rem - 130px);
    transition: transform .26s cubic-bezier(.3, .7, .4, 1), opacity .25s; pointer-events: none; }
  .card.show { opacity: 1; }
  .card img { width: 52px; height: 52px; object-fit: cover; border-radius: 8px; }
  .card span { font: 600 .82rem/1.2 Inter, sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .side { display: grid; gap: 10px; align-content: start; min-width: 0; }
  .label { margin: 0; font: 600 .7rem/1 Inter, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .meter { padding: 12px 14px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); display: grid; gap: 6px; }
  .cost { margin: 0; font: 700 2.4rem/1 "Space Grotesk", sans-serif; background: var(--grad); -webkit-background-clip: text;
    background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
  .cost.bump { animation: bump .4s ease-out; }
  @keyframes bump { 40% { transform: scale(1.12); } }
  .split { margin: 0; font: 500 .8rem/1.2 Inter, sans-serif; color: var(--muted); }
  .split .free { color: var(--ok); } .split .paid { color: var(--violet); }
  .done { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(54px, 1fr)); gap: 6px; min-height: 60px; }
  .done :global(li) { margin: 0; display: grid; gap: 2px; animation: pop .35s ease-out; }
  .done :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); }
  .done :global(span) { font: 500 .6rem/1.15 Inter, sans-serif; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @keyframes pop { from { transform: scale(.6); opacity: 0; } }
  .now { margin: 0; min-height: 3.2em; font: 500 .85rem/1.4 Inter, sans-serif; color: var(--text); }
  .controls { display: flex; gap: 10px; }
  .controls button { font: 600 .85rem/1 Inter, sans-serif; padding: 8px 14px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--line); background: var(--bg-2); color: var(--text); }
  .plain-table { width: 100%; font-size: .85rem; border-collapse: collapse; }
  .plain-table td, .plain-table th { border-bottom: 1px solid var(--line); padding: 6px; text-align: left; vertical-align: top; }
  @media (max-width: 680px) {
    .board { grid-template-columns: 1fr; }
    .rung { grid-template-columns: 7.5rem 1fr; min-height: 64px; }
    .card { left: calc(7.5rem + 26px); max-width: calc(100% - 7.5rem - 90px); }
    .cost { font-size: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .card, .rung, .cost.bump, .done li { transition: none; animation: none; } }
</style>
