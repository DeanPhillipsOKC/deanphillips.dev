---
// The conversation as the agent's only memory, drawn as one wide bar (the notebook) inside a track, with a
// dashed limit line (the context window). Same color code as LoopInLoop: muted for text the harness or
// the reader wrote, violet for what the model wrote, teal for tool results, a dashed outline for a summary.
//
// state="grow": Next turn adds a pair of blocks (the model wrote, the result came back). Search results
// are wide on purpose. After turn 5 the next result won't fit, so the button asks the reader to guess
// first; pressing it squeezes the oldest turns (never the setup notes or the job) into one dashed summary
// block, with callouts. Every block is rendered on the server, and the script only changes widths.
// Reduced motion turns the width transitions off. Without JavaScript, three static bars show turn 1,
// turn 5 (near the line), and turn 7 (after the summary).
//
// state="reviewer": a static wrong-vs-right pair. The maker checking itself reads its own long story
// first, and a fresh copy reads a short bar with only the work to check. Same scale for both bars.
interface MTurn { wrote: number; result: number; kind: string }
interface Meter { track: number; limit: number; setup: number; job: number; summary: number; turns: MTurn[]; squeezeAt: number }
interface RBlock { kind: string; size: number; label: string }
interface Props { state?: 'grow' | 'reviewer'; meter?: Meter; maker?: RBlock[]; fresh?: RBlock[]; track?: number; caption?: string }
const { state = 'grow', meter, maker = [], fresh = [], track = 68, caption } = Astro.props;
const pct = (n: number, t: number) => `${(100 * n / t).toFixed(2)}%`;
const KIND: Record<string, string> = { search: 'search result', weather: 'weather', map: 'map' };

// Block widths for a given point in the story (n turns, squeezed or not), used by the no-JS bars.
function widths(m: Meter, n: number, squeezed: boolean) {
  const old = squeezed ? m.squeezeAt - 1 : 0;
  return {
    summary: squeezed ? m.summary : 0,
    turns: m.turns.map((t, i) => (i < n && i >= old ? t : { wrote: 0, result: 0, kind: t.kind })),
  };
}
const snaps = meter ? [
  { label: 'Turn 1', ...widths(meter, 1, false) },
  { label: 'Turn 5. Almost at the line', ...widths(meter, 5, false) },
  { label: 'Turn 7. The oldest turns became a summary', ...widths(meter, 7, true) },
] : [];
const book = '<svg class="cm-book" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h12a2 2 0 0 1 2 2v16H7a2 2 0 0 1-2-2z" /><path d="M5 19a2 2 0 0 1 2-2h12" /><path d="M9 7h6M9 10.5h6" /></svg>';
const dial = '<svg class="cm-dial" viewBox="-10 -10 20 20" aria-hidden="true"><circle r="8" /><line x1="0" y1="0" x2="4" y2="-6" /></svg>';
---
{state === 'grow' && meter && (
<figure class="cm cm-grow panel bleed" data-cm={JSON.stringify(meter)}>
  <div class="cm-top">
    <span class="cm-hand"><span>All of this, handed over again every turn</span><i class="cm-arrow" aria-hidden="true"></i></span>
    <span class="cm-model"><Fragment set:html={dial} />The model</span>
  </div>
  <div class="cm-live" hidden>
    <div class="cm-row">
      <Fragment set:html={book} />
      <div class="cm-barwrap">
        <p class="cm-limit-l" style={`right:${pct(meter.track - meter.limit, meter.track)}`}>The most it can work with at once <small>(counting what it writes next)</small></p>
        <div class="cm-track">
          <div class="cm-blocks">
            <i class="cm-b cm-b-setup" style={`width:${pct(meter.setup, meter.track)}`} title="setup notes, from the harness"><span>setup</span></i>
            <i class="cm-b cm-b-job" style={`width:${pct(meter.job, meter.track)}`} title="your job"></i>
            <i class="cm-b cm-b-sum" data-sum title="summary, written by the model"><span>summary</span></i>
            {meter.turns.map((t, i) => (<><i class="cm-b cm-b-m" data-tw={i} title="the model wrote"></i><i class={`cm-b cm-b-r cm-b-${t.kind}`} data-tr={i} title={KIND[t.kind] ?? 'result'}>{t.kind === 'search' && <span>search result</span>}</i></>))}
          </div>
          <i class="cm-limit" style={`left:${pct(meter.limit, meter.track)}`}></i>
        </div>
        <p class="cm-under"><span class="cm-booklab">↑ The notebook. Read from page one, every turn.</span><span class="cm-bite" hidden>Search results take big bites</span></p>
      </div>
    </div>
    <div class="cm-say" aria-live="polite">
      <p class="cm-msg"></p>
      <p class="cm-fix" hidden>One common fix. The harness asks the model to write a summary (another model call), then keeps going with that.</p>
      <p class="cm-lose" hidden>Small details from early turns can get lost here.</p>
      <p class="cm-foot" hidden>Other harnesses drop old results, or just stop.</p>
    </div>
    <div class="cm-ctrl">
      <span class="cm-turn">Turn 1</span>
      <button type="button" class="cm-next">Next turn</button>
    </div>
  </div>
  <div class="cm-static">
    {snaps.map((s) => {
      const used = meter.setup + meter.job + s.summary + s.turns.reduce((a, t) => a + t.wrote + t.result, 0);
      return (
        <div class="cm-snap">
          <p class="cm-snap-l">{s.label}</p>
          <div class="cm-track">
            <div class="cm-blocks">
              <i class="cm-b cm-b-setup" style={`width:${pct(meter.setup, meter.track)}`}></i>
              <i class="cm-b cm-b-job" style={`width:${pct(meter.job, meter.track)}`}></i>
              {s.summary > 0 && <i class="cm-b cm-b-sum" style={`width:${pct(s.summary, meter.track)}`}></i>}
              {s.turns.map((t) => t.wrote > 0 && (<><i class="cm-b cm-b-m" style={`width:${pct(t.wrote, meter.track)}`}></i><i class={`cm-b cm-b-r cm-b-${t.kind}`} style={`width:${pct(t.result, meter.track)}`}></i></>))}
            </div>
            <i class="cm-limit" style={`left:${pct(meter.limit, meter.track)}`}></i>
          </div>
          <span class="cm-sr">{used} of {meter.limit} made-up units used.</span>
        </div>
      );
    })}
    <p class="cm-msg">The dashed line is the most it can work with at once. At turn 6 the next result won't fit, so the harness asks the model to write a summary of the oldest turns (one common fix). Small details from early turns can get lost here.</p>
  </div>
  <ul class="cm-legend">
    <li><i class="cm-sw cm-b-setup"></i><span><b>setup notes</b> from the harness, like which tools exist</span></li>
    <li><i class="cm-sw cm-b-job"></i><span><b>your job</b></span></li>
    <li><i class="cm-sw cm-b-m"></i><span><b>the model wrote</b></span></li>
    <li><i class="cm-sw cm-b-r"></i><span><b>a tool result</b></span></li>
    <li><i class="cm-sw cm-b-sum"></i><span><b>a summary</b></span></li>
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
)}

{state === 'reviewer' && (
<figure class="cm cm-rev panel bleed">
  <div class="cm-pair">
    <div class="cm-side cm-side-no">
      <p class="cm-side-h">The maker checks itself</p>
      <p class="cm-call">Reads its own story first</p>
      <div class="cm-track">
        <div class="cm-blocks">
          {maker.map((b) => <i class={`cm-b cm-b-${b.kind}`} style={`width:${pct(b.size, track)}`} title={b.label}></i>)}
        </div>
      </div>
      <p class="cm-keys">{maker.filter((b, i, a) => a.findIndex((x) => x.label === b.label) === i).map((b) => <span><i class={`cm-sw cm-b-${b.kind}`}></i>{b.label}</span>)}</p>
    </div>
    <div class="cm-side cm-side-yes">
      <p class="cm-side-h">A fresh copy checks</p>
      <p class="cm-call">Never saw the reasoning</p>
      <div class="cm-track">
        <div class="cm-blocks">
          {fresh.map((b) => <i class={`cm-b cm-b-${b.kind}`} style={`width:${pct(b.size, track)}`} title={b.label}></i>)}
        </div>
      </div>
      <p class="cm-keys">{fresh.map((b) => <span><i class={`cm-sw cm-b-${b.kind}`}></i>{b.label}</span>)}</p>
    </div>
  </div>
  <p class="cm-blind">Same dials, so it can share the same blind spots</p>
  <p class="cm-chip">Checks don't have to be AI. A regular program can check too.</p>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
)}

<script>
  type M = { track: number; limit: number; setup: number; job: number; summary: number; turns: { wrote: number; result: number }[]; squeezeAt: number };
  for (const root of document.querySelectorAll<HTMLElement>('.cm-grow')) {
    const m = JSON.parse(root.dataset.cm!) as M;
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    $('.cm-live').hidden = false;
    $('.cm-static').hidden = true;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('cm-still');
    const tw = [...root.querySelectorAll<HTMLElement>('[data-tw]')], tr = [...root.querySelectorAll<HTMLElement>('[data-tr]')];
    const sum = $('[data-sum]'), bite = $('.cm-bite');
    const msg = $('.cm-msg'), fix = $('.cm-fix'), lose = $('.cm-lose'), foot = $('.cm-foot');
    const turnL = $('.cm-turn'), next = $<HTMLButtonElement>('.cm-next');
    const pct = (n: number) => `${(100 * n / m.track).toFixed(2)}%`;
    const N = m.turns.length;
    let n = 1, squeezed = false;

    function render() {
      const old = squeezed ? m.squeezeAt - 1 : 0;
      m.turns.forEach((t, i) => {
        const on = i < n && i >= old;
        tw[i].style.width = pct(on ? t.wrote : 0);
        tr[i].style.width = pct(on ? t.result : 0);
      });
      sum.style.width = pct(squeezed ? m.summary : 0);
      bite.hidden = n < 1 || squeezed;
      turnL.textContent = `Turn ${n}`;
      const full = n === m.squeezeAt && !squeezed;
      fix.hidden = lose.hidden = foot.hidden = !squeezed;
      msg.textContent = full ? "Turn 6's search result won't fit under the line."
        : squeezed ? ''
        : 'Each turn adds what the model wrote and what came back. Nothing comes off.';
      msg.hidden = squeezed;
      root.classList.toggle('cm-full', full);
      next.textContent = full ? 'What happens now? Guess, then press' : n === N ? 'Start over' : 'Next turn';
    }
    next.addEventListener('click', () => {
      if (n === N) { n = 1; squeezed = false; }
      else if (n === m.squeezeAt && !squeezed) { squeezed = true; n += 1; }
      else n += 1;
      render();
    });
    render();
  }
</script>

<style is:global>
  .cm [hidden] { display: none !important; }
  .cm p { margin: 0; }
  .cm-dial { width: 18px; height: 18px; flex: none; }
  .cm-dial circle { fill: none; stroke: currentColor; stroke-width: 2; }
  .cm-dial line { stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; }
  .cm-top { display: flex; align-items: center; gap: 10px; margin-bottom: 30px; }
  .cm-hand { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; font: 600 0.95rem/1.3 Inter, sans-serif; color: var(--text); }
  .cm-arrow { position: relative; display: block; height: 4px; border-radius: 2px; background: var(--muted); margin-right: 10px; }
  .cm-arrow::after { content: ''; position: absolute; right: -12px; top: -7px; border: 9px solid transparent; border-left: 13px solid var(--muted); border-right: 0; }
  .cm-model { flex: none; display: inline-flex; align-items: center; gap: 6px; font: 700 1rem/1 "Space Grotesk", sans-serif; color: var(--violet); border: 3px solid var(--violet); background: var(--bg-2); border-radius: 12px; padding: 10px 12px; }
  .cm-row { display: flex; align-items: flex-start; gap: 10px; }
  .cm-book { flex: none; width: 34px; height: 34px; margin-top: 30px; fill: none; stroke: var(--muted); stroke-width: 1.7; stroke-linejoin: round; stroke-linecap: round; }
  .cm-barwrap { position: relative; flex: 1; min-width: 0; padding-top: 30px; }
  .cm-limit-l { position: absolute; top: -12px; max-width: 70%; text-align: right; font: 600 0.85rem/1.25 Inter, sans-serif; color: var(--warn); padding-right: 6px; }
  .cm-limit-l small { display: block; font-weight: 500; font-size: 0.75rem; }
  .cm-track { position: relative; height: 40px; border-radius: 8px; background: var(--bg-2); border: 1px solid var(--line); }
  .cm-blocks { display: flex; height: 100%; overflow: hidden; border-radius: 7px; }
  .cm-b { display: flex; align-items: center; justify-content: center; flex: none; height: 100%; overflow: hidden; transition: width .6s ease; box-shadow: inset -2px 0 0 var(--card); }
  .cm-still .cm-b { transition: none; }
  .cm-b span { font: 600 0.68rem/1 Inter, sans-serif; color: var(--bg); white-space: nowrap; }
  .cm-b-setup { background: color-mix(in srgb, var(--muted) 38%, var(--bg-2)); }
  .cm-b-setup span { color: var(--text); }
  .cm-b-job { background: color-mix(in srgb, var(--muted) 75%, var(--bg-2)); }
  .cm-b-sum { width: 0; background: var(--card); box-shadow: inset 0 0 0 2px var(--muted); border-radius: 4px; background-clip: padding-box; outline: 2px dashed var(--muted); outline-offset: -4px; }
  .cm-b-sum span { color: var(--muted); }
  .cm-b-m, .cm-b-wrote { background: var(--violet); }
  .cm-b-r, .cm-b-result { background: var(--teal); }
  .cm-b-search, .cm-b-weather, .cm-b-map { width: 0; }
  .cm-live .cm-b-m, .cm-live .cm-b-r { width: 0; }
  .cm-b-work { background: color-mix(in srgb, var(--teal) 35%, var(--bg-2)); box-shadow: inset 0 0 0 2px var(--teal); }
  .cm-limit { position: absolute; top: -8px; bottom: -8px; width: 0; border-left: 3px dashed var(--warn); }
  .cm-full .cm-limit { border-left-style: solid; }
  .cm-under { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; margin-top: 8px !important; font: 500 0.85rem/1.35 Inter, sans-serif; color: var(--muted); }
  .cm-booklab { font-style: italic; }
  .cm-bite { font-weight: 600; color: var(--teal); }
  .cm-say { margin-top: 14px; min-height: 4.5em; display: grid; gap: 8px; }
  .cm-msg, .cm-fix { font: 600 1rem/1.45 Inter, sans-serif; color: var(--text); }
  .cm-lose { font: 700 1rem/1.4 Inter, sans-serif; color: var(--text); padding: 8px 12px; border-radius: 10px; border-left: 5px solid var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--card)); }
  .cm-foot { font: 500 0.85rem/1.35 Inter, sans-serif; color: var(--muted); }
  .cm-ctrl { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; }
  .cm-turn { font: 700 1.3rem/1 "Space Grotesk", sans-serif; color: var(--text); }
  .cm-next { font: 600 0.92rem/1.2 Inter, sans-serif; color: var(--bg); background: var(--grad); border: 0; border-radius: 999px; padding: 12px 18px; min-height: 44px; cursor: pointer; text-align: center; }
  .cm-next:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .cm-full .cm-next { background: var(--warn); }
  .cm-legend { list-style: none; margin: 16px 0 0 !important; padding: 0 !important; display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .cm-legend li { margin: 0 !important; display: flex; align-items: center; gap: 6px; font: 500 0.85rem/1.3 Inter, sans-serif; color: var(--muted) !important; }
  .cm-legend b { color: var(--text); font-weight: 600; }
  .cm-sw { display: inline-block; flex: none; width: 16px !important; height: 16px; border-radius: 4px; }
  .cm-sw.cm-b-sum { background: none; box-shadow: none; outline: 2px dashed var(--muted); outline-offset: -2px; }
  .cm-snap { margin-bottom: 18px; }
  .cm-snap .cm-track { margin-top: 18px; }
  .cm-snap-l { font: 600 0.9rem/1.3 Inter, sans-serif; color: var(--text); }
  .cm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .cm-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .cm-side { padding: 14px; border-radius: 14px; background: var(--bg-2); border: 2px solid var(--line); display: grid; gap: 10px; align-content: start; }
  .cm-side-yes { border-color: var(--teal); }
  .cm-side-h { font: 700 1.15rem/1.2 "Space Grotesk", sans-serif; color: var(--text); }
  .cm-call { font: italic 600 0.92rem/1.3 Inter, sans-serif; color: var(--muted); }
  .cm-call::before { content: '↓ '; font-style: normal; }
  .cm-side .cm-track { height: 34px; background: var(--card); }
  .cm-side .cm-b { width: auto; }
  .cm-keys { display: flex; flex-wrap: wrap; gap: 4px 12px; font: 500 0.8rem/1.3 Inter, sans-serif; color: var(--muted); }
  .cm-keys span { display: inline-flex; align-items: center; gap: 5px; }
  .cm-keys .cm-sw { width: 12px !important; height: 12px; }
  .cm-blind { margin-top: 14px !important; text-align: center; font: 700 1rem/1.35 Inter, sans-serif; color: var(--text); padding: 10px 12px; border-radius: 10px; border: 2px solid var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--card)); }
  .cm-chip { margin: 12px auto 0 !important; width: fit-content; max-width: 100%; text-align: center; font: 500 0.88rem/1.35 Inter, sans-serif; color: var(--muted); background: var(--bg-2); border-radius: 999px; padding: 8px 14px; }
  @media (max-width: 620px) {
    .cm-pair { grid-template-columns: 1fr; }
    .cm-b span { display: none; }
    .cm-book { width: 26px; height: 26px; }
    .cm-row { gap: 6px; }
    .cm-limit-l { font-size: 0.78rem; top: 0; }
    .cm-barwrap { padding-top: 56px; }
    .cm-book { margin-top: 56px; }
    .cm-top { margin-bottom: 26px; }
    .cm-hand { font-size: 0.88rem; }
    .cm-ctrl { flex-wrap: wrap; }
  }
</style>
