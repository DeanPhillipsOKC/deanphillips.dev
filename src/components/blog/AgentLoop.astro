---
// The agent loop as a plain flowchart. Run the model, then one question. If it asked for a tool, the
// harness runs it, pastes the result in, and goes back to the top. If not, it's done. A dashed bar
// under it shows the other way out, where the harness stops the run. A still picture read top to
// bottom. The parts fade in once on scroll unless the reader prefers less motion, and it reads the same
// without JavaScript.
interface Props { caption?: string }
const { caption } = Astro.props;
---
<figure class="agl panel bleed">
  <div class="agl-chart">
    <div class="agl-loop">
      <div class="agl-step agl-model agl-fade" style="--i:0">
        <span class="agl-n">1</span>
        <div>
          <p class="agl-h">Run the model</p>
          <p class="agl-t">It reads the whole conversation and writes what comes next.</p>
        </div>
      </div>
      <p class="agl-down agl-fade" style="--i:1" aria-hidden="true">↓</p>
      <p class="agl-ask agl-fade" style="--i:1">Did it ask for a tool?</p>
      <div class="agl-split">
        <div class="agl-branch agl-fade" style="--i:2">
          <p class="agl-yn">Yes</p>
          <div class="agl-step agl-app">
            <span class="agl-n">2</span>
            <div>
              <p class="agl-h">Run the tool</p>
              <p class="agl-t">The harness does the errand and pastes the result in.</p>
            </div>
          </div>
          <p class="agl-back">↺ Back to 1</p>
        </div>
        <div class="agl-branch agl-fade" style="--i:3">
          <p class="agl-yn">No</p>
          <div class="agl-step agl-done">
            <span class="agl-n">✓</span>
            <div>
              <p class="agl-h">Done</p>
              <p class="agl-t">It wrote an answer. It thinks the job is finished.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="agl-stop agl-fade" style="--i:4"><b>Or the harness stops it.</b> Too many turns, too much time or money, an error, or a step that needs your OK.</p>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.agl')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    root.classList.add('agl-ready');
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { root.classList.add('agl-go'); io.disconnect(); } }, { threshold: 0.3 });
    io.observe(root);
  }
</script>

<style is:global>
  .agl p { margin: 0; }
  .agl-chart { max-width: 560px; margin: 0 auto; display: grid; gap: 14px; }
  .agl-loop { position: relative; display: grid; gap: 8px; justify-items: center; padding: 16px 14px 14px 30px; border-radius: 18px; border: 2px solid color-mix(in srgb, var(--violet) 35%, var(--line)); }
  /* The loop's return line runs up the left edge, with an arrowhead pointing back at step 1. */
  .agl-loop::before { content: ''; position: absolute; left: 12px; top: 40px; bottom: 30px; width: 0; border-left: 3px solid var(--teal); border-radius: 2px; }
  .agl-loop::after { content: ''; position: absolute; left: 6px; top: 32px; border: 7.5px solid transparent; border-bottom: 10px solid var(--teal); border-top: 0; }
  .agl-step { width: 100%; display: grid; grid-template-columns: 34px 1fr; gap: 10px; align-items: start; padding: 12px; border-radius: 14px; background: color-mix(in srgb, var(--c) 13%, var(--card)); border: 2px solid var(--c); text-align: left; }
  .agl-model { --c: var(--violet); }
  .agl-app { --c: var(--teal); }
  .agl-done { --c: var(--ok); }
  .agl-n { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font: 700 1rem/1 "Space Grotesk", sans-serif; background: var(--c); color: var(--bg); }
  .agl-h { font: 700 1.15rem/1.25 "Space Grotesk", sans-serif; }
  .agl-t { font-size: 0.95rem; line-height: 1.4; color: var(--muted); margin-top: 2px; }
  .agl-down { font-size: 1.4rem; line-height: 1; color: var(--muted); }
  .agl-ask { font: 700 1.05rem/1.3 "Space Grotesk", sans-serif; padding: 8px 16px; border-radius: 999px; background: var(--card); border: 2px dashed var(--muted); }
  .agl-split { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-items: start; }
  .agl-branch { display: grid; gap: 6px; justify-items: center; }
  .agl-yn { font: 700 0.8rem/1.2 Inter, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .agl-yn::before { content: '↓ '; }
  .agl-back { font: 700 0.95rem/1.2 Inter, sans-serif; color: var(--teal); }
  .agl-stop { font-size: 0.95rem; line-height: 1.45; padding: 10px 14px; border-radius: 12px; border: 1.5px dashed var(--line); background: var(--bg-2); }
  .agl-stop b { color: var(--text); }
  .agl-ready .agl-fade { opacity: 0; transform: translateY(8px); }
  .agl-go .agl-fade { opacity: 1; transform: none; transition: opacity .45s ease, transform .45s ease; transition-delay: calc(var(--i) * .35s); }
  @media (max-width: 560px) {
    .agl-loop { padding: 14px 8px 12px 26px; }
    .agl-loop::before { left: 10px; }
    .agl-loop::after { left: 4px; }
    .agl-step { grid-template-columns: 1fr; gap: 6px; padding: 10px; }
    .agl-n { width: 28px; height: 28px; font-size: 0.9rem; }
    .agl-h { font-size: 1.05rem; }
    .agl-t { font-size: 0.88rem; }
  }
</style>
