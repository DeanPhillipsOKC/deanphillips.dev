---
// The silent social video for the training math post (part 4 of "AI, plainly"). It is never shown to readers.
// The figure stays display:none unless a recording script sets data-reel (or data-og) on it, and it is
// aria-hidden. It retells the post's one interactive (FitLine) as a 4:5 clip. The first frame is a poster
// (the made-up bean dots, a wild first guess and its amber misses, under a big hook). The misses pull back,
// then grow again one by one as "Measure every miss." A card shows why each miss is multiplied by itself, in
// two beats (MissMath's 3 plus minus 3 that looks perfect, then 9 plus 9 that is honest). Only then does the
// scoreboard appear and count up to the guess's total miss, so the number on screen is always the one the
// video has explained. Training then plays out round by round, slow for the first 10 rounds and faster after,
// while two labeled dials under the chart (slope and start height, the post's two dials) turn with the line,
// until it settles at round 40. An end card gives the takeaway, a small copy of the fitted line, and the site.
// One headline per beat on top (about 80px at 1080 wide, bigger for the hook) with a short line under it. The
// old headline fades fully out before the new one rises in, so two never overlap. Post colors throughout
// (line teal, dots in the text color, misses amber, pink only for the wrong sum, green for the honest one).
//
// The dots, the bad line, the step size and the round count come from the post's data
// (src/data/ai-plainly/ai-plainly-training-math.json, `beans`), and every round is real training, the same
// centered update FitLine runs (weeks measured from the middle, average squared miss, step 0.05). All 40
// rounds are worked out once up front, so the line at any moment is exact and can't drift from the post.
//
// Everything is drawn as a pure function of time, so scripts/video/ai-plainly-training-math-reel.mjs can
// record it frame by frame. It sets data-reel (or data-og for the link preview) and calls
// window.__trainingReel.draw(seconds). There is no loop and no timer, so reduced motion has nothing to stop,
// and without JavaScript nothing shows (the figure is hidden either way).
interface Beans { weeks: number[]; heights: number[]; bad: { tilt: number; start: number }; step: number; rounds: number }
interface Props { beans: Beans }
const { beans } = Astro.props;

// Chart geometry, in viewBox units (shared with the script through data attributes).
const W = 1000, H = 600, L = 128, R = 978, T = 26, B = 486;
const X0 = 0.4, X1 = 8.6, Y1 = 20;
const sx = (w: number) => L + ((w - X0) / (X1 - X0)) * (R - L);
const sy = (h: number) => B - (h / Y1) * (B - T);
const yTicks = [0, 10, 20];
// The end card's small copy of the fitted line (no axes).
const ex = (w: number) => 20 + ((w - X0) / (X1 - X0)) * 560;
const ey = (h: number) => 250 - (h / Y1) * 230;
const dial = (name: string, cls: string) => ({ name, cls });
const dials = [dial('slope', 'trl-d-tilt'), dial('start height', 'trl-d-start')];
---
<figure class="trl" aria-hidden="true" data-beans={JSON.stringify(beans)}>
  <div class="trl-main">
    <div class="trl-head">
      <div class="trl-layer"><p class="trl-hl"></p><p class="trl-sub"></p></div>
    </div>
    <div class="trl-board">
      <p class="trl-score"><span>Total miss</span><b class="trl-total">0</b></p>
      <p class="trl-round"><span>Round</span><b class="trl-rn">0</b></p>
    </div>
    <div class="trl-stage">
      <svg class="trl-chart" viewBox={`0 0 ${W} ${H}`}>
        <defs><clipPath id="trl-clip"><rect x={L} y={T} width={R - L} height={B - T} /></clipPath></defs>
        {yTicks.map((v) => <g><line class="trl-grid" x1={L} x2={R} y1={sy(v)} y2={sy(v)} /><text class="trl-tick" x={L - 16} y={sy(v) + 16} text-anchor="end">{v}</text></g>)}
        {beans.weeks.map((w) => <text class="trl-tick" x={sx(w)} y={B + 54} text-anchor="middle">{w}</text>)}
        <text class="trl-axis" x={(L + R) / 2} y={H - 4} text-anchor="middle">week</text>
        <text class="trl-axis" x="34" y={(T + B) / 2} text-anchor="middle" transform={`rotate(-90 34 ${(T + B) / 2})`}>height (cm)</text>
        <g clip-path="url(#trl-clip)">
          <line class="trl-line trl-ghost" />
          {beans.weeks.map(() => <line class="trl-miss" />)}
          <line class="trl-line trl-cur" />
        </g>
        {beans.weeks.map((w, i) => <circle class="trl-dot" cx={sx(w)} cy={sy(beans.heights[i])} r="14" />)}
        <text class="trl-lab trl-ghostlab" x={sx(0.7)} y={sy(14.6)}>first guess</text>
      </svg>
      <div class="trl-card">
        <svg class="trl-mini" viewBox="0 0 760 230">
          <line class="trl-line" x1="20" y1="115" x2="740" y2="115" />
          <line class="trl-miss" x1="250" y1="115" x2="250" y2="36" />
          <line class="trl-miss" x1="510" y1="115" x2="510" y2="194" />
          <circle class="trl-dot" cx="250" cy="36" r="17" />
          <circle class="trl-dot" cx="510" cy="194" r="17" />
          <text class="trl-minilab" x="280" y="88">up 3</text>
          <text class="trl-minilab" x="480" y="172" text-anchor="end">down 3</text>
        </svg>
        <p class="trl-row trl-wrong"><span class="trl-k">Just add them</span><span class="trl-sum">3 plus (minus 3) = 0</span><i class="trl-strike"></i></p>
        <p class="trl-stamp trl-stamp-bad">Looks perfect. Isn't.</p>
        <p class="trl-row trl-right"><span class="trl-k">Each times itself (3 × 3 = 9)</span><span class="trl-sum">9 plus 9 = 18</span></p>
        <p class="trl-stamp trl-stamp-good">Honest. Big misses count extra.</p>
      </div>
    </div>
    <div class="trl-dials">
      {dials.map((x) => (
        <div class={`trl-dial ${x.cls}`}>
          <svg viewBox="0 0 120 120"><circle class="trl-knob" cx="60" cy="60" r="50" /><line class="trl-needle" x1="60" y1="60" x2="60" y2="20" /><circle class="trl-hub" cx="60" cy="60" r="8" /></svg>
          <p><span>{x.name}</span><b>0</b></p>
        </div>
      ))}
    </div>
    <p class="trl-foot">A bean plant's height each week. The numbers are made up.</p>
  </div>
  <div class="trl-end">
    <p class="trl-end-1">Guess. Measure the miss. Nudge. <span>Repeat.</span></p>
    <svg class="trl-end-pic" viewBox="0 0 600 270">
      <line class="trl-grid" x1="20" x2="580" y1={ey(0)} y2={ey(0)} />
      <line class="trl-line trl-end-line" />
      {beans.weeks.map((w, i) => <circle class="trl-dot" cx={ex(w)} cy={ey(beans.heights[i])} r="11" />)}
    </svg>
    <p class="trl-end-2">A real AI turns billions of dials the same way.</p>
    <p class="trl-end-3"><b>deanphillips.dev</b><br />Part 4 of AI, plainly. Try nudging the line yourself.</p>
  </div>
  <div class="trl-og">
    <p class="trl-og-1">Nobody drew <span>the line.</span></p>
    <p class="trl-og-2">A computer found it by nudging a wild guess, 40 times.</p>
    <p class="trl-og-3">How an AI learns, with nothing past arithmetic</p>
  </div>
</figure>

<script>
  type Beans = { weeks: number[]; heights: number[]; bad: { tilt: number; start: number }; step: number; rounds: number };
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const ease = (x: number) => 1 - (1 - clamp(x)) ** 3;
  const inOut = (x: number) => { const c = clamp(x); return c < 0.5 ? 4 * c ** 3 : 1 - (-2 * c + 2) ** 3 / 2; };

  const TOTAL = 31.6;
  const END = 27.4; // the end card starts
  const OUT = 0.22, IN = 0.32; // the old headline fades out fully, then the new one rises in
  const RETRACT = 3.0, MISS = 5.6, CARD = 8.6, BEAT2 = 11.4, CARD_OUT = 14.0, SCORE = 14.4;
  const TRAIN = 16.8, SLOW = 0.4, FAST = 0.15, SLOW_N = 10;
  // Dial ranges, mapped to a 270 degree sweep.
  const TILT_MAX = 2.5, START_MAX = 12;

  const root = document.querySelector<HTMLElement>('.trl');
  if (root) {
    const d: Beans = JSON.parse(root.dataset.beans!);
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element>(s: string) => [...root.querySelectorAll<T>(s)];
    const L = 128, R = 978, T = 26, B = 486, X0 = 0.4, X1 = 8.6, Y1 = 20;
    const sx = (w: number) => L + ((w - X0) / (X1 - X0)) * (R - L);
    const sy = (h: number) => B - (h / Y1) * (B - T);
    const sse = (t: number, b: number) => d.weeks.reduce((s, w, i) => s + (t * w + b - d.heights[i]) ** 2, 0);
    const first = sse(d.bad.tilt, d.bad.start);

    // One headline (and a short line under it) per beat, by start time.
    const SHOTS: [number, string, string][] = [
      [0, 'How does an AI learn?', 'By being wrong, then less wrong.'],
      [RETRACT, 'Nobody gives it the right line.', 'It starts with a wild guess.'],
      [MISS, 'Measure every miss.', 'The gap from each dot to the line.'],
      [CARD, 'Just add the misses up?', 'Misses above and below cancel out.'],
      [BEAT2, 'Multiply each miss by itself.', 'Then nothing cancels.'],
      [SCORE, `This guess scores ${first.toFixed(1)}.`, "Each miss times itself, added up."],
      [TRAIN, 'Nudge the line a little.', 'Each nudge turns two dials.'],
      [TRAIN + SLOW_N * SLOW, 'Again, and again.', 'Smaller nudges as it gets close.'],
      [0, 'Nobody drew this line.', 'It only had the dots and its misses.'],
    ];

    // Every round of real training, worked out once (the same centered update as FitLine).
    const states: { tilt: number; start: number }[] = [{ ...d.bad }];
    {
      let tilt = d.bad.tilt, c = d.bad.start + d.bad.tilt * 4.5;
      for (let r = 0; r < d.rounds; r++) {
        let gt = 0, gc = 0;
        d.weeks.forEach((w, i) => { const e = tilt * (w - 4.5) + c - d.heights[i]; gt += (2 * e * (w - 4.5)) / d.weeks.length; gc += (2 * e) / d.weeks.length; });
        tilt -= d.step * gt; c -= d.step * gc;
        states.push({ tilt, start: c - tilt * 4.5 });
      }
    }
    const TRAIN_END = TRAIN + SLOW_N * SLOW + (d.rounds - SLOW_N) * FAST;
    SHOTS[SHOTS.length - 1][0] = TRAIN_END;
    // Where training is at time t: a round number and how far the line has moved toward it.
    function roundAt(t: number): [number, number] {
      const a = t - TRAIN;
      if (a < 0) return [0, 1];
      if (a < SLOW_N * SLOW) { const k = Math.floor(a / SLOW); return [k + 1, inOut((a - k * SLOW) / (SLOW * 0.7))]; }
      const b = a - SLOW_N * SLOW;
      const k = Math.min(d.rounds - SLOW_N - 1, Math.floor(b / FAST));
      return [SLOW_N + k + 1, b >= (d.rounds - SLOW_N) * FAST ? 1 : inOut((b - k * FAST) / (FAST * 0.8))];
    }

    const main = $<HTMLElement>('.trl-main'), end = $<HTMLElement>('.trl-end');
    const layer = $<HTMLElement>('.trl-layer');
    const cur = $<SVGLineElement>('.trl-cur'), ghost = $<SVGLineElement>('.trl-ghost'), ghostLab = $<SVGTextElement>('.trl-ghostlab');
    const misses = $$<SVGLineElement>('.trl-chart .trl-miss');
    const total = $<HTMLElement>('.trl-total'), rn = $<HTMLElement>('.trl-rn');
    const score = $<HTMLElement>('.trl-score'), roundBox = $<HTMLElement>('.trl-round');
    const chart = $<SVGElement>('.trl-chart'), card = $<HTMLElement>('.trl-card'), foot = $<HTMLElement>('.trl-foot');
    const dialsBox = $<HTMLElement>('.trl-dials');
    const needles = $$<SVGLineElement>('.trl-needle'), dialVals = $$<HTMLElement>('.trl-dial b');
    const setLine = (el: SVGLineElement, tilt: number, start: number, x = sx, y = sy) => {
      el.setAttribute('x1', String(x(X0))); el.setAttribute('y1', String(y(start + tilt * X0)));
      el.setAttribute('x2', String(x(X1))); el.setAttribute('y2', String(y(start + tilt * X1)));
    };
    setLine(ghost, d.bad.tilt, d.bad.start);
    const fin = states[states.length - 1];
    setLine($<SVGLineElement>('.trl-end-line'), fin.tilt, fin.start, (w) => 20 + ((w - X0) / (X1 - X0)) * 560, (h) => 250 - (h / Y1) * 230);
    const turn = (i: number, v: number, max: number) => {
      const ang = ((-135 + 270 * clamp(v / max)) * Math.PI) / 180;
      needles[i].setAttribute('x2', String(60 + 38 * Math.sin(ang)));
      needles[i].setAttribute('y2', String(60 - 38 * Math.cos(ang)));
    };

    function draw(t: number) {
      t = Math.max(0, Math.min(TOTAL, t));
      const og = 'og' in root!.dataset;
      if (og) t = TRAIN_END + 0.5;

      // Headline: the old one fades fully out, then the new one rises in, so the two never overlap.
      let s = 0;
      while (s + 1 < SHOTS.length && t >= SHOTS[s + 1][0]) s++;
      const dt = t - SHOTS[s][0];
      const showPrev = s > 0 && dt < OUT;
      const shot = SHOTS[showPrev ? s - 1 : s];
      layer.children[0].textContent = shot[1];
      layer.children[1].textContent = shot[2];
      layer.classList.toggle('is-hook', (showPrev ? s - 1 : s) === 0);
      const v = s === 0 ? 1 : showPrev ? 1 - ease(dt / OUT) : ease((dt - OUT) / IN);
      layer.style.opacity = String(v);
      layer.style.transform = showPrev || s === 0 ? 'none' : `translateY(${(1 - v) * 3}cqw)`;

      // The line: the wild guess from the first frame, then training moves it round by round.
      const [k, f] = roundAt(t);
      const a = states[Math.max(0, k - 1)], b = states[k];
      const tilt = k ? a.tilt + (b.tilt - a.tilt) * f : d.bad.tilt;
      const start = k ? a.start + (b.start - a.start) * f : d.bad.start;
      setLine(cur, tilt, start);
      const g = t >= TRAIN ? ease((t - TRAIN) / 0.6) : 0;
      ghost.style.opacity = String(0.6 * g);
      ghostLab.style.opacity = String(g);

      // The misses: shown on the poster frame, pulled back, then grown again one by one.
      d.weeks.forEach((w, i) => {
        const grow = t < MISS ? 1 - ease((t - RETRACT - 0.2) / 0.4) : ease((t - MISS - 0.35 - i * 0.16) / 0.45);
        const yd = sy(d.heights[i]), yl = sy(start + tilt * w);
        const m = misses[i];
        m.setAttribute('x1', String(sx(w))); m.setAttribute('x2', String(sx(w)));
        m.setAttribute('y1', String(yd)); m.setAttribute('y2', String(yd + (yl - yd) * grow));
        m.style.opacity = grow > 0.01 ? '1' : '0';
      });

      // The scoreboard waits until the squaring is explained, then counts up to the guess's total miss.
      const shown = t >= TRAIN ? sse(tilt, start) : first * ease((t - SCORE - 0.3) / 1.0);
      total.textContent = shown.toFixed(1);
      score.style.opacity = String(ease((t - SCORE) / 0.3));
      roundBox.style.opacity = String(ease((t - TRAIN) / 0.4));
      rn.textContent = String(k);

      // The two dials appear with the first nudge and turn with the line.
      dialsBox.style.opacity = String(ease((t - TRAIN) / 0.4));
      turn(0, tilt, TILT_MAX); turn(1, start, START_MAX);
      dialVals[0].textContent = tilt.toFixed(2);
      dialVals[1].textContent = start.toFixed(1);

      // The why-multiply card covers the chart, in two beats.
      const cIn = ease((t - CARD) / 0.4) * (1 - ease((t - CARD_OUT) / 0.35));
      card.style.opacity = String(cIn);
      card.style.transform = `translateY(${(1 - ease((t - CARD) / 0.4)) * 6}%)`;
      chart.style.opacity = String(1 - 0.9 * cIn);
      foot.style.opacity = String(1 - cIn);
      const strike = ease((t - CARD - 1.0) / 0.4);
      $<HTMLElement>('.trl-strike').style.transform = `scaleX(${strike})`;
      $<HTMLElement>('.trl-wrong').classList.toggle('is-struck', strike > 0.5);
      $<HTMLElement>('.trl-stamp-bad').style.opacity = String(ease((t - CARD - 1.5) / 0.3));
      $<HTMLElement>('.trl-right').style.opacity = String(ease((t - BEAT2 - 0.4) / 0.35));
      $<HTMLElement>('.trl-stamp-good').style.opacity = String(ease((t - BEAT2 - 1.3) / 0.3));

      // The end card replaces the chart.
      const e = og ? 0 : ease((t - END) / 0.4);
      main.style.opacity = String(1 - e);
      end.style.opacity = og ? '0' : String(ease((t - END - 0.2) / 0.4));
      $<HTMLElement>('.trl-end-1').style.opacity = String(ease((t - END - 0.3) / 0.4));
      $<HTMLElement>('.trl-end-pic').style.opacity = String(ease((t - END - 0.6) / 0.4));
      $<HTMLElement>('.trl-end-2').style.opacity = String(ease((t - END - 1.2) / 0.4));
      $<HTMLElement>('.trl-end-3').style.opacity = String(ease((t - END - 2.0) / 0.4));
    }
    (window as any).__trainingReel = { draw, total: TOTAL };
  }
</script>

<style is:global>
  .trl { display: none; }
  body:has(.trl[data-reel], .trl[data-og]) header.top { display: none; }
  .trl[data-reel], .trl[data-og] {
    position: fixed; inset: 0; z-index: 2147483647; margin: 0 !important; max-width: none !important; width: 100vw; height: 100vh; box-sizing: border-box;
    padding: 4.4cqw 4.4cqw 3cqw; display: flex; flex-direction: column; overflow: hidden; container-type: inline-size;
    color: var(--text); font: 500 4cqw/1.3 Inter, sans-serif;
    background: radial-gradient(120% 70% at 0% 0%, color-mix(in srgb, var(--violet) 16%, transparent), transparent 60%),
      radial-gradient(100% 70% at 100% 100%, color-mix(in srgb, var(--teal) 14%, transparent), transparent 60%), var(--bg);
  }
  .trl p { margin: 0; }
  .trl-main { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; }
  .trl-head { display: grid; align-items: end; height: 33cqw; margin-bottom: 2cqw; }
  .trl-layer { grid-area: 1 / 1; display: grid; gap: 1.6cqw; }
  .trl-hl { font: 700 7.6cqw/1.08 "Space Grotesk", sans-serif; letter-spacing: -0.02em; color: var(--text); }
  .trl-layer.is-hook .trl-hl { font-size: 10.4cqw; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .trl-sub { font: 600 4.3cqw/1.3 Inter, sans-serif; color: var(--muted); min-height: 1.3em; }
  .trl-layer.is-hook .trl-sub { font-size: 5.6cqw; color: var(--text); }
  .trl-board { display: flex; gap: 2.4cqw; margin-bottom: 1.6cqw; }
  .trl-score, .trl-round { display: flex; align-items: baseline; gap: 2.4cqw; padding: 1.8cqw 3.2cqw; border-radius: 2.4cqw; background: var(--bg-2); border: 0.3cqw solid var(--line); }
  .trl-score span, .trl-round span { font: 800 4cqw/1 Inter, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .trl-score b, .trl-round b { font: 700 7.6cqw/1 "Space Grotesk", sans-serif; font-variant-numeric: tabular-nums; color: var(--text); }
  .trl-score b { min-width: 4.2ch; }
  .trl-round b { min-width: 2ch; }
  .trl-stage { position: relative; }
  .trl-chart { display: block; width: 100%; height: auto; }
  .trl-grid { stroke: var(--line); stroke-width: 2; }
  .trl-tick { font: 600 48px Inter, sans-serif; fill: var(--muted); }
  .trl-axis { font: 700 46px Inter, sans-serif; fill: var(--muted); }
  .trl-line { stroke: var(--teal); stroke-width: 10; stroke-linecap: round; }
  .trl-ghost { stroke-width: 5; stroke-dasharray: 16 14; }
  .trl-dot { fill: var(--text); stroke: var(--bg); stroke-width: 4; }
  .trl-chart .trl-dot { r: 15px; }
  .trl-miss { stroke: var(--warn); stroke-width: 7; stroke-linecap: round; }
  .trl-lab { font: 700 46px "Space Grotesk", sans-serif; fill: var(--muted); }
  .trl-card { position: absolute; inset: 0 0 auto; display: grid; gap: 2cqw; padding: 3.4cqw 4.8cqw; border-radius: 3.4cqw; background: var(--card); border: 0.3cqw solid var(--line); opacity: 0; }
  .trl-mini { display: block; width: 86%; justify-self: center; height: auto; }
  .trl-minilab { font: 700 48px "Space Grotesk", sans-serif; fill: var(--warn); }
  .trl-row { position: relative; display: grid; gap: 1cqw; }
  .trl-k { font: 800 3.4cqw/1.2 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .trl-sum { font: 700 6.6cqw/1.15 "Space Grotesk", sans-serif; font-variant-numeric: tabular-nums; }
  .trl-wrong .trl-sum { justify-self: start; }
  .trl-wrong.is-struck .trl-sum { color: var(--muted); }
  .trl-strike { position: absolute; left: -1cqw; right: auto; bottom: 3.6cqw; width: 85%; height: 0.9cqw; border-radius: 1cqw; background: var(--pink); transform-origin: 0 50%; transform: scaleX(0); }
  .trl-stamp { justify-self: start; font: 800 4.4cqw/1.2 "Space Grotesk", sans-serif; padding: 1cqw 2.6cqw; border-radius: 1.4cqw; border: 0.45cqw solid; transform: rotate(-2deg); opacity: 0; }
  .trl-stamp-bad { color: var(--pink); border-color: var(--pink); margin-bottom: 1.4cqw; }
  .trl-stamp-good { color: var(--ok); border-color: var(--ok); }
  .trl-right { opacity: 0; }
  .trl-dials { display: flex; justify-content: center; gap: 8cqw; margin-top: 0.6cqw; opacity: 0; }
  .trl-dial { display: flex; align-items: center; gap: 2.4cqw; }
  .trl-dial svg { width: 12cqw; height: 12cqw; }
  .trl-dial p { display: grid; gap: 0.8cqw; }
  .trl-dial span { font: 800 4cqw/1 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .trl-dial b { font: 700 7cqw/1 "Space Grotesk", sans-serif; font-variant-numeric: tabular-nums; min-width: 3.4ch; }
  .trl-knob { fill: var(--bg-2); stroke: var(--line); stroke-width: 6; }
  .trl-needle { stroke: var(--teal); stroke-width: 10; stroke-linecap: round; }
  .trl-hub { fill: var(--teal); }
