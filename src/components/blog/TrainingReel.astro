---
// The silent social video for the training math post (part 4 of "AI, plainly"). It is never shown to readers:
// the figure stays display:none unless a recording script sets data-reel (or data-og) on it, and it is
// aria-hidden. It tells the post's story in the same look and pacing as ToolsReel and AgentsReel, so the
// videos read as a set. The hook, "How does an AI learn?", over part 1's tiny model guessing "The sky is ___"
// (blue only 41%). What it should have been (100, 0, 0) drops in beside each guess. The nudge receipt prints
// one row per answer (should minus guessed, times the step size, the turn, with an arrow sized by it). Then
// the rounds stack up like the post's RoundStrip, blue climbing while its nudge arrow shrinks. An end card:
// "Should minus guessed. Billions of times." then the series and the site. One big headline per beat on top
// (8.2cqw, about 88px at 1080 wide), body type about 45px, post colors (teal up, pink down, amber surprise).
//
// Every number comes from the post's own made-up starting dials through src/lib/tiny-model.ts (nudge and
// rounds, the same calls the post's receipt and strip make), so the video can't drift from the post.
//
// Everything is drawn as a pure function of time, so scripts/video/ai-plainly-training-math-reel.mjs can
// record it frame by frame: it sets data-reel (or data-og for the link preview) and calls
// window.__trainingReel.draw(seconds). There is no loop and no timer, so reduced motion has nothing to stop,
// and without JavaScript nothing shows (the figure is hidden either way). Each element that appears carries
// its time in data-at.
import { nudge, rounds, type Model, type Sentence } from '../../lib/tiny-model';
interface Props { model: Model; sentence: Sentence }
const { model, sentence } = Astro.props;
const ri = model.answers.indexOf(sentence.answer);
const first = nudge(model, sentence);
const rs = rounds(model, sentence, 6);
const sg = (x: number, d = 0) => (x > 0 ? '+' : x < 0 ? '−' : '') + Math.abs(x).toFixed(d);
const maxTurn = Math.max(...first.turn.map(Math.abs));
// Timings (seconds). Kept here so the markup and the script agree.
const T = { should: 6.6, rows: [10.4, 12.0, 13.4], step: 15.2, roundsIn: 19.6, round0: 20.4, roundGap: 1.45, end: 31.2, total: 36 };
const rowAt = rs.map((_, i) => +(T.round0 + i * T.roundGap).toFixed(2));
---
<figure class="tnr" aria-hidden="true" data-t={JSON.stringify({ ...T, rowAt, right: first.pct[ri], answer: sentence.answer })}>
  <div class="tnr-main">
    <div class="tnr-head">
      <p class="tnr-hl" data-layer="a"><span></span></p>
      <p class="tnr-hl" data-layer="b"><span></span></p>
    </div>
    <div class="tnr-stage">
      <section class="tnr-card tnr-guess" data-in="0" data-out={T.rows[0] - 0.6} data-og="1">
        <p class="tnr-tag">part 1's tiny model</p>
        <p class="tnr-sent">{sentence.text} <b>___</b></p>
        <ol class="tnr-bars">
          {model.answers.map((a, i) => (
            <li class={a === sentence.answer ? 'tnr-ok' : ''}>
              <span class="tnr-w">{a}</span>
              <span class="tnr-bar"><i style={`width:${first.pct[i]}%`}></i><s class="tnr-pop" data-at={T.should} style={`left:${first.should[i]}%`}></s><em class="tnr-pop" data-at={T.should}>should be {first.should[i]}%</em></span>
              <span class="tnr-p"><b>{first.pct[i]}%</b></span>
            </li>
          ))}
        </ol>
        <p class="tnr-foot">Its guess. The right answer is <b>{sentence.answer}</b>.</p>
      </section>

      <section class="tnr-card tnr-rec" data-in={T.rows[0] - 0.6} data-out={T.roundsIn}>
        <p class="tnr-rhead">NUDGE RECEIPT</p>
        {model.answers.map((a, i) => (
          <div class={`tnr-row tnr-pop ${first.turn[i] >= 0 ? 'tnr-up' : 'tnr-down'}`} data-at={T.rows[i]}>
            <p class="tnr-a">{a}</p>
            <p class="tnr-math">{first.should[i]} − {first.pct[i]} = <b>{sg(first.diff[i])}</b></p>
            <p class="tnr-turn tnr-pop" data-at={T.step + i * 0.35}>
              <span>× {model.step}</span><b>{sg(first.turn[i], 3)}</b>
              <svg viewBox="0 0 24 60" preserveAspectRatio="none" style={`height:${4 + (Math.abs(first.turn[i]) / maxTurn) * 9}cqw`}>
                {first.turn[i] >= 0 ? <path d="M12 2 L22 18 H15 V58 H9 V18 H2 Z" /> : <path d="M12 58 L22 42 H15 V2 H9 V42 H2 Z" />}
              </svg>
            </p>
          </div>
        ))}
        <p class="tnr-key"><span>should</span><span>−</span><span>guessed</span></p>
      </section>

      <section class="tnr-card tnr-rounds" data-in={T.roundsIn} data-out={T.end}>
        <p class="tnr-tag">"{sentence.text} ___", again and again</p>
        <div class="tnr-rkey"><span>#</span><span>{sentence.answer}</span><span>turn up</span></div>
        <ol class="tnr-rlist">
          {rs.map((r, i) => (
            <li class="tnr-pop" data-at={rowAt[i]}>
              <span class="tnr-n">{i + 1}</span>
              <span class="tnr-rbar"><i style={`width:${r.pct[ri]}%`}></i><b>{r.pct[ri]}%</b></span>
              <span class="tnr-rturn"><i style={`width:${Math.max(8, (r.turn[ri] / rs[0].turn[ri]) * 100)}%`}></i><b>+{r.turn[ri].toFixed(3)}</b></span>
            </li>
          ))}
        </ol>
      </section>
    </div>
    <p class="tnr-sub">The starting dials are made up. The math is real.</p>
  </div>
  <div class="tnr-end">
    <p class="tnr-end-1">Should minus guessed.</p>
    <p class="tnr-end-2"><span>Billions of times.</span></p>
    <p class="tnr-end-3">Part 4 of AI, plainly<br /><b>deanphillips.dev</b></p>
  </div>
</figure>

<script>
  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const ease = (x: number) => 1 - (1 - clamp(x)) ** 3;
  const pop = (x: number) => { const c = clamp(x); return 1 + 2.2 * (c - 1) ** 3 + 1.2 * (c - 1) ** 2; };

  const root = document.querySelector<HTMLElement>('.tnr');
  if (root) {
    const T = JSON.parse(root.dataset.t!) as { right: number; answer: string; should: number; rows: number[]; step: number; roundsIn: number; end: number; total: number; rowAt: number[] };
    // One big headline per beat: start time and words.
    const SHOTS: [number, string][] = [
      [0, 'How does an AI learn?'],
      [3.2, `It guesses. ${T.answer[0].toUpperCase() + T.answer.slice(1)} gets only ${T.right}%.`],
      [T.should - 0.2, `${T.answer[0].toUpperCase() + T.answer.slice(1)} should have been 100%.`],
      [T.rows[0] - 0.6, 'Should minus guessed.'],
      [T.step - 0.2, 'Times a small step. Turn the dial.'],
      [T.roundsIn, 'Then guess again. And again.'],
      [T.rowAt[2] + 0.2, 'Close to right, the nudges shrink.'],
      [T.end, ''],
    ];
    const XF = 0.35, SLIDE = 0.5;
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
    const main = $('.tnr-main'), end = $('.tnr-end');
    const layers = $$('.tnr-hl'), cards = $$('.tnr-card');
    const num = (el: HTMLElement, k: string) => Number(el.dataset[k]);
    function headline(el: HTMLElement, s: number, v: number) {
      el.firstElementChild!.textContent = SHOTS[s][1];
      el.classList.toggle('is-hook', s === 0);
      el.style.opacity = String(v);
    }
    function draw(t: number) {
      t = Math.max(0, Math.min(T.total, t));
      const og = 'og' in root!.dataset;
      let s = 0;
      while (s + 1 < SHOTS.length && t >= SHOTS[s + 1][0]) s++;
      if (og) s = 0;
      const into = s && !og ? ease((t - SHOTS[s][0]) / XF) : 1;
      headline(layers[0], s, into);
      if (s && into < 1) headline(layers[1], s - 1, 1 - into); else layers[1].style.opacity = '0';
      for (const c of cards) {
        const a = num(c, 'in'), b = num(c, 'out');
        const e = a <= 0 ? 1 : ease((t - a) / SLIDE), l = ease((t - b) / SLIDE);
        const on = og ? c.classList.contains('tnr-rec') : t >= a && t < b + SLIDE;
        c.style.display = on ? '' : 'none';
        if (!on) continue;
        c.style.transform = og ? 'none' : `translateX(${(1 - e) * 108 - l * 108}%)`;
        c.style.opacity = og ? '1' : String(Math.min(0.3 + 0.7 * e, 1 - 0.7 * l));
        for (const el of $$('.tnr-pop', c)) {
          const at = og ? -1 : num(el, 'at');
          const k = (t - at) / 0.35;
          el.style.visibility = t >= at ? 'visible' : 'hidden';
          el.style.transform = `scale(${0.7 + 0.3 * pop(k)})`;
          el.style.opacity = String(ease(k * 1.6));
        }
      }
      const e = ease((t - T.end) / 0.5);
      main.style.opacity = String(og ? 1 : 1 - e);
      end.style.opacity = String(og ? 0 : ease((t - T.end - 0.3) / 0.5));
      $('.tnr-end-1').style.opacity = String(ease((t - T.end - 0.4) / 0.5));
      $('.tnr-end-2').style.opacity = String(ease((t - T.end - 1.4) / 0.5));
      $('.tnr-end-3').style.opacity = String(ease((t - T.end - 2.5) / 0.5));
    }
    (window as any).__trainingReel = { draw, total: T.total };
  }
</script>

<style is:global>
  .tnr { display: none; }
  body:has(.tnr[data-reel], .tnr[data-og]) header.top { display: none; }
  .tnr[data-reel], .tnr[data-og] {
    position: fixed; inset: 0; z-index: 2147483647; margin: 0 !important; max-width: none !important; width: 100vw; height: 100vh; box-sizing: border-box;
    padding: 4cqw 4.4cqw 3cqw; display: flex; flex-direction: column; overflow: hidden; container-type: inline-size;
    color: var(--text); font: 500 4cqw/1.3 Inter, sans-serif;
    background: radial-gradient(120% 70% at 0% 0%, color-mix(in srgb, var(--violet) 16%, transparent), transparent 60%),
      radial-gradient(100% 70% at 100% 100%, color-mix(in srgb, var(--teal) 14%, transparent), transparent 60%), var(--bg);
  }
  .tnr p { margin: 0; }
  .tnr-main { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center; }
  .tnr-head { display: grid; align-items: end; min-height: 18.2cqw; margin-bottom: 3cqw; }
  .tnr-hl { grid-area: 1 / 1; font: 700 8.2cqw/1.1 "Space Grotesk", sans-serif; letter-spacing: -0.02em; color: var(--text); }
  .tnr-hl.is-hook span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tnr-stage { position: relative; flex: none; height: 90.5cqw; overflow: hidden; border-radius: 3.4cqw; }
  .tnr-card { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 3cqw; padding: 4.4cqw 4.4cqw; border-radius: 3.4cqw; border: 0.3cqw solid var(--line); background: var(--bg-2); overflow: hidden; }
  .tnr-tag { font: 700 3.8cqw/1.3 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .tnr-sent { font: 700 9cqw/1.15 "Space Grotesk", sans-serif; }
  .tnr-sent b { color: var(--teal); }
  .tnr-bars { list-style: none; margin: 4cqw 0 2cqw !important; padding: 0 !important; display: grid; gap: 8cqw; }
  .tnr-bars li { margin: 0 !important; display: grid; grid-template-columns: 19cqw 1fr 15cqw; gap: 2.6cqw; align-items: center; }
  .tnr-w { font: 700 6.4cqw/1 "Space Grotesk", sans-serif; }
  .tnr-ok .tnr-w { color: var(--teal); }
  .tnr-bar { position: relative; height: 8cqw; border-radius: 99px; background: var(--card); }
  .tnr-bar i { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: color-mix(in srgb, var(--muted) 55%, transparent); }
  .tnr-ok .tnr-bar i { background: var(--teal); }
  .tnr-bar s { position: absolute; top: -1.6cqw; bottom: -1.6cqw; width: 1cqw; margin-left: -0.5cqw; border-radius: 1cqw; background: var(--warn); }
  .tnr-p { position: relative; text-align: right; }
  .tnr-p b { font: 700 6.6cqw/1 "Space Grotesk", sans-serif; font-variant-numeric: tabular-nums; }
  .tnr-bar em { position: absolute; left: 0; top: 100%; margin-top: 2.2cqw; white-space: nowrap; font: 700 4cqw/1.2 Inter, sans-serif; font-style: normal; color: var(--warn); transform-origin: 0 0; }
  .tnr-foot { margin-top: 4cqw !important; font-size: 4.6cqw; color: var(--muted); }
  .tnr-foot b { color: var(--teal); }
  .tnr-rec { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; gap: 0; }
  .tnr-rhead { font: 700 5.4cqw/1.2 ui-monospace, Menlo, monospace; letter-spacing: .12em; text-align: center; padding-bottom: 2.6cqw !important; border-bottom: 0.4cqw dashed var(--line); }
  .tnr-row { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "a turn" "m turn"; gap: 0.6cqw 3cqw; align-items: center; padding: 5cqw 0; border-bottom: 0.3cqw dotted var(--line); transform-origin: 0 50%; }
  .tnr-a { grid-area: a; font: 700 6.4cqw/1.1 "Space Grotesk", sans-serif; }
  .tnr-up .tnr-a { color: var(--teal); }
  .tnr-math { grid-area: m; font: 700 6.2cqw/1.1 ui-monospace, Menlo, monospace; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tnr-up .tnr-math b { color: var(--teal); } .tnr-down .tnr-math b { color: var(--pink); }
  .tnr-turn { grid-area: turn; display: grid; grid-template-columns: auto auto; align-items: center; column-gap: 2cqw; justify-items: end; }
  .tnr-turn span { grid-column: 1; font-size: 4.2cqw; color: var(--muted); }
  .tnr-turn b { grid-column: 1; font: 700 6.4cqw/1.1 ui-monospace, Menlo, monospace; }
  .tnr-turn svg { grid-column: 2; grid-row: 1 / 3; width: 4.4cqw; }
  .tnr-up .tnr-turn b { color: var(--teal); } .tnr-up path { fill: var(--teal); }
  .tnr-down .tnr-turn b { color: var(--pink); } .tnr-down path { fill: var(--pink); }
  .tnr-key { display: none; }
  .tnr-rkey, .tnr-rlist li { display: grid; grid-template-columns: 10cqw 1.3fr 1fr; gap: 3cqw; align-items: center; }
  .tnr-rkey span { font: 700 3.8cqw/1.3 Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .tnr-rlist { list-style: none; margin: 0 !important; padding: 0 !important; display: grid; gap: 3cqw; }
  .tnr-rounds { justify-content: flex-start; }
  .tnr-rlist li { margin: 0 !important; transform-origin: 0 50%; }
  .tnr-n { display: grid; place-items: center; width: 8.6cqw; height: 8.6cqw; border-radius: 50%; background: var(--card); border: 0.3cqw solid var(--line); font: 700 4.2cqw Inter, sans-serif; }
  .tnr-rbar { position: relative; height: 8.6cqw; border-radius: 1.6cqw; background: var(--card); overflow: hidden; }
  .tnr-rbar i { position: absolute; inset: 0 auto 0 0; background: color-mix(in srgb, var(--teal) 60%, var(--card)); }
  .tnr-rbar b { position: relative; display: block; padding: 0 2cqw; font: 700 5.4cqw/8.6cqw Inter, sans-serif; font-variant-numeric: tabular-nums; }
  .tnr-rturn { display: flex; align-items: center; gap: 2cqw; min-width: 0; }
  .tnr-rturn i { position: relative; height: 2cqw; background: var(--teal); border-radius: 1cqw 0 0 1cqw; max-width: calc(100% - 20cqw); }
  .tnr-rturn i::after { content: ""; position: absolute; right: -2.4cqw; top: -1.6cqw; border: 2.6cqw solid transparent; border-left: 2.6cqw solid var(--teal); border-right: 0; }
  .tnr-rturn b { flex: none; margin-left: 2.8cqw; font: 700 5.4cqw Inter, sans-serif; color: var(--teal); font-variant-numeric: tabular-nums; }
  .tnr-sub { margin-top: 2.4cqw !important; font-size: 3.2cqw; font-weight: 600; color: var(--muted); }
  .tnr-end { position: absolute; inset: 0; display: grid; align-content: center; gap: 5cqw; padding: 0 7cqw; opacity: 0; pointer-events: none; }
  .tnr-end-1, .tnr-end-2 { font: 700 9cqw/1.08 "Space Grotesk", sans-serif; letter-spacing: -0.02em; }
  .tnr-end-2 span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tnr-end-3 { margin-top: 4cqw !important; font: 600 4.4cqw/1.4 Inter, sans-serif; color: var(--muted); }
  .tnr-end-3 b { font: 700 6cqw/1.3 "Space Grotesk", sans-serif; color: var(--text); }
  /* The link preview (1200x630): the hook on the left, the receipt on the right. */
  .tnr[data-og] { padding: 3.6cqw 4.4cqw 2.4cqw; }
  .tnr[data-og] .tnr-main { display: grid; grid-template-columns: 1fr 1.1fr; grid-template-rows: 1fr auto; column-gap: 4cqw; }
  .tnr[data-og] .tnr-head { min-height: 0; margin: 0; align-items: center; }
  .tnr[data-og] .tnr-hl { font-size: 6.4cqw; }
  .tnr[data-og] .tnr-stage { height: auto; border-radius: 2cqw; }
  .tnr[data-og] .tnr-card { padding: 1.6cqw 2.4cqw; border-radius: 2cqw; border-width: 0.2cqw; }
  .tnr[data-og] .tnr-rhead { font-size: 2.2cqw; padding-bottom: 1cqw !important; border-bottom-width: 0.2cqw; }
  .tnr[data-og] .tnr-row { padding: 1.2cqw 0; gap: 0.3cqw 1.6cqw; border-bottom-width: 0.15cqw; }
  .tnr[data-og] .tnr-a { font-size: 2.6cqw; }
  .tnr[data-og] .tnr-math { font-size: 3.1cqw; }
  .tnr[data-og] .tnr-turn span { font-size: 1.7cqw; } .tnr[data-og] .tnr-turn b { font-size: 2.9cqw; }
  .tnr[data-og] .tnr-turn svg { width: 2.2cqw; transform: scaleY(.5); }
  .tnr[data-og] .tnr-sub { grid-column: 1 / -1; font-size: 1.6cqw; margin-top: 1.4cqw !important; }
  .tnr[data-og] .tnr-end { display: none; }
</style>
