  "quiz": [
    {
      "prompt": "When you ask a question, the AI looks the answer up in the text it studied.",
      "answer": "Myth",
      "why": "The text is gone after training. It only has the dials that studying set."
    },
    {
      "prompt": "The AI writes its answer one small piece at a time.",
      "answer": "Fact",
      "why": "One token per trip around the loop, and every trip reads the whole answer so far."
    },
    {
      "prompt": "The AI always picks the most likely next word.",
      "answer": "Myth",
      "why": "It usually does, but a little randomness is on purpose. That's why the same question can get two different answers."
    },
    {
      "prompt": "The word \"bank\" can mean something different to the AI depending on the sentence.",
      "answer": "Fact",
      "why": "That's attention. The words around it shift where it sits on the map."
    },
    {
      "prompt": "If an answer sounds confident, the AI checked that it's true.",
      "answer": "Myth",
      "why": "Nothing in the loop checks facts. A wrong answer that looks right comes out just as smoothly."
    }
