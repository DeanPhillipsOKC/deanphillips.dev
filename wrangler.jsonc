// Cloudflare Worker that serves the Astro build in dist/ at deanphillips.dev.
// `wrangler deploy` runs the build first, so a push only needs the usual deploy step.
{
  "name": "deanphillips-dev",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
